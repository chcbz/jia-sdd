chk_probe_sha	regexp_like(`sha256`,_utf8mb4\\'^[0-9a-f]{64}$\\')
chk_probe_bytes	((`byte_length` >= 1) and (`revision` >= 1))
chk_probe_mime	(`mime_type` = _utf8mb4\\'text/plain\\')
chk_probe_state	(`state` in (_utf8mb4\\'PENDING\\',_utf8mb4\\'DELETE_PENDING\\',_utf8mb4\\'REFERENCED\\',_utf8mb4\\'DELETED\\'))
