+        <section aria-label="帮助文章">
+          <div class="section-label"><h2>{{ query.trim() ? '搜索结果' : category || '常见问题' }}</h2><span role="status">{{ filtering ? `${results.length} 篇` : '从这里找到答案' }}</span></div>
+          <div v-if="!results.length" class="help-empty">
