server.address=127.0.0.1
server.port=10018
server.ssl.enabled=false
spring.autoconfigure.exclude=org.springframework.boot.amqp.autoconfigure.RabbitAutoConfiguration,org.springframework.boot.amqp.autoconfigure.health.RabbitHealthContributorAutoConfiguration,org.springframework.boot.amqp.autoconfigure.metrics.RabbitMetricsAutoConfiguration

spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.db-url=${CYF_DB_URL}
spring.datasource.url=${CYF_DB_URL}
spring.datasource.username=${CYF_DB_USERNAME}
spring.datasource.password=${CYF_DB_PASSWORD}
spring.datasource.initial-size=1
spring.datasource.min-idle=1
spring.datasource.max-active=4
spring.datasource.hikari.maximum-pool-size=4
spring.datasource.hikari.minimum-idle=1
spring.datasource.max-wait=10000
spring.datasource.validation-query=SELECT 1
spring.datasource.test-while-idle=true

spring.data.redis.host=127.0.0.1
spring.data.redis.port=16379
spring.data.redis.database=0
spring.data.redis.password=${CYF_REDIS_PASSWORD}

spring.ai.model.chat=openai
spring.ai.openai.api-key=local-od06-unused
spring.ai.openai.base-url=http://127.0.0.1:19999
spring.ai.model.embedding=openai
spring.ai.vectorstore.type=none
spring.ai.mcp.client.initialized=false
spring.ai.mcp.client.toolcallback.enabled=false

agent.output-delivery.enabled=true
agent.output-delivery.storage-endpoint=http://127.0.0.1:19000
agent.output-delivery.storage-access-key=${CYF_MINIO_ACCESS_KEY}
agent.output-delivery.storage-secret-key=${CYF_MINIO_SECRET_KEY}
agent.output-delivery.storage-bucket=cyf-od06-live-r1
agent.output-delivery.scanner-host=127.0.0.1
agent.output-delivery.scanner-port=13310
agent.output-delivery.retry-multiplier=10
agent.output-delivery.writes-paused=false
agent.output-delivery.cursor-signing-key=${CYF_OUTPUT_CURSOR_SIGNING_KEY}

agent.command-outbox.enabled=false
agent.rabbit-topology.enabled=false
agent.rabbit-publish.enabled=false
agent.rabbit-consume.enabled=false
agent.rabbit-dispatch.enabled=false
agent.rabbit-operations.read-enabled=false
agent.rabbit-operations.redrive-enabled=false
agent.rabbit-operations.reissue-enabled=false
juyiting.scene-state.enabled=false
juyiting.scene-events.enabled=false
archive.reader.enabled=false
archive.question.enabled=false
economy.preview.enabled=false

jia.chat.service.websocket.enable=true

# Isolated launch draft; load with spring.config.location, not the dev profile.
spring.main.banner-mode=off
logging.level.root=INFO
logging.level.cn.jia=INFO
spring.ldap.urls=ldap://127.0.0.1:1389
spring.ldap.base=dc=od06,dc=invalid
spring.elasticsearch.uris=http://127.0.0.1:19200
spring.rabbitmq.host=127.0.0.1
spring.rabbitmq.port=15672
spring.ai.mcp.client.enabled=false
oauth.resource.uris[0]=/agent/**
oauth.resource.uris[1]=/chat/**
oauth.resource.uris[2]=/user/**
user.permit.ignore-uris[0]=/ws/**
