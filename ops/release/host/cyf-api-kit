#!/bin/bash -p
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
cd /

ACTION="${1-restart}"
DEPLOY_DIR=/opt/cyf/service/api
RUNTIME_DIR=/run/cyf-api
JAR="$DEPLOY_DIR/cyf-api-kit.jar"
JAVA=/opt/cyf/runtime/temurin-21-jre/bin/java
RUNTIME_USER=cyf-api
RUNTIME_UID=''
RUNTIME_GID=''
SECRET_FILE="$DEPLOY_DIR/.jasypt-password"
VOICE_ENV_FILE="$DEPLOY_DIR/.voice-runtime.env"
LOG_DIR=/var/log/cyf-api
PID_FILE="$RUNTIME_DIR/cyf-api-kit.pid"
ARCHIVE_PID_FILE="$RUNTIME_DIR/archive-reader-enable.pid"
RUNTIME_RECORD="$RUNTIME_DIR/cyf-api-kit.runtime"
RELEASE_LOCK_FILE=/tmp/cyf-release-api.lock
LOCK_FILE=/tmp/cyf-api-lifecycle.lock
PORT=10018
HEALTH_URL=http://127.0.0.1:10018/actuator/health
STOP_TIMEOUT_SECONDS="${CYF_API_STOP_TIMEOUT:-60}"
HEALTH_TIMEOUT_SECONDS="${CYF_API_HEALTH_TIMEOUT:-1200}"
MIN_MEMORY_AVAILABLE_BYTES="${CYF_API_MIN_MEMORY_AVAILABLE_BYTES:-1073741824}"
MIN_DISK_AVAILABLE_BYTES="${CYF_API_MIN_DISK_AVAILABLE_BYTES:-5368709120}"
TRUSTED_JRE_TREE_SHA256=d79c6038ab30702c795a641ff5a1a38d94a6d451b9d40d0dabfea550fa806aef

usage() {
  cat <<USAGE
Usage: $0 [start|restart|stop|status]

  start    Start the deployed JAR only when it is not already running.
  restart  Restart the deployed JAR (default). No git pull or Gradle build.
  stop     Stop only the process whose argv contains the exact deployed JAR path.
  status   Show PID, listener and actuator health without changing processes.

Source builds and production deployment use the SHA-pinned workflow under:
  /home/isp/wsps/cyf/ops/release/
USAGE
}

die() {
  echo "错误：$*" >&2
  exit 1
}

if (( $# > 1 )); then
  usage >&2
  die "参数过多"
fi
case "$ACTION" in
  -h|--help) usage; exit 0 ;;
  start|restart|stop|status) ;;
  *) usage >&2; exit 2 ;;
esac
(( EUID == 0 )) || die "必须使用 root 运行，例如 sudo $0 $ACTION"

for command in awk base64 basename cat chmod chown curl date df flock grep id kill mktemp mv nohup ps python3 rm sed seq setpriv setsid sha256sum sleep ss stat tail; do
  command -v "$command" >/dev/null 2>&1 || die "缺少命令：$command"
done
RUNTIME_UID="$(id -u "$RUNTIME_USER" 2>/dev/null)" || die "运行账号不存在：$RUNTIME_USER"
RUNTIME_GID="$(id -g "$RUNTIME_USER" 2>/dev/null)" || die "无法解析运行账号主组：$RUNTIME_USER"
[[ "$RUNTIME_UID" =~ ^[0-9]+$ && "$RUNTIME_GID" =~ ^[0-9]+$ ]] || die "运行账号 UID/GID 无效"

[[ -d "$DEPLOY_DIR" && ! -L "$DEPLOY_DIR" ]] || die "部署目录不存在或不是物理目录：$DEPLOY_DIR"
[[ "$STOP_TIMEOUT_SECONDS" =~ ^[0-9]+$ && "$STOP_TIMEOUT_SECONDS" -ge 1 ]] || die "CYF_API_STOP_TIMEOUT 必须为正整数"
[[ "$HEALTH_TIMEOUT_SECONDS" =~ ^[0-9]+$ && "$HEALTH_TIMEOUT_SECONDS" -ge 1 ]] || die "CYF_API_HEALTH_TIMEOUT 必须为正整数"
[[ "$MIN_MEMORY_AVAILABLE_BYTES" =~ ^[0-9]+$ ]] || die "CYF_API_MIN_MEMORY_AVAILABLE_BYTES 必须为非负整数"
[[ "$MIN_DISK_AVAILABLE_BYTES" =~ ^[0-9]+$ ]] || die "CYF_API_MIN_DISK_AVAILABLE_BYTES 必须为非负整数"

validate_trusted_runtime() {
  /usr/bin/python3 -I - "$(dirname "$(dirname "$JAVA")")" "$JAVA" "$TRUSTED_JRE_TREE_SHA256" <<'PY'
from pathlib import Path
import hashlib, os, stat, sys
root = Path(sys.argv[1])
java = Path(sys.argv[2])
expected = sys.argv[3]
if not root.is_absolute() or java != root / 'bin' / 'java':
    raise SystemExit(1)
for parent in [Path('/opt'), Path('/opt/cyf'), Path('/opt/cyf/runtime')]:
    info = os.lstat(str(parent))
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit(1)
digest = hashlib.sha256()
for path in sorted([root, *root.rglob('*')], key=lambda item: '' if item == root else item.relative_to(root).as_posix()):
    rel = '.' if path == root else path.relative_to(root).as_posix()
    info = os.lstat(str(path))
    mode = stat.S_IMODE(info.st_mode)
    if info.st_uid != 0 or (not stat.S_ISLNK(info.st_mode) and mode & 0o022):
        raise SystemExit(1)
    if stat.S_ISREG(info.st_mode):
        kind = 'f'
        file_digest = hashlib.sha256()
        with open(path, 'rb') as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                file_digest.update(chunk)
        content = file_digest.hexdigest()
    elif stat.S_ISDIR(info.st_mode):
        kind, content = 'd', '-'
    elif stat.S_ISLNK(info.st_mode):
        kind, content = 'l', os.readlink(str(path))
        target = (path.parent / content).resolve(strict=True)
        try:
            target.relative_to(root)
        except ValueError:
            raise SystemExit(1)
    else:
        raise SystemExit(1)
    digest.update(f'{rel}\0{kind}\0{mode:04o}\0{info.st_uid}\0{info.st_gid}\0{content}\0'.encode())
if digest.hexdigest() != expected or not java.is_file() or java.is_symlink() or not os.access(str(java), os.X_OK):
    raise SystemExit(1)
PY
}

load_start_requirements() {
  [[ -d "$DEPLOY_DIR" && ! -L "$DEPLOY_DIR" ]] || die "安全部署目录不存在：$DEPLOY_DIR"
  [[ "$(stat -Lc '%a %U %G' "$DEPLOY_DIR")" == "755 root root" ]] || die "安全部署目录必须为 755 root root"
  [[ -d "$RUNTIME_DIR" && ! -L "$RUNTIME_DIR" ]] || die "安全运行目录不存在：$RUNTIME_DIR"
  [[ "$(stat -Lc '%a %U %G' "$RUNTIME_DIR")" == "750 root root" ]] || die "安全运行目录必须为 750 root root"
  [[ -d "$LOG_DIR" && ! -L "$LOG_DIR" ]] || die "日志目录不存在或不是物理目录：$LOG_DIR"
  [[ "$(stat -Lc '%a %U %G' "$LOG_DIR")" == "750 root root" ]] \
    || die "生命周期日志目录必须为 750 root root：$LOG_DIR"
  [[ -f "$JAR" && ! -L "$JAR" && -s "$JAR" ]] || die "部署 JAR 不存在、为空或为符号链接：$JAR"
  [[ "$(stat -Lc '%a %U %G' "$JAR")" == "640 root isp" ]] \
    || die "部署 JAR 必须为 640 root isp"
  [[ -x "$JAVA" && ! -L "$JAVA" ]] || die "Java 不可执行或为符号链接：$JAVA"
  validate_trusted_runtime || die "Java runtime 路径必须全链路 root-owned 且不可由组/其他用户写入：$JAVA"
  [[ -f "$SECRET_FILE" && ! -L "$SECRET_FILE" ]] || die "Jasypt 密钥文件缺失或不安全"
  [[ "$(stat -Lc '%a %U %G' "$SECRET_FILE")" == "600 root root" ]] \
    || die "Jasypt 密钥文件必须为 600 root root"
  JASYPT_ENCRYPTOR_PASSWORD=''
  if ! IFS= read -r JASYPT_ENCRYPTOR_PASSWORD < "$SECRET_FILE"; then
    [[ -n "$JASYPT_ENCRYPTOR_PASSWORD" ]] || die "无法读取 Jasypt 密钥文件"
  fi
  [[ -n "$JASYPT_ENCRYPTOR_PASSWORD" ]] || die "Jasypt 密钥文件为空"
  export JASYPT_ENCRYPTOR_PASSWORD
  load_voice_environment
}

load_voice_environment() {
  local encoded assignment
  VOICE_ENV_ASSIGNMENTS=()
  [[ -e "$VOICE_ENV_FILE" ]] || return 0
  [[ -f "$VOICE_ENV_FILE" && ! -L "$VOICE_ENV_FILE" ]] || die "语音运行配置必须是物理常规文件"
  [[ "$(stat -Lc '%a %U %G %h' "$VOICE_ENV_FILE")" == "600 root root 1" ]] \
    || die "语音运行配置必须为 600 root:root 且链接数为 1"
  if ! VOICE_ENV_ENCODED="$(/usr/bin/python3 -I - "$VOICE_ENV_FILE" <<'PY'
from pathlib import Path
from urllib.parse import urlsplit
import base64, hmac, re, sys

path = Path(sys.argv[1])
java_names = {
    'JIA_CHAT_VOICE_ENABLED', 'JIA_CHAT_VOICE_IDENTITY_HMAC_SECRET',
    'JIA_CHAT_VOICE_CACHE_ENCRYPTION_KEY',
    'JIA_CHAT_VOICE_COMPATIBILITY_GATEWAY_ALLOWLIST',
    'JIA_CHAT_VOICE_TRANSCRIPTION_ENABLED', 'JIA_CHAT_VOICE_TRANSCRIPTION_PROVIDER',
    'JIA_CHAT_VOICE_TRANSCRIPTION_MODEL', 'JIA_CHAT_VOICE_SYNTHESIS_ENABLED',
    'JIA_CHAT_VOICE_SYNTHESIS_PROVIDER', 'JIA_CHAT_VOICE_SYNTHESIS_MODEL',
    'JIA_CHAT_VOICE_SYNTHESIS_PROVIDER_VOICE', 'SPRING_AI_OPENAI_API_KEY',
    'SPRING_AI_OPENAI_BASE_URL', 'SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_API_KEY',
    'SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_BASE_URL',
    'SPRING_AI_OPENAI_AUDIO_SPEECH_API_KEY', 'SPRING_AI_OPENAI_AUDIO_SPEECH_BASE_URL',
}
allowed = java_names | {'CYF_VOICE_SMOKE_BEARER_TOKEN'}
values = {}
for number, raw in enumerate(path.read_bytes().splitlines(), 1):
    if not raw or raw.startswith(b'#'):
        continue
    if b'\x00' in raw or any(byte < 32 or byte == 127 for byte in raw):
        raise SystemExit('invalid control byte on line {}'.format(number))
    try:
        line = raw.decode('utf-8')
    except UnicodeDecodeError:
        raise SystemExit('configuration must be UTF-8')
    name, separator, value = line.partition('=')
    if not separator or not re.fullmatch(r'[A-Z][A-Z0-9_]*', name):
        raise SystemExit('invalid assignment on line {}'.format(number))
    if name not in allowed or name in values:
        raise SystemExit('unknown or duplicate configuration name on line {}'.format(number))
    values[name] = value
required_exact = {
    'JIA_CHAT_VOICE_ENABLED': 'true',
    'JIA_CHAT_VOICE_TRANSCRIPTION_ENABLED': 'true',
    'JIA_CHAT_VOICE_TRANSCRIPTION_PROVIDER': 'openai-compatible',
    'JIA_CHAT_VOICE_TRANSCRIPTION_MODEL': 'whisper-1',
    'JIA_CHAT_VOICE_SYNTHESIS_ENABLED': 'true',
    'JIA_CHAT_VOICE_SYNTHESIS_PROVIDER': 'openai-compatible',
    'JIA_CHAT_VOICE_SYNTHESIS_MODEL': 'gpt-4o-mini-tts',
    'JIA_CHAT_VOICE_SYNTHESIS_PROVIDER_VOICE': 'alloy',
}
for name, expected in required_exact.items():
    if values.get(name) != expected:
        raise SystemExit('required activation setting is missing or invalid: {}'.format(name))
identity = values.get('JIA_CHAT_VOICE_IDENTITY_HMAC_SECRET', '').encode('utf-8')
if len(identity) < 32:
    raise SystemExit('identity key is invalid')
try:
    cache = base64.b64decode(values.get('JIA_CHAT_VOICE_CACHE_ENCRYPTION_KEY', ''), validate=True)
except (ValueError, TypeError):
    cache = b''
if len(cache) != 32:
    raise SystemExit('cache key is invalid')
common_key = values.get('SPRING_AI_OPENAI_API_KEY', '')
transcription_key = values.get('SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_API_KEY', common_key)
speech_key = values.get('SPRING_AI_OPENAI_AUDIO_SPEECH_API_KEY', common_key)
if not transcription_key or not speech_key:
    raise SystemExit('provider API keys are missing')
for secret in (transcription_key.encode('utf-8'), speech_key.encode('utf-8'), cache,
               values.get('JIA_CHAT_VOICE_CACHE_ENCRYPTION_KEY', '').encode('utf-8')):
    if hmac.compare_digest(identity, secret):
        raise SystemExit('identity, cache and provider credentials must be independent')
base_urls = []
common_url = values.get('SPRING_AI_OPENAI_BASE_URL', '')
for name in ('SPRING_AI_OPENAI_AUDIO_TRANSCRIPTION_BASE_URL',
             'SPRING_AI_OPENAI_AUDIO_SPEECH_BASE_URL'):
    url = values.get(name, common_url)
    parsed = urlsplit(url)
    segments = parsed.path[1:].split('/') if parsed.path.startswith('/') else []
    if (parsed.scheme.lower() != 'https' or not parsed.hostname or parsed.username or parsed.password
            or parsed.query or parsed.fragment or parsed.path == '/' or not segments
            or any(part in ('', '.', '..') for part in segments) or url.endswith('/')
            or any(ch in url for ch in ('%', '\\', ';')) or parsed.geturl() != url):
        raise SystemExit('provider gateway is missing or unsafe')
    base_urls.append(url)
allowlist = set(filter(None, values.get('JIA_CHAT_VOICE_COMPATIBILITY_GATEWAY_ALLOWLIST',
                                        'https://api.openai.com/v1').split(',')))
if not set(base_urls).issubset(allowlist):
    raise SystemExit('provider gateway is not allowlisted')
if not values.get('CYF_VOICE_SMOKE_BEARER_TOKEN'):
    raise SystemExit('authenticated smoke credential is missing')
for name in sorted(java_names):
    if name in values:
        payload=(name + '=' + values[name]).encode('utf-8')
        print(base64.b64encode(payload).decode('ascii'))
PY
  )"; then
    die "语音运行配置校验失败"
  fi
  while IFS= read -r encoded; do
    [[ -n "$encoded" ]] || continue
    assignment="$(printf '%s' "$encoded" | base64 -d)" || die "语音运行配置解码失败"
    VOICE_ENV_ASSIGNMENTS+=("$assignment")
  done <<< "$VOICE_ENV_ENCODED"
  unset VOICE_ENV_ENCODED assignment encoded
}

validate_lock_file() {
  local path="$1" expected="$2" actual
  [[ -f "$path" && ! -L "$path" ]] || die "锁文件缺失或不安全：$path；必须由 root 按固定元数据预创建"
  actual="$(stat -Lc '%a:%u:%g:%h' "$path" 2>/dev/null || true)"
  [[ "$actual" == "$expected" ]] || die "锁文件权限/所有者/链接数不安全：$path ($actual != $expected)"
}

verify_lock_fd() {
  local fd="$1" path="$2" path_identity fd_identity
  path_identity="$(stat -Lc '%d:%i' "$path")"
  fd_identity="$(stat -Lc '%d:%i' "/proc/$$/fd/$fd")"
  [[ "$path_identity" == "$fd_identity" ]] || die "锁文件在打开期间发生变化：$path"
}

validate_lock_file "$RELEASE_LOCK_FILE" "660:0:$(id -g isp):1"
validate_lock_file "$LOCK_FILE" "600:0:0:1"
if [[ -n "${CYF_RELEASE_LOCK_INHERITED_FD:-}${CYF_RELEASE_LOCK_DEVICE:-}${CYF_RELEASE_LOCK_INODE:-}${CYF_RELEASE_LOCK_HELD:-}" ]]; then
  [[ "${CYF_RELEASE_LOCK_INHERITED_FD:-}" == 8 \
      && "${CYF_RELEASE_LOCK_DEVICE:-}" =~ ^[0-9]+$ \
      && "${CYF_RELEASE_LOCK_INODE:-}" =~ ^[0-9]+$ \
      && "${CYF_RELEASE_LOCK_HELD:-}" == 1 ]] \
    || die "继承发布锁标记不完整或无效"
  [[ -e /proc/$$/fd/8 ]] || die "继承发布锁 FD8 不存在"
  verify_lock_fd 8 "$RELEASE_LOCK_FILE"
  [[ "$(stat -Lc '%d:%i' /proc/$$/fd/8)" == "$CYF_RELEASE_LOCK_DEVICE:$CYF_RELEASE_LOCK_INODE" ]] \
    || die "继承发布锁设备/ inode 证明不匹配"
  /usr/bin/python3 -I - "$RELEASE_LOCK_FILE" <<'PY' || die "继承 FD8 没有可证明的排他 flock"
import os, sys
path = os.stat(sys.argv[1])
descriptor = os.fstat(8)
if (path.st_dev, path.st_ino) != (descriptor.st_dev, descriptor.st_ino):
    raise SystemExit(1)
expected = (os.major(descriptor.st_dev), os.minor(descriptor.st_dev), descriptor.st_ino)
found = False
with open('/proc/self/fdinfo/8', 'r', encoding='ascii') as stream:
    for line in stream:
        fields = line.split()
        if len(fields) >= 9 and fields[0] == 'lock:' \
                and fields[2:5] == ['FLOCK', 'ADVISORY', 'WRITE']:
            try:
                major, minor, inode = fields[6].split(':')
                actual = (int(major, 16), int(minor, 16), int(inode))
            except (ValueError, TypeError):
                continue
            if actual == expected:
                found = True
                break
raise SystemExit(0 if found else 1)
PY
else
  unset CYF_RELEASE_LOCK_INHERITED_FD CYF_RELEASE_LOCK_DEVICE CYF_RELEASE_LOCK_INODE CYF_RELEASE_LOCK_HELD
  exec 8<>"$RELEASE_LOCK_FILE"
  verify_lock_fd 8 "$RELEASE_LOCK_FILE"
  flock -n 8 || die "API 发布/回滚正在进行，拒绝并发生命周期操作"
fi
exec 9<>"$LOCK_FILE"
verify_lock_fd 9 "$LOCK_FILE"
flock -n 9 || die "另一个 API 启停操作正在进行"

proc_start_ticks() {
  /usr/bin/python3 -I - "$1" <<'PY'
from pathlib import Path
import sys
text = (Path('/proc') / sys.argv[1] / 'stat').read_text()
end = text.rfind(')')
if end < 0:
    raise SystemExit(1)
print(text[end + 2:].split()[19])
PY
}

process_generation_alive() {
  local pid="$1" ticks="$2"
  /usr/bin/python3 -I - "$pid" "$ticks" <<'PY'
from pathlib import Path
import sys
try:
    text = (Path('/proc') / sys.argv[1] / 'stat').read_text()
    end = text.rfind(')')
    fields = text[end + 2:].split()
    if end < 0 or fields[19] != sys.argv[2] or fields[0] == 'Z':
        raise SystemExit(1)
except (FileNotFoundError, PermissionError, ProcessLookupError, OSError, IndexError):
    raise SystemExit(1)
PY
}

