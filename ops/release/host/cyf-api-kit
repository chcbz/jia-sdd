exact_api_process() {
  local pid="$1" ticks="$2" signal_name="${3:-}"
  /usr/bin/python3 -I - "$pid" "$ticks" "$JAR" "$JAVA" "$RUNTIME_UID" "$RUNTIME_GID" "$signal_name" <<'PY'
from pathlib import Path
import os, signal, sys
pid_text, expected_ticks, jar_text, java_text, uid_text, gid_text, signal_name = sys.argv[1:]
try:
    pid = int(pid_text)
    expected_uid = int(uid_text)
    expected_gid = int(gid_text)
    proc = Path('/proc') / pid_text
    stat_text = (proc / 'stat').read_text()
    end = stat_text.rfind(')')
    if end < 0 or stat_text[end + 2:].split()[19] != expected_ticks:
        raise ValueError('start ticks mismatch')
    if (proc / 'exe').resolve(strict=True) != Path(java_text).resolve(strict=True):
        raise ValueError('executable mismatch')
    args = (proc / 'cmdline').read_bytes().split(b'\0')
    if args and args[-1] == b'':
        args.pop()
    jar = jar_text.encode()
    jar_indexes = [index for index, arg in enumerate(args) if arg == b'-jar']
    if len(jar_indexes) != 1:
        raise ValueError('jar option mismatch')
    index = jar_indexes[0]
    if index < 1 or index + 1 >= len(args) or args[index + 1] != jar:
        raise ValueError('jar path mismatch')
    if not all(arg.startswith(b'-') for arg in args[1:index]):
        raise ValueError('unexpected pre-jar argv')
    status = {}
    for line in (proc / 'status').read_text().splitlines():
        if line.startswith(('Uid:', 'Gid:')):
            key, values = line.split(':', 1)
            status[key] = [int(value) for value in values.split()]
    if status.get('Uid') != [expected_uid] * 4 or status.get('Gid') != [expected_gid] * 4:
        raise ValueError('runtime identity mismatch')
    if signal_name:
        os.kill(pid, getattr(signal, 'SIG' + signal_name))
except (FileNotFoundError, PermissionError, ProcessLookupError, OSError, ValueError, IndexError, AttributeError):
    raise SystemExit(1)
PY
}

find_api_pids() {
  /usr/bin/python3 -I - "$JAR" "$JAVA" <<'PY'
from pathlib import Path
import os, sys
jar = sys.argv[1].encode()
java = Path(sys.argv[2]).resolve()
found = []
for proc in Path('/proc').iterdir():
    if not proc.name.isdigit() or int(proc.name) == os.getpid():
        continue
    try:
        args = (proc / 'cmdline').read_bytes().split(b'\0')
        executable = (proc / 'exe').resolve(strict=True)
    except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
        continue
    if executable != java:
        continue
    jar_indexes = [index for index, arg in enumerate(args) if arg == b'-jar']
    if len(jar_indexes) != 1:
        continue
    index = jar_indexes[0]
    if index < 1 or index + 1 >= len(args) or args[index + 1] != jar:
        continue
    if not all(arg.startswith(b'-') for arg in args[1:index]):
        continue
    found.append(int(proc.name))
for pid in sorted(found):
    print(pid)
PY
}

current_pid() {
  local output
  local -a pids=()
  output="$(find_api_pids)" || die "无法扫描 API 进程"
  if [[ -n "$output" ]]; then
    mapfile -t pids <<< "$output"
  fi
  if (( ${#pids[@]} > 1 )); then
    local joined
    printf -v joined '%s,' "${pids[@]}"
    die "发现多个使用同一 JAR 的 Java 进程：${joined%,}，拒绝自动操作"
  fi
  if (( ${#pids[@]} == 1 )); then
    process_owned_by_runtime_user "${pids[0]}" \
      || die "发现使用部署 JAR 但运行身份不是 $RUNTIME_USER 的进程：${pids[0]}"
    printf '%s\n' "${pids[0]}"
  fi
}

port_listener_line() {
  ss -lntpH "sport = :$PORT" 2>/dev/null || true
}

listener_snapshot_owned_by() {
  local pid="$1" snapshot="$2"
  [[ -n "$snapshot" ]] || return 1
  /usr/bin/python3 -I - "$pid" "$snapshot" <<'PY'
import re, sys
expected = int(sys.argv[1])
lines = [line for line in sys.argv[2].splitlines() if line.strip()]
if not lines:
    raise SystemExit(1)
owners = []
for line in lines:
    pids = [int(value) for value in re.findall(r'pid=(\d+)', line)]
    if not pids:
        raise SystemExit(1)
    owners.extend(pids)
raise SystemExit(0 if owners and set(owners) == {expected} else 1)
PY
}

listener_owned_by() {
  local pid="$1" snapshot
  snapshot="$(port_listener_line)"
  listener_snapshot_owned_by "$pid" "$snapshot"
}

healthy_endpoint_owned_by() {
  local pid="$1" ticks="$2" before after
  exact_api_process "$pid" "$ticks" || return 1
  before="$(port_listener_line)"
  listener_snapshot_owned_by "$pid" "$before" || return 1
  health_up || return 1
  exact_api_process "$pid" "$ticks" || return 1
  after="$(port_listener_line)"
  listener_snapshot_owned_by "$pid" "$after"
}

process_owned_by_runtime_user() {
  local pid="$1"
  [[ "$(awk '/^Uid:/ {print $2 ":" $3}' "/proc/$pid/status" 2>/dev/null || true)" == "$RUNTIME_UID:$RUNTIME_UID" ]]
  [[ "$(awk '/^Gid:/ {print $2 ":" $3}' "/proc/$pid/status" 2>/dev/null || true)" == "$RUNTIME_GID:$RUNTIME_GID" ]]
}

health_up() {
  local body code
  body="$(mktemp /tmp/cyf-api-health.XXXXXX.json)"
  code="$(curl --noproxy '*' --silent --show-error --max-time 5 --output "$body" --write-out '%{http_code}' "$HEALTH_URL" 2>/dev/null || true)"
  if [[ "$code" == 200 ]] && /usr/bin/python3 -I - "$body" <<'PY'
import json, sys
try:
    payload = json.load(open(sys.argv[1], encoding='utf-8'))
except Exception:
    raise SystemExit(1)
status = payload.get('status')
if isinstance(status, dict):
    status = status.get('code')
raise SystemExit(0 if status == 'UP' else 1)
PY
  then
    rm -f "$body"
    return 0
  fi
  rm -f "$body"
  return 1
}

write_pid_files() {
  local pid="$1" target tmp
  for target in "$PID_FILE" "$ARCHIVE_PID_FILE"; do
    tmp="$(mktemp --tmpdir="$RUNTIME_DIR" ."$(basename "$target")".XXXXXX)"
    printf '%s\n' "$pid" > "$tmp"
    chmod 0644 "$tmp"
    chown root:root "$tmp"
    mv -f "$tmp" "$target"
  done
}

write_runtime_record() {
  local pid="$1" ticks="$2" jar_sha="$3" tmp
  tmp="$(mktemp --tmpdir="$RUNTIME_DIR" .cyf-api-kit.runtime.XXXXXX)"
  printf 'pid=%s\nstart_ticks=%s\njar_sha256=%s\n' "$pid" "$ticks" "$jar_sha" > "$tmp"
  chmod 0644 "$tmp"
  chown root:root "$tmp"
  mv -f "$tmp" "$RUNTIME_RECORD"
}

runtime_record_matches() {
  local pid="$1" ticks="$2" jar_sha="$3"
  [[ -f "$RUNTIME_RECORD" && ! -L "$RUNTIME_RECORD" ]] || return 2
  [[ "$(stat -Lc '%a %U %G' "$RUNTIME_RECORD" 2>/dev/null || true)" == "644 root root" ]] || return 1
  /usr/bin/python3 -I - "$RUNTIME_RECORD" "$pid" "$ticks" "$jar_sha" <<'PY'
from pathlib import Path
import sys
path, pid, ticks, jar_sha = sys.argv[1:]
values = {}
try:
    for line in Path(path).read_text(encoding='utf-8').splitlines():
        key, separator, value = line.partition('=')
        if not separator or key in values:
            raise ValueError('invalid runtime record')
        values[key] = value
except (OSError, ValueError):
    raise SystemExit(1)
expected = {'pid': pid, 'start_ticks': ticks, 'jar_sha256': jar_sha}
raise SystemExit(0 if values == expected else 1)
PY
}

clear_pid_files() {
  rm -f "$PID_FILE" "$ARCHIVE_PID_FILE" "$RUNTIME_RECORD"
}

show_status() {
  local pid="${1:-}" status_file listener ticks jar_sha attestation_rc
  if [[ -z "$pid" ]]; then
    echo "STATUS=STOPPED"
    listener="$(port_listener_line)"
    if [[ -n "$listener" ]]; then
      echo "PORT_${PORT}=LISTENING_BY_OTHER_PROCESS"
      echo "LISTENER=$listener"
      echo "HEALTH=NOT_CHECKED_UNOWNED_PORT"
      return 5
    fi
    echo "PORT_${PORT}=NOT_LISTENING"
    return 3
  fi
  ticks="$(proc_start_ticks "$pid" 2>/dev/null || true)"
  if [[ -z "$ticks" ]]; then
    echo "STATUS=STOPPED_DURING_CHECK"
    return 3
  fi
  status_file="$(mktemp /tmp/cyf-api-status.XXXXXX.txt)"
  if ! ps -p "$pid" -o pid,ppid,lstart,etime,stat,%cpu,%mem,rss,cmd > "$status_file"; then
    rm -f "$status_file"
    echo "STATUS=STOPPED_DURING_CHECK"
    return 3
  fi
  echo "STATUS=RUNNING"
  echo "PID=$pid"
  cat "$status_file"
  rm -f "$status_file"

  jar_sha=''
  if [[ -f "$JAR" && ! -L "$JAR" ]]; then
    jar_sha="$(sha256sum "$JAR" | awk '{print $1}')"
  fi
  set +e
  runtime_record_matches "$pid" "$ticks" "$jar_sha"
  attestation_rc=$?
  set -e
  case "$attestation_rc" in
    0) echo "ARTIFACT_ATTESTATION=MATCH" ;;
    2) echo "ARTIFACT_ATTESTATION=MISSING" ;;
    *) echo "ARTIFACT_ATTESTATION=MISMATCH" ;;
  esac

  listener="$(port_listener_line)"
  if listener_snapshot_owned_by "$pid" "$listener"; then
    echo "PORT_${PORT}=LISTENING_BY_PID"
  elif [[ -n "$listener" ]]; then
    echo "PORT_${PORT}=LISTENING_BY_OTHER_PROCESS"
    echo "LISTENER=$listener"
    echo "HEALTH=NOT_CHECKED_UNOWNED_PORT"
    return 5
  else
    echo "PORT_${PORT}=NOT_LISTENING"
    echo "HEALTH=NOT_READY"
    return 4
  fi
  if (( attestation_rc != 0 )); then
    echo "HEALTH=NOT_TRUSTED_ARTIFACT_MISMATCH"
    return 5
  fi
  if ! process_owned_by_runtime_user "$pid"; then
    echo "RUNTIME_IDENTITY=MISMATCH"
    echo "HEALTH=NOT_TRUSTED_RUNTIME_IDENTITY"
    return 5
  fi
  echo "RUNTIME_IDENTITY=$RUNTIME_USER($RUNTIME_UID:$RUNTIME_GID)"
  if healthy_endpoint_owned_by "$pid" "$ticks"; then
    echo "HEALTH=UP"
    return 0
  fi
  echo "HEALTH=NOT_READY"
  return 4
}

stop_api() {
  local pid ticks waited
  pid="$(current_pid)"
  if [[ -z "$pid" ]]; then
    clear_pid_files
    local foreign_listener
    foreign_listener="$(port_listener_line)"
    [[ -z "$foreign_listener" ]] || die "未发现可信 API 进程，但端口 $PORT 仍被其他进程监听：$foreign_listener"
    echo ">> 后端未运行，无需停止"
    return 0
  fi
  ticks="$(proc_start_ticks "$pid" 2>/dev/null || true)"
  if [[ -z "$ticks" ]]; then
    clear_pid_files
    echo ">> 后端已在停止检查期间退出"
    return 0
  fi
  echo ">> 停止后端 PID=$pid"
  if ! exact_api_process "$pid" "$ticks"; then
    if process_generation_alive "$pid" "$ticks"; then
      die "PID=$pid 仍存活但完整 API 身份已变化，拒绝误报停止"
    fi
    confirm_port_free
    clear_pid_files
    echo ">> 后端已在发送 TERM 前退出"
    return 0
  fi
  exact_api_process "$pid" "$ticks" TERM || die "TERM 前完整进程身份复核失败，拒绝发送信号"
  for waited in $(seq 1 "$STOP_TIMEOUT_SECONDS"); do
    if ! exact_api_process "$pid" "$ticks"; then
      if process_generation_alive "$pid" "$ticks"; then
        die "PID=$pid 在 TERM 后仍存活但身份变化，拒绝误报停止"
      fi
      confirm_port_free
      clear_pid_files
      echo ">> 后端已停止（${waited}s）"
      return 0
    fi
    sleep 1
  done
  echo ">> 超过 ${STOP_TIMEOUT_SECONDS}s，向同一进程发送 KILL"
  exact_api_process "$pid" "$ticks" KILL || die "KILL 前完整进程身份复核失败，拒绝发送信号"
  for waited in $(seq 1 10); do
    if ! exact_api_process "$pid" "$ticks"; then
      if process_generation_alive "$pid" "$ticks"; then
        die "PID=$pid 在 KILL 后仍存活但身份变化，拒绝误报停止"
      fi
      confirm_port_free
      clear_pid_files
      echo ">> 后端已强制停止"
      return 0
    fi
    sleep 1
  done
  die "无法停止 PID=$pid"
}

resource_gate() {
  local memory_available disk_available
  memory_available="$(awk '/^MemAvailable:/ {print $2 * 1024}' /proc/meminfo)"
  disk_available="$(df -PB1 -- "$DEPLOY_DIR" | awk 'NR == 2 {print $4}')"
  echo "HOST_MEM_AVAILABLE_BYTES=$memory_available"
  echo "HOST_DISK_AVAILABLE_BYTES=$disk_available"
  (( memory_available >= MIN_MEMORY_AVAILABLE_BYTES )) \
    || die "可用内存不足：$memory_available < $MIN_MEMORY_AVAILABLE_BYTES，拒绝启动以避免再次 OOM"
  (( disk_available >= MIN_DISK_AVAILABLE_BYTES )) \
    || die "可用磁盘不足：$disk_available < $MIN_DISK_AVAILABLE_BYTES，拒绝启动"
}

restart_resource_gate() {
  local pid memory_available reclaimable=0 projected disk_available
  pid="$(current_pid)"
  memory_available="$(awk '/^MemAvailable:/ {print $2 * 1024}' /proc/meminfo)"
  if [[ -n "$pid" && -r "/proc/$pid/status" ]]; then
    reclaimable="$(awk '/^VmRSS:/ {print $2 * 1024}' "/proc/$pid/status")"
    [[ "$reclaimable" =~ ^[0-9]+$ ]] || reclaimable=0
  fi
  projected=$((memory_available + reclaimable))
  disk_available="$(df -PB1 -- "$DEPLOY_DIR" | awk 'NR == 2 {print $4}')"
  echo "HOST_MEM_AVAILABLE_BYTES=$memory_available"
  echo "RUNNING_API_RSS_BYTES=$reclaimable"
  echo "PROJECTED_POST_STOP_MEM_AVAILABLE_BYTES=$projected"
  echo "HOST_DISK_AVAILABLE_BYTES=$disk_available"
  (( projected >= MIN_MEMORY_AVAILABLE_BYTES )) \
    || die "预计停止旧进程后可用内存仍不足，保留当前服务"
  (( disk_available >= MIN_DISK_AVAILABLE_BYTES )) \
    || die "可用磁盘不足，保留当前服务"
}

start_api() {
  local skip_resource_gate="${1:-0}"
  local pid ticks stamp log_file elapsed listener jar_sha attestation_rc
  pid="$(current_pid)"
  if [[ -n "$pid" ]]; then
    ticks="$(proc_start_ticks "$pid" 2>/dev/null || true)"
    if [[ -n "$ticks" ]] && healthy_endpoint_owned_by "$pid" "$ticks"; then
      jar_sha="$(sha256sum "$JAR" | awk '{print $1}')"
      set +e
      runtime_record_matches "$pid" "$ticks" "$jar_sha"
      attestation_rc=$?
      set -e
      (( attestation_rc == 0 )) \
        || die "PID=$pid 健康但运行制品与当前 JAR 无法一致证明；请执行 restart"
      write_pid_files "$pid"
      echo ">> 后端已经健康运行，PID=$pid"
      return 0
    fi
    die "PID=$pid 已存在但尚未健康；拒绝重复启动，请使用 status 查看"
  fi
  listener="$(port_listener_line)"
  [[ -z "$listener" ]] || die "端口 $PORT 已被其他进程占用：$listener"
  (( skip_resource_gate == 1 )) || resource_gate

  jar_sha="$(sha256sum "$JAR" | awk '{print $1}')"
  stamp="$(date +%Y%m%d_%H%M%S)"
  log_file="$(mktemp --tmpdir="$LOG_DIR" startlog_${stamp}.XXXXXX.log)"
  chmod 0640 "$log_file"
  chown root:root "$log_file"
  echo ">> 使用现有 JAR 启动后端（运行用户 $RUNTIME_USER）"
  echo ">> JAR_SHA256=$jar_sha"
  echo ">> LOG=$log_file"

  cd "$DEPLOY_DIR"
  (
  local environment_name assignment name value
  while IFS= read -r environment_name; do
    case "$environment_name" in PATH|LC_ALL|JASYPT_ENCRYPTOR_PASSWORD) ;; *) unset "$environment_name" ;; esac
  done < <(compgen -e)
  export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C HOME=/home/isp USER="$RUNTIME_USER" LOGNAME="$RUNTIME_USER"
  for assignment in "${VOICE_ENV_ASSIGNMENTS[@]}"; do
    name="${assignment%%=*}"
    value="${assignment#*=}"
    printf -v "$name" '%s' "$value"
    export "$name"
  done
  exec nohup setsid setpriv --reuid="$RUNTIME_USER" --regid="$RUNTIME_GID" --init-groups --no-new-privs "$JAVA" \
    -Xms128m -Xmx384m -Xss256k \
    -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=64m \
    -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
    '-Xlog:gc*::time,uptime,tags' \
    -jar "$JAR" \
    --server.port="$PORT" \
    --server.address=127.0.0.1 \
    --spring.profiles.active=prod \
    --logging.level.root=info \
    --logging.level.org.springframework.security=info \
    --spring.ai.mcp.client.enabled=false \
    --spring.ai.mcp.client.toolcallback.enabled=false \
    '--spring.autoconfigure.exclude=org.springframework.ai.mcp.client.common.autoconfigure.McpClientAutoConfiguration,org.springframework.ai.mcp.client.common.autoconfigure.McpToolCallbackAutoConfiguration' \
    --archive.reader.enabled=true \
    --archive.reader.allowed-scopes[0].tenant-id=oH2zD1PUPvspicVak69uB4wDaFLg \
    --archive.reader.allowed-scopes[0].client-id=jiafewnnv58ec2379c \
  ) > "$log_file" 2>&1 < /dev/null 8>&- 9>&- &
  pid=$!
  ticks=''
  for _ in $(seq 1 20); do
    ticks="$(proc_start_ticks "$pid" 2>/dev/null || true)"
    [[ -n "$ticks" ]] && break
    sleep 0.1
  done
  [[ -n "$ticks" ]] || { tail -n 100 "$log_file" >&2 || true; die "Java 在身份捕获前退出"; }
  [[ "$(sha256sum "$JAR" | awk '{print $1}')" == "$jar_sha" ]] \
    || { exact_api_process "$pid" "$ticks" TERM 2>/dev/null || true; die "JAR 在启动身份捕获期间发生变化"; }
  write_pid_files "$pid"
  write_runtime_record "$pid" "$ticks" "$jar_sha"
  echo ">> Java 已启动，PID=$pid；等待健康检查（最长 ${HEALTH_TIMEOUT_SECONDS}s）"

  local started_at=$SECONDS next_report=60
  while (( SECONDS - started_at < HEALTH_TIMEOUT_SECONDS )); do
    elapsed=$((SECONDS - started_at))
    if ! exact_api_process "$pid" "$ticks"; then
      clear_pid_files
      tail -n 160 "$log_file" >&2 || true
      die "Java 在启动期间退出"
    fi
    if healthy_endpoint_owned_by "$pid" "$ticks"; then
      sleep 5
      exact_api_process "$pid" "$ticks" || die "健康后进程立即退出或身份变化"
      listener_owned_by "$pid" || die "健康后端口所有者发生变化"
      process_owned_by_runtime_user "$pid" || die "健康后运行用户不匹配"
      [[ "$(sha256sum "$JAR" | awk '{print $1}')" == "$jar_sha" ]] || die "健康后 live JAR SHA 发生变化"
      runtime_record_matches "$pid" "$ticks" "$jar_sha" || die "健康后运行制品记录不匹配"
      healthy_endpoint_owned_by "$pid" "$ticks" || die "健康状态或端口归属未能稳定"
      echo ">> 后端启动完成"
      echo "PID=$pid"
      echo "HEALTH=UP"
      echo "READY_AFTER_SECONDS=$elapsed"
      echo "LOG=$log_file"
      return 0
    fi
    if (( elapsed >= next_report )); then
      echo ">> 仍在启动：${elapsed}s（该应用历史冷启动约 9-13 分钟）"
      tail -n 2 "$log_file" | sed 's/^/   /' || true
      next_report=$((next_report + 60))
    fi
    sleep 1
  done
  tail -n 200 "$log_file" >&2 || true
  die "${HEALTH_TIMEOUT_SECONDS}s 内未达到 HEALTH=UP；进程仍保留，避免误杀正在初始化的服务"
}

case "$ACTION" in
  status)
    status_pid="$(current_pid)"
    show_status "$status_pid"
    ;;
  stop)
    stop_api
    ;;
  start)
    load_start_requirements
    start_api
    ;;
  restart)
    load_start_requirements
    restart_resource_gate
    stop_api
    start_api 0
    ;;
esac
