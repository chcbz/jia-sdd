#!/bin/bash -p
# Installs one exact Flow-produced API package. This is a root-only package boundary.
set -euo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

PACKAGE_ROOT=/var/lib/cyf-api-flow
INCOMING_PACKAGE="$PACKAGE_ROOT/incoming/package.tgz"
APPROVAL_PATH="$PACKAGE_ROOT/approval.json"
BACKUP_ROOT="$PACKAGE_ROOT/backups"
RECORD_PATH="$PACKAGE_ROOT/record.json"
TARGET_JAR=/opt/cyf/service/api/cyf-api-kit.jar
LIFECYCLE=/usr/local/sbin/cyf-api-kit
RELEASE_LOCK=/tmp/cyf-release-api.lock
EXPECTED_ORGANIZATION=5fb7d76ee6f9d07f148529c7
EXPECTED_PIPELINE=5260799
EXPECTED_JOB=cloud_ci.api_ci
MAX_PACKAGE_BYTES=$((2 * 1024 * 1024 * 1024))
MAX_EXTRACT_BYTES=$((3 * 1024 * 1024 * 1024))
MIN_LIFECYCLE_BYTES=$((5 * 1024 * 1024 * 1024))

fail() { printf 'cyf-api-flow-install: %s\n' "$*" >&2; exit 1; }
recoverable_fail() { fail "$*; rerun the same exact package and approval to recover"; }
[[ $# -eq 0 ]] || fail 'this installer accepts no arguments'

OFFLINE_TEST=0
if [[ "${CYF_RELEASE_OFFLINE_TEST:-}" == YES ]]; then
  OFFLINE_TEST=1
else
  (( EUID == 0 )) || fail 'must be run by root'
fi

if (( OFFLINE_TEST )); then
  TEST_ROOT="${CYF_API_FLOW_INSTALL_TEST_ROOT:-}"
  [[ "$TEST_ROOT" == /tmp/* && -d "$TEST_ROOT" && ! -L "$TEST_ROOT" ]] || fail 'offline fixture root must be a physical /tmp directory'
  [[ "$(stat -Lc '%a:%u' "$TEST_ROOT")" == "700:$(id -u)" ]] || fail 'offline fixture root must be caller-owned 0700'
  PACKAGE_ROOT="$TEST_ROOT/state"
  INCOMING_PACKAGE="$PACKAGE_ROOT/incoming/package.tgz"
  APPROVAL_PATH="$PACKAGE_ROOT/approval.json"
  BACKUP_ROOT="$PACKAGE_ROOT/backups"
  RECORD_PATH="$PACKAGE_ROOT/record.json"
  TARGET_JAR="$TEST_ROOT/service/cyf-api-kit.jar"
  LIFECYCLE="$TEST_ROOT/bin/cyf-api-kit"
  RELEASE_LOCK="$TEST_ROOT/cyf-release-api.lock"
fi

if (( OFFLINE_TEST )); then
  INSTALL_OWNER="$(id -un)"
  INSTALL_GROUP="$(id -gn)"
  INSTALL_UID="$(id -u)"
  INSTALL_GID="$(id -g)"
  TEST_FAULT="${CYF_API_FLOW_TEST_FAULT:-}"
  TEST_FAULT_MARK="${CYF_API_FLOW_TEST_FAULT_MARK:-$TEST_ROOT/fault-mark}"
else
  INSTALL_OWNER=root
  INSTALL_GROUP=isp
  INSTALL_UID=0
  INSTALL_GID="$(id -g isp)"
  TEST_FAULT=''
  TEST_FAULT_MARK=''
fi
TARGET_DIR="$(dirname "$TARGET_JAR")"

for command in awk chmod chown date df flock grep mkdir mktemp python3 rm sha256sum stat; do
  command -v "$command" >/dev/null 2>&1 || fail "missing command: $command"
done

mkdir -p -m 0700 "$PACKAGE_ROOT" "$PACKAGE_ROOT/incoming" "$BACKUP_ROOT"
[[ ! -L "$PACKAGE_ROOT" && ! -L "$PACKAGE_ROOT/incoming" && ! -L "$BACKUP_ROOT" && ! -L "$TARGET_DIR" ]] || fail 'package or target directory is symlinked'
if [[ -e "$TARGET_JAR" || -L "$TARGET_JAR" ]]; then
  [[ -f "$TARGET_JAR" && ! -L "$TARGET_JAR" && -s "$TARGET_JAR" && "$(stat -Lc '%h' "$TARGET_JAR")" == 1 ]] || fail 'canonical JAR is unsafe'
fi
[[ -x "$LIFECYCLE" && ! -L "$LIFECYCLE" ]] || fail 'trusted lifecycle command is missing or unsafe'
[[ "$(stat -Lc '%u:%a:%h' "$LIFECYCLE")" =~ ^${INSTALL_UID}:[0-7]{3}:1$ ]] || fail 'lifecycle command metadata is unreadable'
LIFECYCLE_MODE="$(stat -Lc '%a' "$LIFECYCLE")"
(( (8#$LIFECYCLE_MODE & 0022) == 0 )) || fail 'lifecycle command must not be group/world writable'

if (( ! OFFLINE_TEST )); then
  [[ "$0" == /usr/local/sbin/cyf-api-flow-install && ! -L "$0" ]] || fail 'production installer must use its fixed root-owned path'
  [[ "$(stat -Lc '%u:%a:%h' "$0")" =~ ^0:[0-7]{3}:1$ ]] || fail 'installer must be a root-owned physical file'
  INSTALLER_MODE="$(stat -Lc '%a' "$0")"
  (( (8#$INSTALLER_MODE & 0022) == 0 )) || fail 'installer must not be group/world writable'
  [[ "$(stat -Lc '%a:%u:%g' "$PACKAGE_ROOT")" == '700:0:0' ]] || fail 'package root must be root-owned 0700'
  [[ "$(stat -Lc '%a:%u:%g' "$PACKAGE_ROOT/incoming")" == '700:0:0' ]] || fail 'incoming directory must be root-owned 0700'
  [[ "$(stat -Lc '%a:%u:%g' "$BACKUP_ROOT")" == '700:0:0' ]] || fail 'backup directory must be root-owned 0700'
  [[ "$(stat -Lc '%a:%U:%G' "$TARGET_DIR")" == '755:root:root' ]] || fail 'target directory must be root-owned 0755'
  if [[ -e "$TARGET_JAR" ]]; then
    [[ "$(stat -Lc '%a:%U:%G' "$TARGET_JAR")" == '640:root:isp' ]] || fail 'target JAR must be root:isp 0640'
  fi
fi

# Lock order is fixed: FD8 global release lock first, then record/approval/canonical
# filesystem transitions. The lifecycle command inherits this same lock; there are no
# nested installer locks.
[[ -f "$RELEASE_LOCK" && ! -L "$RELEASE_LOCK" ]] || fail 'release lock is missing or unsafe'
if (( OFFLINE_TEST )); then
  [[ "$(stat -Lc '%a:%u:%g:%h' "$RELEASE_LOCK")" == "600:${INSTALL_UID}:${INSTALL_GID}:1" ]] || fail 'offline release lock metadata is unsafe'
else
  [[ "$(stat -Lc '%a:%u:%g:%h' "$RELEASE_LOCK")" == "660:0:${INSTALL_GID}:1" ]] || fail 'release lock metadata is unsafe'
fi
exec 8<>"$RELEASE_LOCK"
[[ "$(stat -Lc '%d:%i' "$RELEASE_LOCK")" == "$(stat -Lc '%d:%i' /proc/$$/fd/8)" ]] || fail 'release lock changed while opening'
flock -w 60 8 || fail 'another API release is active'
LOCK_DEVICE="$(stat -Lc '%d' /proc/$$/fd/8)"
LOCK_INODE="$(stat -Lc '%i' /proc/$$/fd/8)"
export CYF_RELEASE_LOCK_INHERITED_FD=8 CYF_RELEASE_LOCK_DEVICE="$LOCK_DEVICE" CYF_RELEASE_LOCK_INODE="$LOCK_INODE" CYF_RELEASE_LOCK_HELD=1

# Historical Flow downloads are root:root 0775. Only a physical, single-link,
# owner-controlled package below the 0700 incoming directory may be normalized.
[[ -f "$INCOMING_PACKAGE" && ! -L "$INCOMING_PACKAGE" ]] || fail 'incoming package is missing or unsafe'
[[ "$(stat -Lc '%u:%h' "$INCOMING_PACKAGE")" == "${INSTALL_UID}:1" ]] || fail 'incoming package must be owner-controlled and single-link'
PACKAGE_BYTES="$(stat -Lc '%s' "$INCOMING_PACKAGE")"
[[ "$PACKAGE_BYTES" =~ ^[0-9]+$ ]] || fail 'incoming package metadata is unreadable'
(( PACKAGE_BYTES <= MAX_PACKAGE_BYTES )) || fail 'incoming package exceeds size limit'
chmod 0600 "$INCOMING_PACKAGE"
[[ "$(stat -Lc '%u:%a:%h' "$INCOMING_PACKAGE")" == "${INSTALL_UID}:600:1" ]] || fail 'incoming package normalization failed'

[[ -f "$APPROVAL_PATH" && ! -L "$APPROVAL_PATH" ]] || fail 'approval is missing or unsafe'
[[ "$(stat -Lc '%u:%a:%h' "$APPROVAL_PATH")" == "${INSTALL_UID}:600:1" ]] || fail 'approval must be owner-controlled 0600 single-link'
[[ ! -e "$RECORD_PATH" || ( -f "$RECORD_PATH" && ! -L "$RECORD_PATH" && "$(stat -Lc '%u:%a:%h' "$RECORD_PATH")" == "${INSTALL_UID}:600:1" ) ]] || fail 'record path is unsafe'

read_record() {
  python3 -I -B - "$RECORD_PATH" "$INSTALL_UID" "$BACKUP_ROOT" <<'PY'
import json, os, re, stat, sys
from pathlib import Path
path = Path(sys.argv[1])
uid = int(sys.argv[2])
backup_root = Path(sys.argv[3])
if not path.exists() and not path.is_symlink():
    print('ABSENT')
    raise SystemExit(0)
info = os.lstat(path)
if (not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_nlink != 1
        or stat.S_IMODE(info.st_mode) != 0o600):
    raise SystemExit('unsafe record')
try:
    value = json.loads(path.read_text(encoding='utf-8'))
except (OSError, UnicodeDecodeError, ValueError):
    raise SystemExit('invalid record JSON')
keys = {
    'schema_version', 'status', 'phase', 'recovery', 'ticket_sha256',
    'source_commit_sha', 'source_tree_sha', 'run_id', 'receipt_sha256',
    'candidate_sha256', 'previous_sha256', 'backup', 'candidate_stop_rc', 'timestamp',
}
sha = re.compile(r'^[0-9a-f]{64}$')
git = re.compile(r'^[0-9a-f]{40}$')
run = re.compile(r'^[1-9][0-9]*$')
word = re.compile(r'^[a-z0-9_]+$')
time = re.compile(r'^[0-9]{8}T[0-9]{6}Z$')
statuses = {'prepared', 'activating', 'active_pending', 'rolling_back', 'installed', 'failed'}
backup = Path(value.get('backup', ''))
if (not isinstance(value, dict) or set(value) != keys or value.get('schema_version') != 2
        or value.get('status') not in statuses
        or not isinstance(value.get('phase'), str) or not word.fullmatch(value['phase'])
        or not isinstance(value.get('recovery'), str) or not word.fullmatch(value['recovery'])
        or not isinstance(value.get('ticket_sha256'), str) or not sha.fullmatch(value['ticket_sha256'])
        or not isinstance(value.get('source_commit_sha'), str) or not git.fullmatch(value['source_commit_sha'])
        or not isinstance(value.get('source_tree_sha'), str) or not git.fullmatch(value['source_tree_sha'])
        or not isinstance(value.get('run_id'), str) or not run.fullmatch(value['run_id'])
        or not isinstance(value.get('receipt_sha256'), str) or not sha.fullmatch(value['receipt_sha256'])
        or not isinstance(value.get('candidate_sha256'), str) or not sha.fullmatch(value['candidate_sha256'])
        or not isinstance(value.get('previous_sha256'), str) or not sha.fullmatch(value['previous_sha256'])
        or not isinstance(value.get('candidate_stop_rc'), int) or not 0 <= value['candidate_stop_rc'] <= 255
        or not isinstance(value.get('timestamp'), str) or not time.fullmatch(value['timestamp'])
        or not backup.is_absolute() or backup.parent != backup_root
        or not re.fullmatch(r'[0-9]{8}T[0-9]{6}Z-[0-9a-f]{64}-[0-9]+\.jar', backup.name)):
    raise SystemExit('invalid record values')
for field in ('status', 'phase', 'recovery', 'ticket_sha256', 'source_commit_sha',
              'source_tree_sha', 'run_id', 'receipt_sha256', 'candidate_sha256',
              'previous_sha256', 'backup', 'candidate_stop_rc', 'timestamp'):
    print(value[field])
PY
}

mapfile -t EARLY_RECORD < <(read_record)
(( ${#EARLY_RECORD[@]} >= 1 )) || fail 'durable record validation failed'
EARLY_RECORD_STATUS="${EARLY_RECORD[0]}"
if [[ ! -e "$TARGET_JAR" ]]; then
  [[ "$EARLY_RECORD_STATUS" != ABSENT ]] || fail 'missing canonical JAR has no durable recovery record'
  (( ${#EARLY_RECORD[@]} == 13 )) || fail 'missing canonical JAR recovery record is incomplete'
fi

# Scan and size the complete member catalog before creating any extraction directory.
# This is admission only; the second pass performs byte and JSON validation while unpacking.
EXTRACT_BYTES="$(python3 -I -B - "$INCOMING_PACKAGE" "$MAX_PACKAGE_BYTES" "$MAX_EXTRACT_BYTES" <<'PY'
import os, sys, tarfile
from pathlib import Path
package = Path(sys.argv[1])
max_package, max_extract = map(int, sys.argv[2:])
expected = {
    'application.jar', 'application.metadata.json', 'application.sidecar.json',
    'dependency.provenance.json', 'receipt.json',
}
json_members = {'application.metadata.json', 'application.sidecar.json', 'dependency.provenance.json', 'receipt.json'}
seen = set()
total = 0
try:
    info = package.stat()
    if not package.is_file() or package.is_symlink() or info.st_nlink != 1 or info.st_size > max_package:
        raise SystemExit('unsafe package metadata')
    with tarfile.open(package, 'r|gz') as archive:
        for member in archive:
            name = member.name[2:] if member.name.startswith('./') else member.name
            if name in ('', '.') and member.isdir():
                continue
            limit = 4 * 1024 * 1024 if name in json_members else 2 * 1024 * 1024 * 1024
            if (not name or name.startswith('/') or '\\' in name or '\x00' in name
                    or any(part in ('', '.', '..') for part in name.split('/'))
                    or name in seen or name not in expected or not member.isreg()
                    or member.size < 0 or member.size > limit or total + member.size > max_extract):
                raise SystemExit('unsafe, duplicate, or oversized package member')
            seen.add(name)
            total += member.size
except (OSError, tarfile.TarError):
    raise SystemExit('package archive is unreadable')
if seen != expected:
    raise SystemExit('package member set is incomplete')
print(total)
PY
)" || fail 'package archive admission failed'
[[ "$EXTRACT_BYTES" =~ ^[0-9]+$ ]] || fail 'package extract size is invalid'

filesystem_device() {
  local role="$1" path="$2" variable value
  variable="CYF_API_FLOW_TEST_${role^^}_DEVICE"
  if (( OFFLINE_TEST )); then
    value="${!variable:-}"
    if [[ "$value" =~ ^[0-9]+$ ]]; then printf '%s\n' "$value"; return 0; fi
  fi
  stat -Lc '%d' "$path"
}

available_bytes() {
  local role="$1" path="$2" variable value available_kib
  variable="CYF_API_FLOW_TEST_${role^^}_AVAILABLE_BYTES"
  if (( OFFLINE_TEST )); then
    value="${!variable:-}"
    if [[ "$value" =~ ^[0-9]+$ ]]; then printf '%s\n' "$value"; return 0; fi
  fi
  available_kib="$(df -Pk "$path" | awk 'NR == 2 {print $4}')"
  [[ "$available_kib" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$((available_kib * 1024))"
}

if [[ -e "$TARGET_JAR" ]]; then
  OLD_JAR_BYTES="$(stat -Lc '%s' "$TARGET_JAR")"
else
  EARLY_BACKUP="${EARLY_RECORD[10]}"
  [[ -f "$EARLY_BACKUP" && ! -L "$EARLY_BACKUP" ]] || fail 'missing canonical JAR has no physical rollback backup'
  [[ "$(stat -Lc '%u:%a:%h' "$EARLY_BACKUP")" == "${INSTALL_UID}:600:1" ]] || fail 'rollback backup metadata is unsafe'
  OLD_JAR_BYTES="$(stat -Lc '%s' "$EARLY_BACKUP")"
fi
TARGET_DEVICE="$(filesystem_device target "$TARGET_DIR")" || fail 'cannot identify target filesystem'
BACKUP_DEVICE="$(filesystem_device backup "$BACKUP_ROOT")" || fail 'cannot identify backup filesystem'
TARGET_AVAILABLE="$(available_bytes target "$TARGET_DIR")" || fail 'cannot read target filesystem capacity'
BACKUP_AVAILABLE="$(available_bytes backup "$BACKUP_ROOT")" || fail 'cannot read backup filesystem capacity'
if [[ "$TARGET_DEVICE" == "$BACKUP_DEVICE" ]]; then
  PRE_EXTRACT_TARGET_REQUIRED=$((MIN_LIFECYCLE_BYTES + EXTRACT_BYTES + OLD_JAR_BYTES))
  (( TARGET_AVAILABLE >= PRE_EXTRACT_TARGET_REQUIRED )) || fail 'insufficient same-filesystem capacity before unpacking candidate'
else
  PRE_EXTRACT_TARGET_REQUIRED=$((MIN_LIFECYCLE_BYTES + EXTRACT_BYTES))
  if [[ ! -e "$TARGET_JAR" ]]; then
    # Recovery must recreate the canonical old JAR beside the extracted candidate.
    PRE_EXTRACT_TARGET_REQUIRED=$((PRE_EXTRACT_TARGET_REQUIRED + OLD_JAR_BYTES))
  fi
  (( TARGET_AVAILABLE >= PRE_EXTRACT_TARGET_REQUIRED )) || fail 'insufficient target capacity before unpacking candidate'
  if [[ -e "$TARGET_JAR" ]]; then
    (( BACKUP_AVAILABLE >= OLD_JAR_BYTES )) || fail 'insufficient backup capacity before unpacking candidate'
  fi
fi

# The candidate is staged on the canonical JAR filesystem so publication is one atomic
# replace. The extraction directory is created only after the admission calculation above.
WORK="$(mktemp -d "$TARGET_DIR/.cyf-api-flow-install.XXXXXX")"
cleanup() { rm -rf -- "$WORK"; }
trap cleanup EXIT

mapfile -t APPROVAL_CONTEXT < <(python3 -I -B - "$INCOMING_PACKAGE" "$WORK" "$APPROVAL_PATH" "$EXPECTED_ORGANIZATION" "$EXPECTED_PIPELINE" "$EXPECTED_JOB" "$MAX_PACKAGE_BYTES" "$MAX_EXTRACT_BYTES" "$INSTALL_UID" <<'PY'
import hashlib, json, os, re, stat, sys, tarfile, zipfile
from pathlib import Path

package, work, approval_path = map(Path, sys.argv[1:4])
expected_org, expected_pipeline, expected_job = sys.argv[4:7]
max_package, max_extract, expected_uid = map(int, sys.argv[7:10])
expected = {
    'application.jar', 'application.metadata.json', 'application.sidecar.json',
    'dependency.provenance.json', 'receipt.json',
}
json_members = {'application.metadata.json', 'application.sidecar.json', 'dependency.provenance.json', 'receipt.json'}
sha256_re = re.compile(r'^[0-9a-f]{64}$')
git_re = re.compile(r'^[0-9a-f]{40}$')
run_re = re.compile(r'^[1-9][0-9]*$')
time_re = re.compile(r'^[0-9]{8}T[0-9]{6}Z$')
root = Path(work)
root_stat = root.stat()
package_stat = package.stat()
approval_stat = approval_path.stat()
if (root_stat.st_uid != os.geteuid() or stat.S_IMODE(root_stat.st_mode) != 0o700
        or not stat.S_ISREG(package_stat.st_mode) or package_stat.st_uid != expected_uid
        or package_stat.st_nlink != 1 or package_stat.st_size > max_package
        or not stat.S_ISREG(approval_stat.st_mode) or approval_stat.st_uid != expected_uid
        or approval_stat.st_nlink != 1 or stat.S_IMODE(approval_stat.st_mode) != 0o600):
    raise SystemExit('unsafe package, approval, or staging metadata')

def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()

def write_all(fd, block):
    view = memoryview(block)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise OSError('short package write')
        view = view[written:]

seen = set()
total = 0
try:
    with tarfile.open(package, 'r|gz') as archive:
        for member in archive:
            name = member.name[2:] if member.name.startswith('./') else member.name
            if name in ('', '.') and member.isdir():
                continue
            limit = 4 * 1024 * 1024 if name in json_members else 2 * 1024 * 1024 * 1024
            if (not name or name.startswith('/') or '\\' in name or '\x00' in name
                    or any(part in ('', '.', '..') for part in name.split('/'))
                    or name in seen or name not in expected or not member.isreg()
                    or member.size < 0 or member.size > limit or total + member.size > max_extract):
                raise SystemExit('unsafe, duplicate, or oversized package member')
            seen.add(name)
            total += member.size
            source = archive.extractfile(member)
            if source is None:
                raise SystemExit('unreadable package member')
            target = root / name
            fd = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            try:
                while True:
                    block = source.read(1024 * 1024)
                    if not block:
                        break
                    write_all(fd, block)
                os.fsync(fd)
            finally:
                os.close(fd)
            if target.stat().st_size != member.size:
                raise SystemExit('package member size mismatch')
except (OSError, tarfile.TarError):
    raise SystemExit('package archive is unreadable')
if seen != expected:
    raise SystemExit('package member set is incomplete')
directory_fd = os.open(str(root), os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)

try:
    receipt_bytes = (root / 'receipt.json').read_bytes()
    receipt = json.loads(receipt_bytes.decode('utf-8'))
    metadata = json.loads((root / 'application.metadata.json').read_text(encoding='utf-8'))
    sidecar = json.loads((root / 'application.sidecar.json').read_text(encoding='utf-8'))
    provenance = json.loads((root / 'dependency.provenance.json').read_text(encoding='utf-8'))
    approval = json.loads(approval_path.read_text(encoding='utf-8'))
except (OSError, UnicodeDecodeError, ValueError):
    raise SystemExit('package or approval JSON is invalid')
if not all(isinstance(value, dict) for value in (receipt, metadata, sidecar, provenance, approval)):
    raise SystemExit('package or approval JSON shape is invalid')

approval_open = {
    'schema_version', 'ticket_sha256', 'source_commit_sha', 'source_tree_sha',
    'run_id', 'receipt_sha256', 'jar_sha256', 'consumed',
}
approval_closed = approval_open | {'consumed_at'}
if set(approval) not in (approval_open, approval_closed):
    raise SystemExit('approval schema is invalid')
if (approval.get('schema_version') != 2 or not isinstance(approval.get('consumed'), bool)
        or set(approval) != (approval_closed if approval['consumed'] else approval_open)
        or not isinstance(approval.get('ticket_sha256'), str) or not sha256_re.fullmatch(approval['ticket_sha256'])
        or not isinstance(approval.get('source_commit_sha'), str) or not git_re.fullmatch(approval['source_commit_sha'])
        or not isinstance(approval.get('source_tree_sha'), str) or not git_re.fullmatch(approval['source_tree_sha'])
        or not isinstance(approval.get('run_id'), str) or not run_re.fullmatch(approval['run_id'])
        or not isinstance(approval.get('receipt_sha256'), str) or not sha256_re.fullmatch(approval['receipt_sha256'])
        or not isinstance(approval.get('jar_sha256'), str) or not sha256_re.fullmatch(approval['jar_sha256'])
        or (approval['consumed'] and (not isinstance(approval.get('consumed_at'), str)
                                      or not time_re.fullmatch(approval['consumed_at'])))):
    raise SystemExit('approval values are invalid')

flow = receipt.get('flow')
source = receipt.get('source')
files = receipt.get('files')
if (receipt.get('status') != 'success' or receipt.get('gradle_exit_code') != 0
        or receipt.get('bridge_exit_code') != 0 or not isinstance(flow, dict)
        or flow.get('organization_id') != expected_org or flow.get('pipeline_id') != expected_pipeline
        or flow.get('job_id') != expected_job or not isinstance(flow.get('run_id'), str)
        or not run_re.fullmatch(flow['run_id'])
        or not isinstance(flow.get('source_tip_sha'), str) or not git_re.fullmatch(flow['source_tip_sha'])
        or not isinstance(source, dict) or source.get('branch') != 'develop'
        or not isinstance(source.get('commit_sha'), str) or not git_re.fullmatch(source['commit_sha'])
        or not isinstance(source.get('tree_sha'), str) or not git_re.fullmatch(source['tree_sha'])
        or source.get('clean_before') is not True or source.get('clean_after') is not True
        or not isinstance(receipt.get('ticket_sha256'), str) or not sha256_re.fullmatch(receipt['ticket_sha256'])
        or not isinstance(files, list)):
    raise SystemExit('receipt release gate failed')

records = {}
for item in files:
    if not isinstance(item, dict) or not isinstance(item.get('kind'), str):
        raise SystemExit('receipt file record is invalid')
    if item['kind'] in ('application_jar', 'dependency_provenance'):
        if item['kind'] in records:
            raise SystemExit('receipt has duplicate release record')
        records[item['kind']] = item
if set(records) != {'application_jar', 'dependency_provenance'}:
    raise SystemExit('receipt release records are incomplete')
jar = root / 'application.jar'
provenance_path = root / 'dependency.provenance.json'
jar_sha = digest(jar)
receipt_sha = hashlib.sha256(receipt_bytes).hexdigest()
if (not isinstance(records['application_jar'].get('sha256'), str)
        or not sha256_re.fullmatch(records['application_jar']['sha256'])
        or records['application_jar']['sha256'] != jar_sha
        or records['application_jar'].get('size') != jar.stat().st_size):
    raise SystemExit('application JAR does not match receipt')
if (not isinstance(records['dependency_provenance'].get('sha256'), str)
        or not sha256_re.fullmatch(records['dependency_provenance']['sha256'])
        or records['dependency_provenance']['sha256'] != digest(provenance_path)
        or records['dependency_provenance'].get('size') != provenance_path.stat().st_size):
    raise SystemExit('provenance does not match receipt')
if (receipt['ticket_sha256'] != approval['ticket_sha256']
        or source['commit_sha'] != approval['source_commit_sha']
        or source['tree_sha'] != approval['source_tree_sha']
