  if [[ ! -e "$TARGET_JAR" ]]; then printf 'MISSING\n'; return 0; fi
  if [[ ! -f "$TARGET_JAR" || "$(stat -Lc '%h' "$TARGET_JAR")" != 1 ]]; then printf 'UNSAFE\n'; return 0; fi
