assert_old_or_absent() {
  local state
  state="$(canonical_sha)"
  [[ "$state" == MISSING || "$state" == "$OLD_SHA" ]]
}

restore_and_start() {
  local phase="$1" stop_verified=0 recovery
  # The rollback decision is durable before stop, detach, or restore. Recovery dispatch
  # treats this intent as monotonic and can never resume candidate promotion.
  if ! write_record rolling_back "$phase" rollback_intent "$STOP_RC"; then
    recoverable_fail 'rollback intent record was interrupted before rollback mutation'
  fi
  if stop_and_verify; then stop_verified=1; fi
  if ! detach_candidate; then
    recoverable_fail 'candidate detachment was interrupted after durable rollback intent'
  fi
  assert_old_or_absent || fail 'rollback could not make the canonical path fail closed'
  if ! write_record rolling_back "$phase" candidate_detached "$STOP_RC"; then
    recoverable_fail 'rollback candidate-detached record was interrupted'
  fi
  if ! restore_backup; then
    assert_old_or_absent || fail 'rollback restore failure left unsafe canonical bytes'
    write_record rolling_back "$phase" backup_restore_failed "$STOP_RC" || recoverable_fail 'rollback failure record was interrupted'
    recoverable_fail 'rollback backup restore failed with canonical path old or absent'
  fi
  assert_old_or_absent || fail 'rollback restored unexpected canonical bytes'
  if (( ! stop_verified )); then
    write_record rolling_back "$phase" candidate_stop_unverified "$STOP_RC" || recoverable_fail 'rollback stop-failure record was interrupted'
    recoverable_fail 'candidate stop could not be explicitly verified; old JAR is canonical but was not started'
  fi
  if ! "$LIFECYCLE" start; then
    write_record rolling_back "$phase" old_start_failed "$STOP_RC" || recoverable_fail 'rollback old-start record was interrupted'
    recoverable_fail 'rollback old version failed to start'
  fi
  if ! lifecycle_healthy; then
    if stop_and_verify; then recovery=old_status_failed_stopped; else recovery=old_status_failed_stop_unverified; fi
    write_record rolling_back "$phase" "$recovery" "$STOP_RC" || recoverable_fail 'rollback old-status record was interrupted'
    recoverable_fail 'rollback old version failed health status'
  fi
  if (( STOP_RC == 0 )); then recovery=restored_healthy; else recovery=restored_healthy_after_stop_error; fi
  write_record failed "$phase" "$recovery" "$STOP_RC" || recoverable_fail 'rollback completion record was interrupted'
  exit 1
}

commit_candidate() {
  if ! consume_approval; then
    recoverable_fail 'candidate is commit-pending but approval consumption was interrupted'
  fi
  if ! write_record installed installed not_required 0; then
    recoverable_fail 'approval is consumed but installed record was interrupted'
  fi
  printf 'CYF_API_FLOW_INSTALL=PASS\n'
  exit 0
}

finalize_candidate() {
  [[ "$(canonical_sha)" == "$JAR_SHA" ]] || restore_and_start commit_canonical_mismatch
  lifecycle_healthy || restore_and_start commit_health_failed
  if ! write_record active_pending commit candidate_healthy "$STOP_RC"; then
    recoverable_fail 'candidate is healthy but active-pending record was interrupted'
  fi
  commit_candidate
}

# Recovery dispatch. Non-terminal transactions are bound to the exact ticket, source,
# numeric run, receipt bytes and JAR bytes. A mismatched package cannot adopt them.
TARGET_STATE="$(canonical_sha)"
[[ "$TARGET_STATE" != UNSAFE ]] || fail 'canonical target is unsafe'
if [[ "$RECORD_STATUS" == installed && "$RECORD_MATCH" == 1 ]]; then
  (( APPROVAL_CONSUMED == 1 )) || fail 'installed record has an unconsumed approval'
  [[ "$TARGET_STATE" == "$JAR_SHA" ]] || fail 'installed record does not match canonical JAR'
  lifecycle_healthy || fail 'installed record canonical JAR is not healthy'
  printf 'CYF_API_FLOW_INSTALL=PASS_ALREADY_INSTALLED\n'
  exit 0
fi
if [[ "$RECORD_STATUS" =~ ^(prepared|activating|active_pending|rolling_back)$ && "$RECORD_MATCH" != 1 ]]; then
  fail 'unfinished durable transaction belongs to another exact release'
fi
if (( RECORD_MATCH )); then
  case "$RECORD_STATUS" in
    rolling_back)
      restore_and_start rollback_recovery
      ;;
    active_pending)
      if [[ "$TARGET_STATE" == "$JAR_SHA" ]]; then
        lifecycle_healthy || recoverable_fail 'commit-pending candidate is not healthy'
        commit_candidate
      fi
      restore_and_start active_pending_recovery
      ;;
    activating)
      if [[ "$TARGET_STATE" == "$JAR_SHA" ]]; then
        # No durable active_pending commit intent exists. A crash in activating is
        # rollback-only, including a crash while persisting a later rollback decision.
        restore_and_start activating_candidate_recovery
      elif [[ "$TARGET_STATE" == MISSING ]]; then
        restore_and_start activating_canonical_missing
      elif [[ "$TARGET_STATE" != "$OLD_SHA" ]]; then
        fail 'activating transaction found unexpected canonical bytes'
      fi
      ;;
    prepared)
      if [[ "$TARGET_STATE" == "$JAR_SHA" || "$TARGET_STATE" == MISSING ]]; then
        restore_and_start prepared_inconsistent_canonical
      fi
      [[ "$TARGET_STATE" == "$OLD_SHA" ]] || fail 'prepared transaction found unexpected canonical bytes'
      ;;
    failed)
      if [[ "$TARGET_STATE" == MISSING || "$TARGET_STATE" == "$JAR_SHA" ]]; then
        restore_and_start failed_rollback_recovery
      fi
      [[ "$TARGET_STATE" == "$OLD_SHA" ]] || fail 'failed transaction found unexpected canonical bytes'
      fail 'this exact release already failed; a fresh exact ticket, artifact, approval, and release decision are required'
      ;;
  esac
elif (( APPROVAL_CONSUMED )); then
  fail 'consumed approval has no matching recoverable transaction'
else
  [[ "$TARGET_STATE" != MISSING ]] || fail 'new release requires an existing canonical JAR'
  OLD_SHA="$TARGET_STATE"
fi
OLD_JAR_BYTES="$(stat -Lc '%s' "$TARGET_JAR")"

# New/prepared attempt. The durable transaction record precedes backup creation and every
# lifecycle mutation. Backup publication and all JSON transitions fsync file and directory.
if [[ "$RECORD_STATUS" != prepared || "$RECORD_MATCH" != 1 ]]; then
  write_record prepared pre_cutover not_started 255 || recoverable_fail 'prepared record write was interrupted before lifecycle mutation'
fi
lifecycle_admission_before_backup || fail 'insufficient 5GiB lifecycle reserve plus rollback JAR before stopping service'
ensure_backup || fail 'durable rollback backup creation failed before stopping service'
lifecycle_admission_after_backup || fail 'insufficient 5GiB lifecycle reserve after rollback backup creation'
write_record activating activation ready 255 || recoverable_fail 'activation record write was interrupted before stopping service'

if ! stop_and_verify; then
  write_record failed pre_cutover_stop previous_stop_unverified "$STOP_RC" || recoverable_fail 'pre-cutover stop record was interrupted'
  fail 'previous service stop could not be explicitly verified'
fi
if (( STOP_RC != 0 )); then
  if "$LIFECYCLE" start && lifecycle_healthy; then
    write_record failed pre_cutover_stop previous_restarted_after_stop_error "$STOP_RC" || recoverable_fail 'stop-error recovery record was interrupted'
  else
    write_record failed pre_cutover_stop previous_restart_failed_after_stop_error "$STOP_RC" || recoverable_fail 'stop-error failure record was interrupted'
  fi
  fail 'previous service stop returned an error'
fi

if ! activate_candidate; then
  recoverable_fail 'canonical activation replace or fsync was interrupted'
fi
if ! "$LIFECYCLE" start; then
  restore_and_start candidate_start_failed
fi
if ! lifecycle_healthy; then
  restore_and_start candidate_status_failed
fi
finalize_candidate
