ensure_backup() {
  python3 -I -B - "$TARGET_JAR" "$BACKUP" "$OLD_SHA" "$INSTALL_UID" "$INSTALL_GID" <<'PY'
import hashlib, os, stat, sys, tempfile
from pathlib import Path
source, destination = map(Path, sys.argv[1:3])
expected = sys.argv[3]
uid, gid = map(int, sys.argv[4:6])

def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()

if destination.exists() or destination.is_symlink():
    info = os.lstat(destination)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_nlink != 1
            or stat.S_IMODE(info.st_mode) != 0o600 or digest(destination) != expected):
        raise SystemExit('existing backup is unsafe or incomplete')
    raise SystemExit(0)
info = os.lstat(source)
if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or digest(source) != expected:
    raise SystemExit('canonical source does not match previous digest')
fd, temporary = tempfile.mkstemp(prefix='.backup.', dir=str(destination.parent))
try:
    os.fchmod(fd, 0o600)
    os.fchown(fd, uid, gid)
    with source.open('rb') as src, os.fdopen(fd, 'wb') as out:
        while True:
            block = src.read(1024 * 1024)
            if not block:
                break
            out.write(block)
        out.flush()
        os.fsync(out.fileno())
    os.link(temporary, destination)
    directory_fd = os.open(str(destination.parent), os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
}

