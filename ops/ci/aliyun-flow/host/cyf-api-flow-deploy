def fail(message):
    raise SystemExit('cyf-api-flow-auto-approve: ' + message)


def digest_fileobj(handle):
    h = hashlib.sha256()
    for chunk in iter(lambda: handle.read(1024 * 1024), b''):
        h.update(chunk)
    return h.hexdigest()


def exact_dict(value, keys, label):
    if not isinstance(value, dict) or set(value) != set(keys):
        fail(label + ' schema is invalid')


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_write(path, data, mode=0o600):
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        os.fchmod(fd, mode)
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, path)
        fsync_dir(path.parent)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def safe_regular(path, uid=0, mode=None):
    try:
        s = path.lstat()
    except FileNotFoundError:
        fail(str(path) + ' is missing')
    if not stat.S_ISREG(s.st_mode) or s.st_uid != uid or s.st_nlink != 1:
        fail(str(path) + ' is not a root-owned single-link regular file')
    if mode is not None and stat.S_IMODE(s.st_mode) != mode:
        fail(str(path) + ' mode is unsafe')
    return s


def discard_verified_download_copy(downloaded, package, original_stat):
    """Keep the verified incoming copy and cloud artifact, not two local tarballs."""
    current = safe_regular(downloaded)
    signature = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns)
    if signature(current) != signature(original_stat):
        fail('download changed before duplicate cleanup')
    safe_regular(package, mode=0o600)
    with downloaded.open('rb') as source, package.open('rb') as copied:
        source_hash = digest_fileobj(source)
        if source_hash != digest_fileobj(copied):
            fail('download/incoming copy digest mismatch before cleanup')
    if signature(safe_regular(downloaded)) != signature(original_stat):
        fail('download changed during duplicate cleanup')
    downloaded.unlink()  # only this Run's validated redundant download, never rollback data
    fsync_dir(downloaded.parent)
    return {'bytes': current.st_size, 'sha256': source_hash}


class SchemaIntegrationError(Exception):
    def __init__(self, code, action):
        Exception.__init__(self, code)
        self.code = code
        self.action = action


def utc_timestamp():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%fZ')


def ensure_private_directory(path):
    path.mkdir(mode=0o700, parents=False, exist_ok=True)
    info = path.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0
            or stat.S_IMODE(info.st_mode) != 0o700):
        raise SchemaIntegrationError(
            'schema_result_directory_unsafe',
            'repair the root-owned 0700 schema result directory before a new Flow run')


