#!/usr/bin/python3
"""Deploy a successful develop Flow artifact without per-release human tickets.

Retains the existing transactional installer and same-run artifact validation.
"""
import fcntl
import grp
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path('/var/lib/cyf-api-flow')
PACKAGE = ROOT / 'incoming/package.tgz'
APPROVAL = ROOT / 'approval.json'
BACKUPS = ROOT / 'backups'
INSTALLER = '/usr/local/sbin/cyf-api-flow-install'
SCHEMA_RUNNER = Path('/usr/local/sbin/cyf-api-additive-schema')
SCHEMA_RESULTS = ROOT / 'schema-results'
RELEASE_LOCK = Path('/tmp/cyf-release-api.lock')
SCHEMA_SQL_SHA256 = '77ed9db141c9eedce5e357ebd562c02e060a6cdc238825ade1f60bc5c9dbe9cc'
SCHEMA_PASSWORD_ENV = 'CYF_F06_MYSQL_PASSWORD'
# v1 was inherited into the restored JVM; keep its inode untouched.
# The v2 parent owns this mutex for the entire installer lifetime.
LOCK = '/tmp/cyf-api-flow-auto-approval-v2.lock'
EXPECTED_ORG = '5fb7d76ee6f9d07f148529c7'
EXPECTED_PIPELINE = '5260799'
EXPECTED_JOB = 'cloud_ci.api_ci'
EXPECTED_MEMBERS = {
    'application.jar', 'application.metadata.json', 'application.sidecar.json',
    'dependency.provenance.json', 'receipt.json',
}
SHA256 = re.compile(r'^[0-9a-f]{64}$')
GIT_SHA = re.compile(r'^[0-9a-f]{40,64}$')
RUN_ID = re.compile(r'^[1-9][0-9]*$')
INSTALL_RECORD_KEYS = {
    'schema_version', 'status', 'phase', 'recovery', 'ticket_sha256',
    'source_commit_sha', 'source_tree_sha', 'run_id', 'receipt_sha256',
    'candidate_sha256', 'previous_sha256', 'backup', 'candidate_stop_rc', 'timestamp',
}
SCHEMA_REPORT_KEYS = {
    'schema_version', 'operation', 'status', 'transaction_model', 'lock_order',
    'tables', 'binding', 'candidate', 'error', 'failed_table',
}
SCHEMA_TABLES = {
    'agent_task_artifact_outcome', 'agent_task_artifact_outcome_decision',
}
_SCHEMA_CONTEXT = None


def fail(message):
    raise SystemExit('cyf-api-flow-auto-approve: ' + message)


def digest_fileobj(handle):
    h = hashlib.sha256()
    for chunk in iter(lambda: handle.read(1024 * 1024), b''):
        h.update(chunk)
    return h.hexdigest()


def exact_dict(value, keys, label):
    if not isinstance(value, dict) or set(value) != set(keys):
        fail(label + ' schema is invalid')


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_write(path, data, mode=0o600):
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        os.fchmod(fd, mode)
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, path)
        fsync_dir(path.parent)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def safe_regular(path, uid=0, mode=None):
    try:
        s = path.lstat()
    except FileNotFoundError:
        fail(str(path) + ' is missing')
    if not stat.S_ISREG(s.st_mode) or s.st_uid != uid or s.st_nlink != 1:
        fail(str(path) + ' is not a root-owned single-link regular file')
    if mode is not None and stat.S_IMODE(s.st_mode) != mode:
        fail(str(path) + ' mode is unsafe')
    return s


def discard_verified_download_copy(downloaded, package, original_stat):
    """Keep the verified incoming copy and cloud artifact, not two local tarballs."""
    current = safe_regular(downloaded)
    signature = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns)
    if signature(current) != signature(original_stat):
        fail('download changed before duplicate cleanup')
    safe_regular(package, mode=0o600)
    with downloaded.open('rb') as source, package.open('rb') as copied:
        source_hash = digest_fileobj(source)
        if source_hash != digest_fileobj(copied):
            fail('download/incoming copy digest mismatch before cleanup')
    if signature(safe_regular(downloaded)) != signature(original_stat):
        fail('download changed during duplicate cleanup')
    downloaded.unlink()  # only this Run's validated redundant download, never rollback data
    fsync_dir(downloaded.parent)
    return {'bytes': current.st_size, 'sha256': source_hash}


class SchemaIntegrationError(Exception):
    def __init__(self, code, action):
        Exception.__init__(self, code)
        self.code = code
        self.action = action


def utc_timestamp():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%fZ')


def ensure_private_directory(path):
    path.mkdir(mode=0o700, parents=False, exist_ok=True)
    info = path.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0
            or stat.S_IMODE(info.st_mode) != 0o700):
        raise SchemaIntegrationError(
            'schema_result_directory_unsafe',
            'repair the root-owned 0700 schema result directory before a new Flow run')


def schema_paths(run_id):
    stem = 'run-' + run_id
    return {
        'state': SCHEMA_RESULTS / (stem + '.json'),
        'stdout': SCHEMA_RESULTS / (stem + '.stdout'),
        'stderr': SCHEMA_RESULTS / (stem + '.stderr'),
    }


def schema_state(context, status, started_at, **updates):
    value = {
        'schema_version': 1,
        'feature': 'M4-F06-additive-schema',
        'status': status,
        'activation_claim': 'schema_only_not_feature_activation',
        'pipeline_id': context['pipeline_id'],
        'run_id': context['run_id'],
        'source_commit_sha': context['source_commit_sha'],
        'source_tree_sha': context['source_tree_sha'],
        'receipt_sha256': context['receipt_sha256'],
        'jar_sha256': context['jar_sha256'],
        'sql_sha256': SCHEMA_SQL_SHA256,
        'runner_path': str(SCHEMA_RUNNER),
        'started_at': started_at,
        'finished_at': None,
        'runner_exit_code': None,
        'error': None,
        'action': None,
        'prerequisites': [],
        'runner_report': None,
        'stdout_path': None,
        'stdout_sha256': None,
        'stderr_path': None,
        'stderr_sha256': None,
        'lock_order': [
            'flow_coordinator_lock', 'api_release_lock',
            'f06_runner_file_lock', 'f06_mysql_named_lock',
        ],
        'transaction_model': 'installed_record_then_mysql_ddl_autocommit_no_rollback_or_drop',
    }
    value.update(updates)
    return value


def validate_schema_state(value, context):
    expected = set(schema_state(context, 'running', 'x'))
    if not isinstance(value, dict) or set(value) != expected or value.get('schema_version') != 1:
        raise SchemaIntegrationError(
            'schema_result_state_invalid',
            'inspect the root-only schema result files; do not delete or rerun this release')
    for key in ('pipeline_id', 'run_id', 'source_commit_sha', 'source_tree_sha',
                'receipt_sha256', 'jar_sha256'):
        if value.get(key) != context[key]:
            raise SchemaIntegrationError(
                'schema_result_binding_mismatch',
                'preserve the mismatched evidence and use a new Flow run')
    if value.get('sql_sha256') != SCHEMA_SQL_SHA256:
        raise SchemaIntegrationError(
            'schema_result_sql_digest_mismatch',
            'preserve the result and reconcile the reviewed F06 SQL before a new Flow run')
    return value


def load_installed_record(path, context):
    info = safe_regular(path, mode=0o600)
    try:
        value = json.loads(path.read_text(encoding='utf-8'))
    except (OSError, UnicodeDecodeError, ValueError):
        raise SchemaIntegrationError(
            'installed_record_json_invalid',
            'repair the durable installer record without executing DDL, then use a new Flow run')
    if (not isinstance(value, dict) or set(value) != INSTALL_RECORD_KEYS
            or value.get('schema_version') != 2 or value.get('status') != 'installed'
            or value.get('phase') != 'installed' or value.get('recovery') != 'not_required'
            or value.get('candidate_stop_rc') != 0):
        raise SchemaIntegrationError(
            'same_run_installed_record_missing',
            'recover the exact installer transaction to installed before any schema apply')
    expected = {
        'run_id': context['run_id'],
        'source_commit_sha': context['source_commit_sha'],
        'source_tree_sha': context['source_tree_sha'],
        'receipt_sha256': context['receipt_sha256'],
        'candidate_sha256': context['jar_sha256'],
    }
    if any(value.get(key) != expected_value for key, expected_value in expected.items()):
        raise SchemaIntegrationError(
            'same_run_installed_record_mismatch',
            'do not apply schema for a different installed release; use its exact Flow run')
    # Recheck after reading so replacement races fail before the attempt is recorded.
    current = safe_regular(path, mode=0o600)
    signature = lambda item: (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns)
    if signature(info) != signature(current):
        raise SchemaIntegrationError(
            'installed_record_changed',
            'wait for the exact installed record to stabilize, then use a new Flow run')
    return value


def acquire_release_lock(path):
    try:
        isp_gid = grp.getgrnam('isp').gr_gid
    except KeyError:
        raise SchemaIntegrationError(
            'release_lock_group_missing',
            'restore the existing isp release-lock group before a new Flow run')
    info = safe_regular(path, mode=0o660)
    if info.st_gid != isp_gid:
        raise SchemaIntegrationError(
            'release_lock_metadata_unsafe',
            'restore /tmp/cyf-release-api.lock to root:isp 0660 before a new Flow run')
    fd = os.open(str(path), os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0))
    try:
        opened = os.fstat(fd)
        if opened.st_dev != info.st_dev or opened.st_ino != info.st_ino:
            raise SchemaIntegrationError(
                'release_lock_changed',
                'restore the canonical API release lock before a new Flow run')
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd
    except BaseException:
        os.close(fd)
        raise


def write_schema_state(path, value, create=False):
    data = (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode()
    if not create:
        atomic_write(path, data)
        return
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    fsync_dir(path.parent)


def existing_schema_result(paths, context):
    if not paths['state'].exists() and not paths['state'].is_symlink():
        return None
    safe_regular(paths['state'], mode=0o600)
    try:
        value = json.loads(paths['state'].read_text(encoding='utf-8'))
    except (OSError, UnicodeDecodeError, ValueError):
        raise SchemaIntegrationError(
            'schema_result_state_invalid',
            'inspect the root-only schema result files; do not delete or rerun this release')
    value = validate_schema_state(value, context)
    print(json.dumps({'f06_schema': 'existing_same_run_result', 'result': value},
                     sort_keys=True, separators=(',', ':')), flush=True)
    if value['status'] == 'pass':
        return 0
    return value['runner_exit_code'] if isinstance(value['runner_exit_code'], int) and 0 < value['runner_exit_code'] < 256 else 1


def validate_runner_report(data, return_code):
    try:
        text = data.decode('utf-8')
        value = json.loads(text)
    except (UnicodeDecodeError, ValueError):
        raise SchemaIntegrationError(
            'schema_runner_report_invalid',
            'inspect the preserved root-only stdout/stderr and verify durable table metadata before a new Flow run')
    if (not isinstance(value, dict) or not set(value).issubset(SCHEMA_REPORT_KEYS)
            or value.get('schema_version') != 1 or value.get('operation') != 'apply'
            or value.get('transaction_model') != 'mysql_ddl_autocommit_per_create_no_rollback_or_drop'
            or value.get('lock_order') != ['f06_runner_file_lock', 'f06_mysql_named_lock']
            or set(value.get('tables', {})) != SCHEMA_TABLES):
        raise SchemaIntegrationError(
            'schema_runner_report_contract_mismatch',
            'inspect the preserved root-only runner output; do not infer schema activation')
    for table in value['tables'].values():
        if (not isinstance(table, dict) or set(table) - {'status', 'mismatches'}
                or not isinstance(table.get('status'), str)
                or ('mismatches' in table and not isinstance(table['mismatches'], list))):
            raise SchemaIntegrationError(
                'schema_runner_report_contract_mismatch',
                'inspect the preserved root-only runner output; do not infer schema activation')
    if return_code == 0:
        success_states = {'created_equivalent', 'existing_equivalent'}
        if (value.get('status') != 'pass' or 'error' in value
                or any(table['status'] not in success_states
                       for table in value['tables'].values())):
            raise SchemaIntegrationError(
                'schema_runner_false_success',
                'verify both F06 tables from durable metadata before a new Flow run')
    elif value.get('status') != 'failed' or not isinstance(value.get('error'), str):
        raise SchemaIntegrationError(
            'schema_runner_failure_report_invalid',
            'inspect the preserved root-only stdout/stderr and verify partial DDL before a new Flow run')
    return value


def schema_prerequisites():
    missing = []
    if not SCHEMA_RUNNER.exists() and not SCHEMA_RUNNER.is_symlink():
        missing.append('schema_runner_not_installed')
    else:
        try:
            safe_regular(SCHEMA_RUNNER, mode=0o755)
        except SystemExit:
            missing.append('schema_runner_metadata_unsafe')
    password = os.environ.get(SCHEMA_PASSWORD_ENV)
    if not isinstance(password, str) or not password or '\n' in password or '\r' in password:
        missing.append('db_principal_or_protected_password_not_configured')
    return missing, password


def run_schema_once(context, paths):
    started_at = utc_timestamp()
    prerequisites, password = schema_prerequisites()
    if prerequisites:
        result = schema_state(
            context, 'blocked_precondition', started_at,
            finished_at=utc_timestamp(), error='schema_activation_prerequisites_missing',
            prerequisites=prerequisites,
            action=('install the reviewed runner as root:root 0755; provision fixed MySQL user '
                    'cyf_f06_schema_runner for jia with only required metadata/lock/CREATE grants; '
                    'inject protected CYF_F06_MYSQL_PASSWORD; then use a new Flow run'))
        write_schema_state(paths['state'], result, create=True)
        print(json.dumps({'f06_schema': 'blocked_precondition', 'result': result},
                         sort_keys=True, separators=(',', ':')), flush=True)
        return 1

    running = schema_state(
        context, 'running', started_at,
        action=('if this process is interrupted, inspect durable F06 table metadata and the '
                'preserved output files; never rerun this same Flow release automatically'),
        stdout_path=str(paths['stdout']), stderr_path=str(paths['stderr']))
    write_schema_state(paths['state'], running, create=True)
    stdout_fd = os.open(str(paths['stdout']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    stderr_fd = os.open(str(paths['stderr']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        child_env = {
            'PATH': '/usr/sbin:/usr/bin:/sbin:/bin',
            'LC_ALL': 'C',
            SCHEMA_PASSWORD_ENV: password,
        }
        try:
            completed = subprocess.run(
                [str(SCHEMA_RUNNER), '--apply'], env=child_env,
                stdout=stdout_fd, stderr=stderr_fd, close_fds=True)
            return_code = completed.returncode
        except OSError:
            return_code = 1
            integration_error = SchemaIntegrationError(
                'schema_runner_start_failed',
                'repair the installed runner and inspect durable schema state before a new Flow run')
        else:
            integration_error = None
        os.fsync(stdout_fd)
        os.fsync(stderr_fd)
    finally:
        os.close(stdout_fd)
        os.close(stderr_fd)
        fsync_dir(SCHEMA_RESULTS)

    stdout_bytes = paths['stdout'].read_bytes()
    stderr_bytes = paths['stderr'].read_bytes()
    report = None
    if integration_error is None:
        try:
            report = validate_runner_report(stdout_bytes, return_code)
        except SchemaIntegrationError as exc:
            integration_error = exc
    if integration_error is not None:
        status = 'failed'
        error = integration_error.code
        action = integration_error.action
    elif return_code == 0:
        status = 'pass'
        error = None
        action = 'schema is verified only; feature activation and authenticated acceptance remain separate'
    else:
        status = 'failed'
        error = report['error']
        action = ('inspect the preserved runner report/stdout/stderr and durable table metadata; '
                  'do not drop tables or rerun this same Flow release automatically')
    result = schema_state(
        context, status, started_at, finished_at=utc_timestamp(),
        runner_exit_code=return_code, error=error, action=action,
        runner_report=report, stdout_path=str(paths['stdout']),
        stdout_sha256=hashlib.sha256(stdout_bytes).hexdigest(),
        stderr_path=str(paths['stderr']),
        stderr_sha256=hashlib.sha256(stderr_bytes).hexdigest())
    write_schema_state(paths['state'], result)
    print(json.dumps({'f06_schema': status, 'result': result},
                     sort_keys=True, separators=(',', ':')), flush=True)
    return return_code if status == 'pass' or 0 < return_code < 256 else 1


def apply_schema_after_install(context):
    release_fd = acquire_release_lock(RELEASE_LOCK)
    try:
        ensure_private_directory(SCHEMA_RESULTS)
        paths = schema_paths(context['run_id'])
        existing = existing_schema_result(paths, context)
        if existing is not None:
            return existing
        try:
            load_installed_record(ROOT / 'record.json', context)
        except SchemaIntegrationError as exc:
            now = utc_timestamp()
            result = schema_state(
                context, 'failed', now, finished_at=utc_timestamp(),
                runner_exit_code=1, error=exc.code, action=exc.action)
            write_schema_state(paths['state'], result, create=True)
            print(json.dumps({'f06_schema': 'failed', 'result': result},
                             sort_keys=True, separators=(',', ':')), flush=True)
            return 1
        return run_schema_once(context, paths)
    finally:
        os.close(release_fd)


def invoke_installer(installer):
    # The coordinator stays alive holding its mutex. The installer owns the existing
    # release lock through installed-record fsync; after it exits we reacquire that
    # exact lock and keep it through the one-shot F06 schema runner.  The schema
    # password belongs only to that runner and must never enter installer/lifecycle
    # descendants (including the restored JVM).
    installer_env = dict(os.environ)
    installer_env.pop(SCHEMA_PASSWORD_ENV, None)
    return_code = subprocess.run([installer], env=installer_env, close_fds=True).returncode
    if return_code != 0 or _SCHEMA_CONTEXT is None:
        return return_code
    try:
        return apply_schema_after_install(_SCHEMA_CONTEXT)
    except SchemaIntegrationError as exc:
        print(json.dumps({
            'f06_schema': 'integration_blocked',
            'pipeline_id': _SCHEMA_CONTEXT['pipeline_id'],
            'run_id': _SCHEMA_CONTEXT['run_id'],
            'error': exc.code,
            'action': exc.action,
        }, sort_keys=True, separators=(',', ':')), flush=True)
        return 1


def main():
    if os.geteuid() != 0:
        fail('must run as root')
    if len(sys.argv) != 4:
        fail('expected pipeline id, run number, and source commit')
    pipeline_id, run_id, source_commit = sys.argv[1:]
    if pipeline_id != EXPECTED_PIPELINE or not RUN_ID.fullmatch(run_id):
        fail('Flow execution identity mismatch')
    if not GIT_SHA.fullmatch(source_commit):
        fail('Flow source commit is invalid')
    safe_regular(Path(__file__).resolve(), mode=0o755)
    safe_regular(Path(INSTALLER), mode=0o755)
    downloaded = ROOT / 'downloads' / run_id / 'package.tgz'
    for parent in (downloaded.parent, downloaded.parent.parent):
        st = parent.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            fail('download parent is unsafe')
    ps = safe_regular(downloaded)
    if ps.st_size <= 0:
        fail('incoming package size is invalid')
    if PACKAGE.parent.lstat().st_uid != 0 or stat.S_IMODE(PACKAGE.parent.lstat().st_mode) != 0o700:
        fail('incoming directory is unsafe')
    BACKUPS.mkdir(mode=0o700, parents=True, exist_ok=True)
    if BACKUPS.is_symlink() or BACKUPS.lstat().st_uid != 0 or stat.S_IMODE(BACKUPS.lstat().st_mode) != 0o700:
        fail('backup directory is unsafe')

    lock_fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    os.fchmod(lock_fd, 0o600)
    # Queue normal concurrent releases; keep the lock and stale-Run check, not a time quota.
    fcntl.flock(lock_fd, fcntl.LOCK_EX)

    os.set_inheritable(lock_fd, False)  # parent retains custody; never leak into the JVM

    record_path = ROOT / 'record.json'
    if record_path.exists():
        previous = json.loads(record_path.read_text())
        if int(previous.get('run_id', '0')) > int(run_id):
            fail('a newer run has already reached deployment; refusing stale release')

    # Run-scoped downloads cannot overwrite another run being installed.
    fd, temporary = tempfile.mkstemp(prefix='.incoming-' + run_id + '-', dir=PACKAGE.parent)
    try:
        with os.fdopen(fd, 'wb') as target, downloaded.open('rb') as src:
            shutil.copyfileobj(src, target, 1024 * 1024)
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, PACKAGE)
        fsync_dir(PACKAGE.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

    with tarfile.open(PACKAGE, mode='r:*') as archive:
        members = archive.getmembers()
        member_map = {}
        for member in members:
            raw = member.name
            if raw.startswith('/') or '..' in Path(raw).parts:
                fail('release package contains an unsafe path')
            normalized = raw[2:] if raw.startswith('./') else raw
            if normalized in ('', '.'):
                if not member.isdir():
                    fail('release package root entry is unsafe')
                continue
            if not member.isfile() or '/' in normalized or normalized in member_map:
                fail('release package contains an unsafe member')
            member_map[normalized] = member
        if set(member_map) != EXPECTED_MEMBERS:
            fail('release package member set is invalid')
        receipt_handle = archive.extractfile(member_map['receipt.json'])
        if receipt_handle is None:
            fail('receipt is unavailable')
        receipt_bytes = receipt_handle.read()
        try:
            receipt = json.loads(receipt_bytes.decode('utf-8'))
        except Exception:
            fail('receipt JSON is invalid')
        if not isinstance(receipt, dict):
            fail('receipt shape is invalid')
        flow, source, records = receipt.get('flow'), receipt.get('source'), receipt.get('files')
        if not isinstance(flow, dict) or not isinstance(source, dict) or not isinstance(records, list):
            fail('receipt release identity is invalid')
        identity_bytes = (json.dumps(dict(flow=flow, source=source), sort_keys=True, separators=(',', ':')) + '\n').encode()
        expected_identity = hashlib.sha256(identity_bytes).hexdigest()
        if (source.get('branch') != 'develop' or source.get('clean_before') is not True
                or source.get('clean_after') is not True):
            fail('receipt source is not a clean develop build')
        if (receipt.get('status') != 'success' or receipt.get('gradle_exit_code') != 0
                or receipt.get('bridge_exit_code') != 0 or receipt.get('ticket_sha256') != expected_identity):
            fail('receipt quality gate failed')
        if (flow.get('organization_id') != EXPECTED_ORG or flow.get('pipeline_id') != EXPECTED_PIPELINE
                or flow.get('run_id') != run_id or flow.get('job_id') != EXPECTED_JOB):
            fail('receipt Flow identity mismatch')
        if (source.get('commit_sha') != source_commit or flow.get('source_tip_sha') != source_commit
                or not GIT_SHA.fullmatch(str(source.get('tree_sha', '')))):
            fail('receipt source identity mismatch')
        by_kind = {}
        for record in records:
            if isinstance(record, dict) and record.get('kind') in ('application_jar', 'dependency_provenance'):
                kind = record['kind']
                if kind in by_kind:
                    fail('duplicate release file record')
                by_kind[kind] = record
        if set(by_kind) != {'application_jar', 'dependency_provenance'}:
            fail('release file records are incomplete')
        jar_record = by_kind['application_jar']
        if (not isinstance(jar_record.get('path'), str) or not jar_record['path']
                or Path(jar_record['path']).is_absolute() or '..' in Path(jar_record['path']).parts
                or not SHA256.fullmatch(str(jar_record.get('sha256', '')))
                or jar_record.get('size') != member_map['application.jar'].size):
            fail('application JAR record is invalid')
        jar_handle = archive.extractfile(member_map['application.jar'])
        if jar_handle is None or digest_fileobj(jar_handle) != jar_record['sha256']:
            fail('application JAR digest mismatch')

    approval = {
        'schema_version': 2,
        'ticket_sha256': expected_identity,
        'source_commit_sha': source['commit_sha'],
        'source_tree_sha': source['tree_sha'],
        'run_id': run_id,
        'receipt_sha256': hashlib.sha256(receipt_bytes).hexdigest(),
        'jar_sha256': jar_record['sha256'],
        'consumed': False,
    }
    if APPROVAL.exists() or APPROVAL.is_symlink():
        safe_regular(APPROVAL, mode=0o600)
        stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
        backup = BACKUPS / ('approval-before-auto-run-' + run_id + '-' + stamp + '.json')
        fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with APPROVAL.open('rb') as src:
                old = src.read()
            os.write(fd, old)
            os.fsync(fd)
        finally:
            os.close(fd)
        fsync_dir(BACKUPS)
    data = (json.dumps(approval, sort_keys=True, separators=(',', ':')) + '\n').encode('utf-8')
    atomic_write(APPROVAL, data)
    reclaimed = discard_verified_download_copy(downloaded, PACKAGE, ps)
    print(json.dumps({'auto_approval': 'prepared', 'pipeline': pipeline_id, 'run': run_id,
                      'source_commit': source_commit, 'jar_sha256': approval['jar_sha256'],
                      'receipt_sha256': approval['receipt_sha256'],
                      'redundant_download_reclaimed': reclaimed}, sort_keys=True), flush=True)
    global _SCHEMA_CONTEXT
    _SCHEMA_CONTEXT = {
        'pipeline_id': pipeline_id,
        'run_id': run_id,
        'source_commit_sha': source_commit,
        'source_tree_sha': source['tree_sha'],
        'receipt_sha256': approval['receipt_sha256'],
        'jar_sha256': approval['jar_sha256'],
    }
    raise SystemExit(invoke_installer(INSTALLER))


