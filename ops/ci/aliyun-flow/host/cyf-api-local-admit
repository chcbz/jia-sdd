#!/usr/bin/python3 -I
"""Fixed root batch admission wrapper. No build/install/service/Flow invocation."""
import argparse
import json
import os
from pathlib import Path
import stat
import sys

SELF = '/usr/local/sbin/cyf-api-local-admit'
HELPER = '/usr/local/libexec/cyf-api-local/admit-api-local.py'
TRUSTED_ROOT = '/var/lib/cyf-api-local-admission'
AUTHORITY_ROOT = '/var/lib/cyf-api-local-authority'
OPTIONS = ('trusted-record', 'trusted-record-sha256', 'batch-authority', 'batch-authority-sha256', 'package', 'output')


class Refused(Exception):
    def __init__(self, code):
        self.code = code


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Refused('INPUT_INVALID')


def protected_file(value):
    """Descriptor walk, physical root ancestry and root single-link helper."""
    path = Path(value)
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for part in ('',) + path.parts[1:-1]:
            if part:
                new = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
                os.close(fd)
                fd = new
            s = os.fstat(fd)
            if s.st_uid != 0 or s.st_gid != 0 or s.st_mode & 0o022:
                raise Refused('PATH_UNSAFE')
        leaf = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=fd)
        s = os.fstat(leaf)
        if (not stat.S_ISREG(s.st_mode) or s.st_uid != 0 or s.st_gid != 0 or
                s.st_nlink != 1 or s.st_mode & 0o022):
            os.close(leaf)
            raise Refused('PATH_UNSAFE')
        return leaf
    finally:
        os.close(fd)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        if argv == ['--describe']:
            print(json.dumps({'format': 'cyf-api-local-admission-wrapper-v1', 'scope': 'artifact-admission-only',
                'trustedRoot': TRUSTED_ROOT, 'authorityRoot': AUTHORITY_ROOT, 'helper': HELPER,
                'productionAuthorized': False}, sort_keys=True))
            return 0
        parser = Parser(add_help=False, allow_abbrev=False)
        parser.add_argument('--opt-in', action='store_true', required=True)
        for name in OPTIONS:
            parser.add_argument('--' + name, required=True)
        flags = [v.split('=')[0] for v in argv if v.startswith('--')]
        if len(flags) != 7 or len(set(flags)) != 7:
            raise Refused('INPUT_INVALID')
        args = parser.parse_args(argv)
        if os.geteuid() != 0:
            raise Refused('ROOT_REQUIRED')
        if any(os.environ.get(k) for k in ('PIPELINE_ID', 'BUILD_NUMBER', 'CYF_FLOW_GRADLE_ACTIVE')):
            raise Refused('INPUT_INVALID')
        if os.path.abspath(__file__) != SELF:
            raise Refused('PATH_UNSAFE')
        self_fd = protected_file(SELF)
        os.close(self_fd)
        # Fixed interpreter may be a distro symlink; its real file/ancestry must
        # still be root protected. Never use an env/PATH-selected interpreter.
        python_fd = protected_file(os.path.realpath('/usr/bin/python3'))
        os.close(python_fd)
        helper_fd = protected_file(HELPER)
        try:
            os.set_inheritable(helper_fd, True)
            command = ['/usr/bin/python3', '-I', '-B', '/proc/self/fd/%d' % helper_fd,
                       '--opt-in', '--trusted-root', TRUSTED_ROOT, '--authority-root', AUTHORITY_ROOT]
            for name in OPTIONS:
                command += ['--' + name, getattr(args, name.replace('-', '_'))]
            # Execute the opened protected helper, not a replaced pathname or repo script.
            os.execve('/usr/bin/python3', command, {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'})
        finally:
            os.close(helper_fd)
    except Refused as exc:
        code = exc.code
    except OSError:
        code = 'IO_FAILURE'
    print(json.dumps({'format': 'cyf-api-local-admission-result-v1', 'status': 'rejected', 'code': code}, sort_keys=True))
    return 1


if __name__ == '__main__':
    raise SystemExit(main())
