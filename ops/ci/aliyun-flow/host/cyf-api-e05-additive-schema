def decode_hex(value):
    try:
        return bytes.fromhex(value).decode('utf-8')
    except (ValueError, UnicodeDecodeError):
        raise SchemaError('metadata_encoding_invalid')


def decode_optional(value):
    if value == '-':
        return None
    if not value.startswith('+'):
        raise SchemaError('metadata_encoding_invalid')
    return decode_hex(value[1:])


def file_signature(info):
    return (info.st_dev, info.st_ino, info.st_size, getattr(info, 'st_mtime_ns', int(info.st_mtime * 1000000000)))


def safe_regular(path, uid, mode):
    try:
        info = os.lstat(str(path))
    except OSError:
        raise SchemaError('required_file_missing')
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_nlink != 1
            or stat.S_IMODE(info.st_mode) != mode):
        raise SchemaError('required_file_metadata_unsafe')
    return info


def read_stable(path, uid, mode):
    before = safe_regular(path, uid, mode)
    flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)
    fd = os.open(str(path), flags)
    try:
        opened = os.fstat(fd)
        if file_signature(opened) != file_signature(before):
            raise SchemaError('required_file_changed')
        with os.fdopen(fd, 'rb', closefd=False) as stream:
            value = stream.read()
        after = os.fstat(fd)
    finally:
        os.close(fd)
    current = safe_regular(path, uid, mode)
    if file_signature(before) != file_signature(after) or file_signature(after) != file_signature(current):
        raise SchemaError('required_file_changed')
    return value, file_signature(current)


def digest_stream(stream):
    digest = hashlib.sha256()
    for block in iter(lambda: stream.read(1024 * 1024), b''):
        digest.update(block)
    return digest.hexdigest()


def load_package(path, uid, mode):
    before = safe_regular(path, uid, mode)
    flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)
    fd = os.open(str(path), flags)
    receipt_bytes = None
    jar_digest = None
    jar_size = None
    provenance_digest = None
    provenance_size = None
    try:
        opened = os.fstat(fd)
        if file_signature(opened) != file_signature(before):
            raise SchemaError('package_changed')
        with os.fdopen(fd, 'rb', closefd=False) as raw:
            try:
                with tarfile.open(fileobj=raw, mode='r:*') as archive:
                    members = {}
                    root_directory_seen = False
                    for member in archive.getmembers():
                        raw_name = member.name
                        # Flow ArtifactUpload includes one empty archive-root directory.
                        # It is metadata, not a sixth payload member or an extraction path.
                        if raw_name in ('.', './'):
                            if root_directory_seen or not member.isdir() or member.size != 0:
                                raise SchemaError('package_member_invalid')
                            root_directory_seen = True
                            continue
                        normalized = raw_name[2:] if raw_name.startswith('./') else raw_name
                        if (not normalized or normalized.startswith('/') or '..' in Path(normalized).parts
                                or '/' in normalized or normalized in members or not member.isfile()):
                            raise SchemaError('package_member_invalid')
                        members[normalized] = member
                    if frozenset(members) != EXPECTED_PACKAGE_MEMBERS:
                        raise SchemaError('package_member_set_invalid')
                    receipt_handle = archive.extractfile(members['receipt.json'])
                    jar_handle = archive.extractfile(members['application.jar'])
                    provenance_handle = archive.extractfile(members['dependency.provenance.json'])
                    if receipt_handle is None or jar_handle is None or provenance_handle is None:
                        raise SchemaError('package_member_unavailable')
                    receipt_bytes = receipt_handle.read()
                    jar_digest = digest_stream(jar_handle)
                    jar_size = members['application.jar'].size
                    provenance_digest = digest_stream(provenance_handle)
                    provenance_size = members['dependency.provenance.json'].size
            except (tarfile.TarError, OSError):
                raise SchemaError('package_archive_invalid')
        after = os.fstat(fd)
    finally:
        os.close(fd)
    current = safe_regular(path, uid, mode)
    if file_signature(before) != file_signature(after) or file_signature(after) != file_signature(current):
        raise SchemaError('package_changed')
    return (receipt_bytes, jar_digest, jar_size, provenance_digest,
            provenance_size, file_signature(current))


def inspect_canonical_jar(path, uid, mode):
    before = safe_regular(path, uid, mode)
    flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)
    fd = os.open(str(path), flags)
    digest = hashlib.sha256()
    resource = None
    try:
        opened = os.fstat(fd)
        if file_signature(opened) != file_signature(before):
            raise SchemaError('canonical_jar_changed')
        with os.fdopen(fd, 'rb', closefd=False) as raw:
            for block in iter(lambda: raw.read(1024 * 1024), b''):
                digest.update(block)
            raw.seek(0)
            try:
                with zipfile.ZipFile(raw) as boot:
                    names = boot.namelist()
                    if names.count(NESTED_MAPPER_JAR) != 1:
                        raise SchemaError('mapper_jar_location_invalid')
                    nested_bytes = boot.read(NESTED_MAPPER_JAR)
                with zipfile.ZipFile(io.BytesIO(nested_bytes)) as nested:
                    nested_names = nested.namelist()
                    if nested_names.count(RESOURCE_PATH) != 1:
                        raise SchemaError('e05_resource_location_invalid')
                    resource = nested.read(RESOURCE_PATH)
            except zipfile.BadZipFile:
                raise SchemaError('canonical_jar_archive_invalid')
        after = os.fstat(fd)
    finally:
        os.close(fd)
    current = safe_regular(path, uid, mode)
    if file_signature(before) != file_signature(after) or file_signature(after) != file_signature(current):
        raise SchemaError('canonical_jar_changed')
    if resource != E05_SQL_BYTES or sha256_bytes(resource) != RESOURCE_SHA256:
        raise SchemaError('e05_resource_digest_mismatch')
    return digest.hexdigest(), file_signature(current)


def exact_keys(value, keys, code):
    if not isinstance(value, dict) or set(value) != set(keys):
        raise SchemaError(code)


def verify_release_binding(paths, uid, modes):
    record_bytes, record_signature = read_stable(paths['record'], uid, modes['record'])
    try:
        record = json.loads(record_bytes.decode('utf-8'))
    except (ValueError, UnicodeDecodeError):
        raise SchemaError('record_json_invalid')
    record_keys = {
        'schema_version', 'status', 'phase', 'recovery', 'ticket_sha256',
        'source_commit_sha', 'source_tree_sha', 'run_id', 'receipt_sha256',
        'candidate_sha256', 'previous_sha256', 'backup', 'candidate_stop_rc', 'timestamp',
    }
    exact_keys(record, record_keys, 'record_schema_invalid')
    if (record.get('schema_version') != 2 or record.get('status') != 'installed'
            or record.get('phase') != 'installed' or record.get('recovery') != 'not_required'
            or record.get('candidate_stop_rc') != 0
            or not SHA256_RE.fullmatch(str(record.get('ticket_sha256', '')))
            or not SHA256_RE.fullmatch(str(record.get('receipt_sha256', '')))
            or not SHA256_RE.fullmatch(str(record.get('candidate_sha256', '')))
            or not GIT_RE.fullmatch(str(record.get('source_commit_sha', '')))
            or not GIT_RE.fullmatch(str(record.get('source_tree_sha', '')))
            or not RUN_RE.fullmatch(str(record.get('run_id', '')))):
        raise SchemaError('record_not_installed_exact_release')

    (receipt_bytes, package_jar_digest, package_jar_size, package_provenance_digest,
     package_provenance_size, package_signature) = load_package(
        paths['package'], uid, modes['package'])
    if sha256_bytes(receipt_bytes) != record['receipt_sha256']:
        raise SchemaError('record_receipt_digest_mismatch')
    try:
        receipt = json.loads(receipt_bytes.decode('utf-8'))
    except (ValueError, UnicodeDecodeError):
        raise SchemaError('receipt_json_invalid')
    exact_keys(receipt, {
        'schema_version', 'status', 'gradle_exit_code', 'bridge_exit_code',
        'ticket_sha256', 'flow', 'source', 'files',
    }, 'receipt_schema_invalid')
    flow = receipt.get('flow')
    source = receipt.get('source')
    exact_keys(flow, {'organization_id', 'pipeline_id', 'job_id', 'run_id', 'source_tip_sha'},
               'receipt_flow_schema_invalid')
    exact_keys(source, {'branch', 'commit_sha', 'tree_sha', 'clean_before', 'clean_after'},
               'receipt_source_schema_invalid')
    if (receipt.get('schema_version') != 1 or receipt.get('status') != 'success'
            or receipt.get('gradle_exit_code') != 0 or receipt.get('bridge_exit_code') != 0
            or flow != {
                'organization_id': EXPECTED_ORG,
                'pipeline_id': EXPECTED_PIPELINE,
                'job_id': EXPECTED_JOB,
                'run_id': record['run_id'],
                'source_tip_sha': record['source_commit_sha'],
            }
            or source != {
                'branch': 'develop',
                'commit_sha': record['source_commit_sha'],
                'tree_sha': record['source_tree_sha'],
                'clean_before': True,
                'clean_after': True,
            }):
        raise SchemaError('receipt_release_identity_mismatch')
    identity = sha256_bytes((json.dumps({'flow': flow, 'source': source}, sort_keys=True,
                                        separators=(',', ':')) + '\n').encode('utf-8'))
    if receipt.get('ticket_sha256') != identity or record['ticket_sha256'] != identity:
        raise SchemaError('release_identity_digest_mismatch')
    files = receipt.get('files')
    if not isinstance(files, list) or len(files) != 2:
        raise SchemaError('receipt_files_invalid')
    by_kind = {}
    for item in files:
        if (not isinstance(item, dict)
                or item.get('kind') not in ('application_jar', 'dependency_provenance')
                or item['kind'] in by_kind):
            raise SchemaError('receipt_files_invalid')
        exact_keys(item, {'kind', 'path', 'sha256', 'size'}, 'receipt_files_invalid')
        by_kind[item['kind']] = item
    if set(by_kind) != {'application_jar', 'dependency_provenance'}:
        raise SchemaError('receipt_files_invalid')
    jar_record = by_kind['application_jar']
    provenance_record = by_kind['dependency_provenance']
    if (jar_record.get('path') != 'application.jar'
            or jar_record.get('sha256') != package_jar_digest
            or jar_record.get('size') != package_jar_size
            or not SHA256_RE.fullmatch(str(jar_record.get('sha256', '')))):
        raise SchemaError('receipt_jar_record_mismatch')
    if (provenance_record.get('path') != 'dependency.provenance.json'
            or provenance_record.get('sha256') != package_provenance_digest
            or provenance_record.get('size') != package_provenance_size
            or not SHA256_RE.fullmatch(str(provenance_record.get('sha256', '')))):
        raise SchemaError('receipt_provenance_record_mismatch')

    canonical_digest, canonical_signature = inspect_canonical_jar(
        paths['jar'], uid, modes['jar'])
    if canonical_digest != package_jar_digest or canonical_digest != record['candidate_sha256']:
        raise SchemaError('canonical_release_binding_mismatch')
    return {
        'source_commit': source['commit_sha'],
        'source_tree': source['tree_sha'],
        'run': flow['run_id'],
        'jar_sha256': canonical_digest,
        'receipt_sha256': record['receipt_sha256'],
        'resource_sha256': RESOURCE_SHA256,
        'signatures': {
            'jar': canonical_signature,
            'package': package_signature,
            'record': record_signature,
        },
        'record_bytes_sha256': sha256_bytes(record_bytes),
    }


def assert_binding_paths_unchanged(paths, uid, modes, binding, full_digest=False):
    for name in ('jar', 'package', 'record'):
        current = safe_regular(paths[name], uid, modes[name])
        if file_signature(current) != binding['signatures'][name]:
            raise SchemaError('release_binding_changed_before_ddl')
    record_bytes, _ = read_stable(paths['record'], uid, modes['record'])
    if sha256_bytes(record_bytes) != binding['record_bytes_sha256']:
        raise SchemaError('release_binding_changed_before_ddl')
    if full_digest:
        jar_digest, signature = inspect_canonical_jar(paths['jar'], uid, modes['jar'])
        if jar_digest != binding['jar_sha256'] or signature != binding['signatures']['jar']:
            raise SchemaError('release_binding_changed_before_ddl')


def split_exact_statements(resource):
    if resource != E05_SQL_BYTES or sha256_bytes(resource) != RESOURCE_SHA256:
        raise SchemaError('e05_resource_digest_mismatch')
    text = resource.decode('utf-8')
    text = re.sub(r'(?m)^--[^\n]*(?:\n|$)', '', text)
    parts = []
    start = 0
    quoted = False
    position = 0
    while position < len(text):
        character = text[position]
        if character == "'":
            if quoted and position + 1 < len(text) and text[position + 1] == "'":
                position += 2
                continue
            quoted = not quoted
        elif character == ';' and not quoted:
            part = text[start:position].strip()
            if part:
                parts.append(part)
            start = position + 1
        position += 1
    if quoted or text[start:].strip() or len(parts) != len(TABLE_ORDER):
        raise SchemaError('e05_statement_catalog_invalid')
    statements = {}
    for part in parts:
        match = re.match(r'^CREATE\s+TABLE\s+IF\s+NOT\s+EXISTS\s+([a-z0-9_]+)\s*\(',
                         part, re.I)
        if not match or match.group(1).lower() not in TABLE_ORDER:
            raise SchemaError('e05_statement_catalog_invalid')
        table = match.group(1).lower()
        if table in statements:
            raise SchemaError('e05_statement_catalog_invalid')
        statements[table] = re.sub(r'\s+', ' ', part).strip() + ';'
    if tuple(table for table in TABLE_ORDER if table in statements) != TABLE_ORDER:
        raise SchemaError('e05_statement_catalog_invalid')
    return statements


TOKEN_RE = re.compile(
    r"\s*(>=|<>|<|>|=|\+|\(|\)|,|'(?:''|\\.|[^'])*'|[A-Za-z_][A-Za-z0-9_]*|[0-9]+)")


def check_tokens(text):
    text = text.replace('`', '')
    text = re.sub(r"_[A-Za-z0-9]+(?=')", '', text)
    values = []
    position = 0
    while position < len(text):
        match = TOKEN_RE.match(text, position)
        if not match:
            if text[position:].strip():
                raise SchemaError('check_clause_unparseable')
            break
        values.append(match.group(1))
        position = match.end()
    return values


class CheckParser(object):
    def __init__(self, text):
        self.tokens = check_tokens(text)
        self.at = 0

    def peek(self):
        return self.tokens[self.at] if self.at < len(self.tokens) else None

    def take(self, value=None):
        token = self.peek()
        if token is None or (value is not None and token.upper() != value):
            raise SchemaError('check_clause_unparseable')
        self.at += 1
        return token

    def parse(self):
        value = self.parse_or()
        if self.peek() is not None:
            raise SchemaError('check_clause_unparseable')
        return value

    def parse_or(self):
        values = [self.parse_and()]
        while self.peek() is not None and self.peek().upper() == 'OR':
            self.take('OR')
            values.append(self.parse_and())
        return values[0] if len(values) == 1 else ('or', tuple(values))

    def parse_and(self):
        values = [self.parse_predicate()]
        while self.peek() is not None and self.peek().upper() == 'AND':
            self.take('AND')
            values.append(self.parse_predicate())
        return values[0] if len(values) == 1 else ('and', tuple(values))

    def parse_predicate(self):
        if self.peek() == '(':
            self.take('(')
            value = self.parse_or()
            self.take(')')
            return value
        left = self.parse_value()
        token = self.peek()
        if token is None:
            raise SchemaError('check_clause_unparseable')
        upper = token.upper()
        if upper == 'IN':
            self.take('IN')
            self.take('(')
            values = [self.parse_value()]
            while self.peek() == ',':
                self.take(',')
                values.append(self.parse_value())
            self.take(')')
            return ('in', left, tuple(values))
        if upper == 'IS':
            self.take('IS')
            negated = False
            if self.peek() is not None and self.peek().upper() == 'NOT':
                self.take('NOT')
                negated = True
            self.take('NULL')
            return ('is_not_null' if negated else 'is_null', left)
        if token in ('>=', '<>', '<', '>', '='):
            self.take()
            return (token, left, self.parse_value())
        raise SchemaError('check_clause_unparseable')

    def parse_value(self):
        value = self.parse_atom()
        while self.peek() == '+':
            self.take('+')
            value = ('+', value, self.parse_atom())
        return value

    def parse_atom(self):
        token = self.take()
        if token == '(':
            value = self.parse_value()
            self.take(')')
            return value
        if token.startswith("'"):
            return ('string', token[1:-1].replace("''", "'"))
        if token.isdigit():
            return ('number', int(token))
        name = token.lower()
        if self.peek() == '(':
            self.take('(')
            argument = self.parse_value()
            self.take(')')
            return ('function', name, argument)
        return ('identifier', name)


def normalized_check(text):
    return CheckParser(text).parse()


def parse_metadata(rows):
    result = {
        'schema_charset': None,
        'schema_collation': None,
        'tables': {},
        'columns': {name: [] for name in TABLE_ORDER},
        'indexes': {name: {} for name in TABLE_ORDER},
        'constraints': {name: {} for name in TABLE_ORDER},
        'checks': {name: {} for name in TABLE_ORDER},
    }
    schema_rows = rows['SCHEMA']
    if len(schema_rows) != 1 or len(schema_rows[0]) != 2:
        raise SchemaError('schema_identity_invalid')
    result['schema_charset'] = decode_hex(schema_rows[0][0]).lower()
    result['schema_collation'] = decode_hex(schema_rows[0][1]).lower()
    for row in rows['TABLES']:
        if len(row) != 3:
            raise SchemaError('table_metadata_invalid')
        table = decode_hex(row[0]).lower()
        if table not in TABLE_ORDER or table in result['tables']:
            raise SchemaError('table_metadata_invalid')
        result['tables'][table] = (decode_hex(row[1]).lower(), decode_hex(row[2]).lower())
    for row in rows['COLUMNS']:
        if len(row) != 9:
            raise SchemaError('column_metadata_invalid')
        table = decode_hex(row[0]).lower()
        if table not in TABLE_ORDER:
            raise SchemaError('column_metadata_invalid')
        try:
            ordinal = int(row[1])
        except ValueError:
            raise SchemaError('column_metadata_invalid')
        result['columns'][table].append((
            ordinal, decode_hex(row[2]).lower(), decode_hex(row[3]).lower(),
            decode_hex(row[4]).upper(), decode_optional(row[5]), decode_hex(row[6]).lower(),
            decode_optional(row[7]), decode_optional(row[8]),
        ))
    for row in rows['STATISTICS']:
        if len(row) != 9:
            raise SchemaError('index_metadata_invalid')
        table = decode_hex(row[0]).lower()
        if table not in TABLE_ORDER:
            raise SchemaError('index_metadata_invalid')
        name = decode_hex(row[1])
        try:
            non_unique, sequence = int(row[2]), int(row[3])
        except ValueError:
            raise SchemaError('index_metadata_invalid')
        result['indexes'][table].setdefault(name, []).append((
            non_unique, sequence, decode_hex(row[4]).lower(), decode_optional(row[5]),
            decode_hex(row[6]).upper(), decode_hex(row[7]).upper(), decode_hex(row[8]).upper(),
        ))
    for row in rows['CONSTRAINTS']:
        if len(row) != 4:
            raise SchemaError('constraint_metadata_invalid')
        table = decode_hex(row[0]).lower()
        if table not in TABLE_ORDER:
            raise SchemaError('constraint_metadata_invalid')
        name = decode_hex(row[1])
        if name in result['constraints'][table]:
            raise SchemaError('constraint_metadata_invalid')
        result['constraints'][table][name] = (decode_hex(row[2]).upper(), decode_hex(row[3]).upper())
    for row in rows['CHECKS']:
        if len(row) != 3:
            raise SchemaError('check_metadata_invalid')
        table = decode_hex(row[0]).lower()
        if table not in TABLE_ORDER:
            raise SchemaError('check_metadata_invalid')
        name = decode_hex(row[1])
        if name in result['checks'][table]:
            raise SchemaError('check_metadata_invalid')
        result['checks'][table][name] = decode_hex(row[2])
    return result


def compare_table(metadata, table):
    if table not in metadata['tables']:
        stray = (metadata['columns'][table] or metadata['indexes'][table]
                 or metadata['constraints'][table] or metadata['checks'][table])
        return ('drift', ['absent_table_has_metadata']) if stray else ('absent', [])
    mismatches = []
    engine, collation = metadata['tables'][table]
    if engine != 'innodb':
        mismatches.append('engine')
    if metadata['schema_charset'] != 'utf8mb4':
        mismatches.append('schema_charset')
    if collation != metadata['schema_collation']:
        mismatches.append('table_collation')
    expected = EXPECTED_TABLES[table]
    actual_columns = []
    for ordinal, name, sql_type, nullable, default, extra, charset, column_collation in metadata['columns'][table]:
        actual_columns.append((name, sql_type, nullable, default, extra))
        expected_ordinal = len(actual_columns)
        if ordinal != expected_ordinal:
            mismatches.append('column_ordinal')
        string_type = sql_type.startswith('varchar(') or sql_type.startswith('char(')
        if string_type:
            if charset is None or charset.lower() != 'utf8mb4':
                mismatches.append('column_charset')
            if column_collation is None or column_collation.lower() != collation:
                mismatches.append('column_collation')
        elif charset is not None or column_collation is not None:
            mismatches.append('non_string_collation')
    if tuple(actual_columns) != expected['columns']:
        mismatches.append('columns')

    actual_indexes = []
    for name, entries in metadata['indexes'][table].items():
        entries = sorted(entries, key=lambda value: value[1])
        first_non_unique = entries[0][0] if entries else None
        columns = []
        for non_unique, sequence, column_name, sub_part, index_type, direction, visible in entries:
            if (non_unique != first_non_unique or sequence != len(columns) + 1 or sub_part is not None
                    or index_type != 'BTREE' or direction != 'A' or visible != 'YES'):
                mismatches.append('index_attributes')
            columns.append(column_name)
        actual_indexes.append((name, first_non_unique, tuple(columns),
                               entries[0][4] if entries else None))
    expected_indexes = sorted(expected['indexes'], key=lambda value: value[0])
    if sorted(actual_indexes, key=lambda value: value[0]) != expected_indexes:
        mismatches.append('indexes')

    expected_constraints = {}
    for name in expected['unique_constraints']:
        expected_constraints[name] = ('PRIMARY KEY' if name == 'PRIMARY' else 'UNIQUE', 'YES')
    for name in expected['checks']:
        expected_constraints[name] = ('CHECK', 'YES')
    if metadata['constraints'][table] != expected_constraints:
        mismatches.append('constraints')
    if set(metadata['checks'][table]) != set(expected['checks']):
        mismatches.append('checks')
    else:
        for name, clause in expected['checks'].items():
            try:
                if normalized_check(metadata['checks'][table][name]) != normalized_check(clause):
                    mismatches.append('check_clause:' + name)
            except SchemaError:
                mismatches.append('check_clause:' + name)
    return ('equivalent', sorted(set(mismatches))) if not mismatches else ('drift', sorted(set(mismatches)))


class MysqlSession(object):
    def __init__(self, mysql_path, socket_path, password):
        args = [
            str(mysql_path), '--protocol=SOCKET', '--socket=' + socket_path,
            '--user=' + MYSQL_USER, '--database=' + MYSQL_SCHEMA,
            '--batch', '--raw', '--skip-column-names', '--unbuffered', '--force',
            '--default-character-set=utf8mb4',
        ]
        child_env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C', 'MYSQL_PWD': password}
        self.stderr = tempfile.TemporaryFile(mode='w+b')
        try:
            self.process = subprocess.Popen(
                args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=self.stderr,
                universal_newlines=True, env=child_env, close_fds=True,
            )
        except OSError:
            self.stderr.close()
            raise SchemaError('mysql_client_start_failed')
        self.counter = 0
        self.released = False

    def stderr_size(self):
        return os.fstat(self.stderr.fileno()).st_size

    def command(self, sql):
        if self.process.poll() is not None:
            raise SchemaError('mysql_session_ended')
        self.counter += 1
        marker = '_CYF_E05_%04d_END_' % self.counter
        before_error = self.stderr_size()
        try:
            self.process.stdin.write(sql.rstrip(';\n') + ';\n')
            self.process.stdin.write("SELECT '%s';\n" % marker)
            self.process.stdin.flush()
        except (IOError, OSError):
            raise SchemaError('mysql_session_write_failed')
        rows = []
        while True:
            line = self.process.stdout.readline()
            if line == '':
                raise SchemaError('mysql_session_ended')
            line = line.rstrip('\r\n')
            if line == marker:
                break
            rows.append(line.split('\t'))
        return rows, self.stderr_size() != before_error

    def acquire(self):
        rows, errored = self.command("SELECT GET_LOCK('%s',-1)" % DB_LOCK)
        if errored or rows != [['1']]:
            raise SchemaError('database_lock_acquire_failed')

    def release(self):
        rows, errored = self.command("SELECT RELEASE_LOCK('%s')" % DB_LOCK)
        if errored or rows != [['1']]:
            raise SchemaError('database_lock_release_failed')
        self.released = True

    def close(self):
        if not self.released and self.process.poll() is None:
            try:
                self.command("SELECT RELEASE_LOCK('%s')" % DB_LOCK)
            except SchemaError:
                pass
        try:
            self.process.stdin.close()
        except (IOError, OSError):
            pass
        return_code = self.process.wait()
        had_stderr = self.stderr_size() != 0
        self.stderr.close()
        if return_code != 0 or had_stderr:
            raise SchemaError('mysql_backend_reported_error')


def introspect(session):
    rows = {}
    for name in ('SCHEMA', 'TABLES', 'COLUMNS', 'STATISTICS', 'CONSTRAINTS', 'CHECKS'):
        result, errored = session.command(QUERY_SQL[name])
        if errored:
            raise SchemaError('metadata_query_failed')
        rows[name] = result
    return parse_metadata(rows)


def acquire_runner_lock(path, uid):
    try:
        existing = os.lstat(str(path))
    except OSError:
        existing = None
    if existing is not None and (not stat.S_ISREG(existing.st_mode)
                                 or existing.st_uid != uid or existing.st_nlink != 1
                                 or stat.S_IMODE(existing.st_mode) != 0o600):
        raise SchemaError('runner_lock_metadata_unsafe')
    flags = os.O_RDWR | os.O_CREAT | getattr(os, 'O_NOFOLLOW', 0)
    try:
        fd = os.open(str(path), flags, 0o600)
    except OSError:
        raise SchemaError('runner_lock_open_failed')
    try:
        os.fchmod(fd, 0o600)
        info = os.fstat(fd)
        current = os.lstat(str(path))
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_nlink != 1
                or file_signature(info) != file_signature(current)
                or stat.S_IMODE(info.st_mode) != 0o600):
            raise SchemaError('runner_lock_metadata_unsafe')
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd
    except BaseException:
        os.close(fd)
        raise


def runtime_paths():
    offline = os.environ.get('CYF_E05_SCHEMA_OFFLINE_TEST') == 'YES'
    if offline:
        root_value = os.environ.get('CYF_E05_SCHEMA_TEST_ROOT', '')
        root = Path(root_value)
        try:
            info = os.lstat(str(root))
        except OSError:
            raise SchemaError('offline_root_invalid')
        if (not root_value.startswith('/tmp/') or not stat.S_ISDIR(info.st_mode)
                or stat.S_IMODE(info.st_mode) != 0o700 or info.st_uid != os.geteuid()
                or stat.S_ISLNK(info.st_mode)):
            raise SchemaError('offline_root_invalid')
        return ({
            'jar': root / 'service/cyf-api-kit.jar',
            'package': root / 'state/incoming/package.tgz',
            'record': root / 'state/record.json',
            'mysql': root / 'bin/mysql',
            'lock': root / 'e05-runner.lock',
            'socket': str(root / 'mysql.sock'),
        }, os.geteuid(), {'jar': 0o600, 'package': 0o600, 'record': 0o600}, True)
    if os.geteuid() != 0:
        raise SchemaError('root_required')
    try:
        script = Path(os.path.realpath(__file__))
    except OSError:
        raise SchemaError('runner_path_invalid')
    if script != PRODUCTION_PATH:
        raise SchemaError('runner_path_invalid')
    safe_regular(PRODUCTION_PATH, 0, 0o755)
    socket_info = os.lstat(MYSQL_SOCKET)
    if not stat.S_ISSOCK(socket_info.st_mode):
        raise SchemaError('mysql_socket_invalid')
    return ({
        'jar': CANONICAL_JAR,
        'package': PACKAGE,
        'record': RECORD,
        'mysql': MYSQL,
        'lock': RUNNER_LOCK,
        'socket': MYSQL_SOCKET,
    }, 0, {'jar': 0o640, 'package': 0o600, 'record': 0o600}, False)


def table_report(status, mismatches=None):
    value = {'status': status}
    if mismatches:
        value['mismatches'] = mismatches
    return value


def run(operation, report):
    paths, uid, modes, offline = runtime_paths()
    mysql_info = safe_regular(paths['mysql'], uid, 0o700 if offline else 0o755)
    if mysql_info.st_mode & 0o022:
        raise SchemaError('mysql_client_metadata_unsafe')
    password = os.environ.get(PASSWORD_ENV)
    if not isinstance(password, str) or not password or '\n' in password or '\r' in password:
        raise SchemaError('mysql_password_environment_missing')
    lock_fd = acquire_runner_lock(paths['lock'], uid)
    session = None
    primary_error = None
    try:
        binding = verify_release_binding(paths, uid, modes)
        report['binding'] = {
            'organization': EXPECTED_ORG,
            'pipeline': EXPECTED_PIPELINE,
            'run': binding['run'],
            'source_commit': binding['source_commit'],
            'source_tree': binding['source_tree'],
            'jar_sha256': binding['jar_sha256'],
            'receipt_sha256': binding['receipt_sha256'],
        }
        statements = split_exact_statements(E05_SQL_BYTES)
        report['candidate'] = {
            'resource_outer': NESTED_MAPPER_JAR,
            'resource_inner': RESOURCE_PATH,
            'sql_sha256': binding['resource_sha256'],
            'tables': list(TABLE_ORDER),
            'statement_policy': 'exact_create_table_if_not_exists_only',
        }
        session = MysqlSession(paths['mysql'], paths['socket'], password)
        session.acquire()
        metadata = introspect(session)
        states = {}
        drift = False
        for table in TABLE_ORDER:
            state, mismatches = compare_table(metadata, table)
            states[table] = state
            if state == 'drift':
                report['tables'][table] = table_report('drift', mismatches)
                drift = True
            elif state == 'equivalent':
                report['tables'][table] = table_report('existing_equivalent')
            else:
                report['tables'][table] = table_report(
                    'planned_create' if operation == 'plan' else 'pending_create')
        if drift:
            raise SchemaError('existing_schema_drift')
        if operation == 'plan':
            session.release()
            return

        assert_binding_paths_unchanged(paths, uid, modes, binding, full_digest=True)
        for table in TABLE_ORDER:
            if states[table] == 'equivalent':
                continue
            assert_binding_paths_unchanged(paths, uid, modes, binding, full_digest=False)
            report['tables'][table] = table_report('create_attempted_unverified')
            ignored_rows, ddl_errored = session.command(statements[table])
            if ignored_rows:
                ddl_errored = True
            # DDL autocommits.  Always inspect the durable table state; never drop it.
            try:
                after = introspect(session)
                state, mismatches = compare_table(after, table)
            except SchemaError:
                state, mismatches = 'unknown', ['post_create_introspection']
            if ddl_errored:
                report['tables'][table] = table_report(
                    'create_backend_error_' + state, mismatches)
                raise SchemaError('create_statement_failed', table)
            if state != 'equivalent':
                report['tables'][table] = table_report('create_result_' + state, mismatches)
                raise SchemaError('created_table_not_equivalent', table)
            report['tables'][table] = table_report('created_equivalent')
            states[table] = 'equivalent'
        assert_binding_paths_unchanged(paths, uid, modes, binding, full_digest=False)
        session.release()
    except SchemaError as exc:
        primary_error = exc
        raise
    finally:
        close_error = None
        if session is not None:
            try:
                session.close()
            except SchemaError as exc:
                close_error = exc
        os.close(lock_fd)
        if primary_error is None and close_error is not None:
            raise close_error


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    report = {
        'schema_version': 1,
        'operation': 'apply' if argv == ['--apply'] else 'plan',
        'status': 'failed',
        'transaction_model': 'mysql_ddl_autocommit_per_create_no_rollback_or_drop',
        'lock_order': ['e05_runner_file_lock', 'e05_mysql_named_lock'],
        'tables': {},
    }
    if argv not in ([], ['--apply']):
        report['error'] = 'arguments_rejected'
        print(json.dumps(report, sort_keys=True, separators=(',', ':')))
        return 2
    try:
        run(report['operation'], report)
    except SchemaError as exc:
        report['error'] = exc.code
        if exc.detail in TABLE_ORDER:
            report['failed_table'] = exc.detail
        for table in TABLE_ORDER:
            if table not in report['tables']:
                report['tables'][table] = table_report('not_attempted')
        print(json.dumps(report, sort_keys=True, separators=(',', ':')))
        return 1
    report['status'] = 'pass'
    print(json.dumps(report, sort_keys=True, separators=(',', ':')))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
