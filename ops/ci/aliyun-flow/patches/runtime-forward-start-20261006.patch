+resume_forward_candidate() {
+  # Explicit retry of the same failed forward-only candidate after a measured fix.
+  # Never adopt a different ticket, restore backup bytes, or start the old JAR.
+  [[ "${CYF_API_FLOW_FORWARD_ONLY:-0}" == 1 && "$RECORD_MATCH" == 1 \
+     && "$RECORD_STATUS" == failed && "$RECORD_RECOVERY" == forward_only_candidate_retained \
+     && "$TARGET_STATE" == "$JAR_SHA" ]] || return 1
+  write_record activating forward_repair candidate_retained "$STOP_RC" \
+    || recoverable_fail 'forward repair record interrupted; candidate retained'
+  if ! "$LIFECYCLE" start; then
+    restore_and_start forward_repair_start_failed
+  fi
+  lifecycle_healthy || restore_and_start forward_repair_status_failed
+  finalize_candidate
+}
+
 commit_candidate() {
   if ! consume_approval; then
     recoverable_fail 'candidate is commit-pending but approval consumption was interrupted'
