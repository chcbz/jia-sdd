     return 1
 
 
+# BEGIN NATIVE_LOCAL_SOURCE_V1
+# Genuine LOCAL source support in the existing coordinator/transaction. This is
+# not the retired schema-3 authority/admission framework and never invents a Run.
+NATIVE_APPROVAL_KEYS = {'schema_version', 'source_kind', 'source', 'package',
+    'receipt_sha256', 'jar_sha256', 'expected_previous_sha256', 'consumed'}
+NATIVE_STATUSES = {'prepared', 'activating', 'active_pending', 'rolling_back', 'installed', 'failed'}
+
+
+def native_need(condition, message='invalid LOCAL source'):
+    if not condition:
+        raise SystemExit(message)
+
+
+def native_identity(identity):
+    native_need(type(identity) is dict and set(identity) == {'version', 'buildId', 'commit', 'tree'})
+    for key in ('version', 'buildId'):
+        native_need(type(identity[key]) is str and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*', identity[key]))
+    native_need(not identity['buildId'].isdigit(), 'LOCAL buildId must not be a numeric Flow Run')
+    for key in ('commit', 'tree'):
+        native_need(type(identity[key]) is str and re.fullmatch('[0-9a-f]{40}', identity[key]))
+    return identity
+
+
+def native_approval(value):
+    native_need(type(value) is dict and type(value.get('consumed')) is bool)
+    native_need(set(value) == NATIVE_APPROVAL_KEYS | ({'consumed_at'} if value['consumed'] else set()))
+    native_need(type(value['schema_version']) is int and value['schema_version'] == 4 and value['source_kind'] == 'LOCAL')
+    native_identity(value['source'])
+    for key in ('receipt_sha256', 'jar_sha256', 'expected_previous_sha256'):
+        native_need(type(value[key]) is str and re.fullmatch('[0-9a-f]{64}', value[key]))
+    item = value['package']
+    native_need(type(item) is dict and set(item) == {'path', 'sha256', 'size'})
+    native_need(type(item['path']) is str and item['path'].startswith('/')
+                and not any(ord(c) < 32 for c in item['path']) and str(Path(item['path'])) == item['path'])
+    native_need(type(item['sha256']) is str and re.fullmatch('[0-9a-f]{64}', item['sha256']))
+    native_need(type(item['size']) is int and item['size'] > 0)
+    if value['consumed']:
+        native_need(type(value['consumed_at']) is str and re.fullmatch('[0-9]{8}T[0-9]{6}Z', value['consumed_at']))
+    return value
+
+
+def native_binding(value):
+    native_approval(value)
+    immutable = {k: v for k, v in value.items() if k not in ('consumed', 'consumed_at')}
+    return hashlib.sha256(local_canonical(immutable)).hexdigest()
+
+
+def native_signature(info):
+    # Reading an immutable file may update atime. It is not a content or
+    # ownership mutation; mtime/ctime/inode/mode/size still must remain exact.
+    return (info.st_dev, info.st_ino, info.st_uid, info.st_gid, info.st_nlink,
+            info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+
+
+def native_private(path, mode=0o600):
+    path = Path(path)
+    native_need(path.is_absolute() and str(path.resolve()) == str(path), 'unsafe LOCAL physical path')
+    for parent in path.parents:
+        st = parent.lstat()
+        native_need(stat.S_ISDIR(st.st_mode) and st.st_uid == os.geteuid(), 'unsafe LOCAL parent')
+        # /tmp and /dev/shm may be root-owned sticky shared ancestors; the
+        # immediate artifact directory must still be owner-only below them.
+        native_need(not st.st_mode & 0o022 or st.st_mode & stat.S_ISVTX, 'writable LOCAL parent')
+    st = path.lstat()
+    native_need(stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid()
+                and st.st_nlink == 1 and stat.S_IMODE(st.st_mode) == mode, 'unsafe LOCAL file metadata')
+    return st
+
+
+def native_package(approval):
+    approval = native_approval(approval)
+    package = Path(approval['package']['path'])
+    before = native_private(package)
+    directory = package.parent.stat()
+    native_need(stat.S_IMODE(directory.st_mode) == 0o700, 'LOCAL artifact parent must be private')
+    with package.open('rb') as handle:
+        digest = digest_fileobj(handle)
+    native_need(native_signature(package.lstat()) == native_signature(before) and before.st_size == approval['package']['size']
+                and digest == approval['package']['sha256'], 'LOCAL package changed or digest mismatch')
+    return package
+
+
+def native_read_approval(path):
+    before = native_private(path)
+    data = Path(path).read_bytes()
+    native_need(native_signature(Path(path).lstat()) == native_signature(before), 'LOCAL descriptor changed')
+    return native_approval(local_json(data))
+
+
+def native_record(value, backup_root):
+    keys = {'schema_version', 'source_kind', 'source', 'package', 'binding_sha256',
+        'expected_previous_sha256', 'receipt_sha256', 'candidate_sha256', 'previous_sha256',
+        'status', 'phase', 'recovery', 'backup', 'candidate_stop_rc', 'timestamp'}
+    native_need(type(value) is dict and set(value) == keys and type(value['schema_version']) is int
+                and value['schema_version'] == 4 and value['source_kind'] == 'LOCAL')
+    native_need(value['status'] in NATIVE_STATUSES)
+    for key in ('phase', 'recovery'):
+        native_need(type(value[key]) is str and re.fullmatch('[a-z0-9_]+', value[key]))
+    for key in ('binding_sha256', 'receipt_sha256', 'candidate_sha256', 'previous_sha256', 'expected_previous_sha256'):
+        native_need(type(value[key]) is str and re.fullmatch('[0-9a-f]{64}', value[key]))
+    approval = dict(schema_version=4, source_kind='LOCAL', source=value['source'], package=value['package'],
+        receipt_sha256=value['receipt_sha256'], jar_sha256=value['candidate_sha256'],
+        expected_previous_sha256=value['expected_previous_sha256'], consumed=False)
+    native_need(native_binding(approval) == value['binding_sha256'], 'LOCAL record binding mismatch')
+    native_need(type(value['candidate_stop_rc']) is int and 0 <= value['candidate_stop_rc'] <= 255)
+    native_need(type(value['timestamp']) is str and re.fullmatch('[0-9]{8}T[0-9]{6}Z', value['timestamp']))
+    backup = Path(value['backup'])
+    native_need(backup.is_absolute() and backup.parent == Path(backup_root)
+                and re.fullmatch('[0-9]{8}T[0-9]{6}Z-[0-9a-f]{64}-[0-9]+\\.jar', backup.name), 'unsafe LOCAL rollback path')
+    return value
+
+
+def native_record_fields(value, backup_root):
+    native_record(value, backup_root)
+    return [value['status'], value['phase'], value['recovery'], value['binding_sha256'],
+        value['source']['commit'], value['source']['tree'], value['source']['buildId'],
+        value['receipt_sha256'], value['candidate_sha256'], value['previous_sha256'],
+        value['backup'], value['candidate_stop_rc'], value['timestamp']]
+
+
+def native_validate_payloads(approval, root):
+    a = native_approval(approval)
+    native_package(a)
+    root = Path(root)
+    receipt_bytes = (root / 'receipt.json').read_bytes()
+    receipt = local_json(receipt_bytes)
+    metadata = local_json((root / 'application.metadata.json').read_bytes())
+    sidecar = local_json((root / 'application.sidecar.json').read_bytes())
+    provenance = local_json((root / 'dependency.provenance.json').read_bytes())
+    native_need(hashlib.sha256(receipt_bytes).hexdigest() == a['receipt_sha256'], 'LOCAL receipt digest mismatch')
+    native_need(receipt.get('format') == 'cyf-api-local-release-receipt-v1' and receipt.get('status') == 'packaged'
+        and receipt.get('producer') == {'kind': 'local-build-v1'} and receipt.get('identity') == a['source']
+        and receipt.get('source') == dict(commit=a['source']['commit'], tree=a['source']['tree'], cleanBefore=True, cleanAfter=True)
+        and 'flow' not in receipt, 'LOCAL receipt source mismatch')
+    refs = {}
+    for key, filename in [('applicationJar', 'application.jar'), ('dependencyProvenance', 'dependency.provenance.json')]:
+        item = receipt.get(key)
+        native_need(type(item) is dict and set(item) == {'path', 'sha256', 'size'} and item['path'] == filename)
+        p = root / filename
+        with p.open('rb') as handle: digest = digest_fileobj(handle)
+        native_need(type(item['size']) is int and item['size'] == p.stat().st_size
+                    and item['sha256'] == digest, 'LOCAL payload digest mismatch')
+        refs[key] = item
+    native_need(refs['applicationJar']['sha256'] == a['jar_sha256'])
+    binding = dict(identity=a['source'], receiptSha256=a['receipt_sha256'], **refs)
+    native_need(type(metadata) is dict and set(metadata) == set(binding) | {'format', 'moduleVersion', 'implementationVersion'}
+        and metadata['format'] == 'cyf-api-local-application-metadata-v1'
+        and all(metadata[k] == v for k, v in binding.items()), 'LOCAL metadata mismatch')
+    native_need(sidecar == dict(format='cyf-api-local-application-sidecar-v1', **binding), 'LOCAL sidecar mismatch')
+    native_need(provenance.get('coordinate') == 'org.opencv:opencv:4.5.5'
+        and provenance.get('jar_sha256') == '323d40119548134b0966d3735e97a78d1edbc79bd91e7fb1074e5152392095f4'
+        and type(provenance.get('jar_size')) is int and provenance['jar_size'] == 722802, 'LOCAL OpenCV pin mismatch')
+    tests = receipt.get('evidence', {}).get('tests')
+    native_need(type(tests) is list and bool(tests), 'LOCAL test evidence missing')
+    tasks = set()
+    for item in tests:
+        native_need(type(item) is dict and item.get('task') not in tasks and type(item.get('reports')) is list
+                    and bool(item['reports']), 'LOCAL test evidence invalid')
+        tasks.add(item['task'])
+        for report in item['reports']:
+            native_need(type(report) is dict and type(report.get('tests')) is int
+                and type(report.get('skipped')) is int and report['tests'] >= report['skipped'] >= 0
+                and type(report.get('failures')) is int and report['failures'] == 0
+                and type(report.get('errors')) is int and report['errors'] == 0, 'LOCAL test failure or invalid counts')
+        native_need(sum(r['tests'] - r['skipped'] for r in item['reports']) > 0)
+    native_need({':agent:jia-agent-service:localReleaseBaseline', ':starter:localReleaseBaseline',
+        ':starter:publicArtifactVerifierTest', ':starter:poiProductionRuntimeClasspathTest'} <= tasks,
+        'LOCAL required release tests missing')
+    native_need(receipt.get('verification', {}).get('publicArtifactVerifier') == 'bootJar-original-doLast-completed')
+    with zipfile.ZipFile(root / 'application.jar') as boot:
+        entries = boot.infolist()
+        native_need(len(entries) == len({e.filename for e in entries})
+            and all(not e.filename.startswith('/') and '\\' not in e.filename and '..' not in e.filename.split('/') for e in entries),
+            'unsafe LOCAL bootJar entry')
+        lines = boot.read('META-INF/MANIFEST.MF').decode().replace('\r\n', '\n').split('\n')
+        unfolded = []
+        for line in lines:
+            if not line: break
+            if line.startswith(' '):
+                native_need(bool(unfolded)); unfolded[-1] += line[1:]
+            else: unfolded.append(line)
+        attrs = {}
+        for line in unfolded:
+            k, sep, v = line.partition(': '); native_need(sep and k not in attrs); attrs[k] = v
+        native_need(attrs.get('Start-Class') == 'cn.jia.JiaApplication'
+            and attrs.get('Main-Class', '').startswith('org.springframework.boot.loader.')
+            and attrs.get('CYF-Source-Commit') == a['source']['commit']
+            and attrs.get('CYF-Source-Tree') == a['source']['tree']
+            and attrs.get('CYF-Local-Build-Id') == a['source']['buildId']
+            and attrs.get('CYF-Release-Version') == a['source']['version'], 'LOCAL executable source mismatch')
+        # common-core declares OpenCV compileOnly (testImplementation for its
+        # tests), so a valid production bootJar normally has no OpenCV member.
+        # The producer verifies the pinned build dependency before consumption;
+        # provenance above retains that binding. If a runtime copy is present,
+        # it must still be the exact pinned dependency, never an alternate JAR.
+        cv_members = [e for e in entries if e.filename.startswith('BOOT-INF/lib/opencv-')]
+        if cv_members:
+            native_need(len(cv_members) == 1 and cv_members[0].filename == 'BOOT-INF/lib/opencv-4.5.5.jar',
+                        'LOCAL packaged OpenCV coordinate mismatch')
+            cv = cv_members[0]
+            with boot.open(cv) as handle: digest = digest_fileobj(handle)
+            native_need(cv.file_size == 722802 and digest == provenance['jar_sha256'], 'LOCAL packaged OpenCV mismatch')
+    return a
+
