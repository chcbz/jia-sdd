+def native_api_main(argv):
+    native_need(os.geteuid() == 0 and len(argv) == 1, 'expected root --source-local descriptor.json')
+    approval = native_read_approval(Path(argv[0]))
+    native_need(not approval['consumed'], 'new LOCAL descriptor is already consumed')
+    native_package(approval)
+    safe_regular(Path(__file__).resolve(), mode=0o755)
+    safe_regular(Path(INSTALLER), mode=0o755)
+    validate_backup_directory(BACKUPS)
+    lock_fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+    try:
+        safe_regular(Path(LOCK), mode=0o600)
+        native_need(os.fstat(lock_fd) == Path(LOCK).lstat(), 'LOCAL coordinator lock changed')
+        fcntl.flock(lock_fd, fcntl.LOCK_EX)
+        os.set_inheritable(lock_fd, False)
+        record_path = ROOT / 'record.json'
+        if record_path.exists():
+            safe_regular(record_path, mode=0o600)
+            previous = local_json(record_path.read_bytes())
+            if previous.get('status') != 'installed':
+                native_need(previous.get('schema_version') == 4, 'unfinished transaction belongs to another release')
+                native_record(previous, BACKUPS)
+                native_need(previous['binding_sha256'] == native_binding(approval), 'unfinished LOCAL transaction belongs to another release')
+        # Preserve root state before writing the next exact-source descriptor.
+        if APPROVAL.exists() or APPROVAL.is_symlink():
+            safe_regular(APPROVAL, mode=0o600)
+            old = APPROVAL.read_bytes()
+            archive = BACKUPS / ('approval-before-local-' + hashlib.sha256(old).hexdigest() + '.json')
+            if archive.exists(): native_need(archive.read_bytes() == old)
+            else:
+                fd = os.open(archive, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+                with os.fdopen(fd, 'wb') as out: out.write(old); out.flush(); os.fsync(out.fileno())
+                fsync_dir(BACKUPS)
+        # A consumed descriptor must stay consumed on idempotent/recovery calls.
+        if APPROVAL.exists():
+            current = local_json(APPROVAL.read_bytes())
+            if current.get('schema_version') == 4 and native_binding(current) == native_binding(approval): approval = current
+        atomic_write(APPROVAL, local_canonical(approval))
+        rc = invoke_installer(INSTALLER) # no Flow schema hooks for a LOCAL/no-schema-change release
+        if rc == 0:
+            record = local_json(record_path.read_bytes()); native_record(record, BACKUPS)
+            native_need(record['status'] == 'installed' and record['binding_sha256'] == native_binding(approval))
+            print('CYF_API_LOCAL_INSTALL=PASS ' + json.dumps({'source': approval['source'], 'jar_sha256': approval['jar_sha256']}), flush=True)
+        return rc
+    finally:
+        os.close(lock_fd)
+# END NATIVE_LOCAL_SOURCE_V1
+
