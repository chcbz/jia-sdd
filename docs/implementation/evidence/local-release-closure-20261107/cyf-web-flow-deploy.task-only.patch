+# BEGIN NATIVE_LOCAL_WEB_TRANSACTION
+# Explicit LOCAL source on the same site/lock/publication primitives as Flow.
+def local_json_bytes(value):
+    return (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode()
+
+
+def local_sync_dir(path):
+    fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def local_save(path, value):
+    atomic(path, local_json_bytes(value), 0o600)
+    local_sync_dir(path.parent)
+
+
+def local_private(path):
+    path = Path(path)
+    if not path.is_absolute() or path.resolve() != path:
+        fail('unsafe LOCAL physical path')
+    for parent in path.parents:
+        st = parent.lstat()
+        if (not stat.S_ISDIR(st.st_mode) or st.st_uid != 0
+                or st.st_mode & 0o022 and not st.st_mode & stat.S_ISVTX):
+            fail('unsafe LOCAL parent')
+    st = path.lstat()
+    if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1
+            or stat.S_IMODE(st.st_mode) != 0o600):
+        fail('unsafe LOCAL private file')
+    return st
+
+
+def local_descriptor(path):
+    local_private(path)
+    try:
+        value = json.loads(Path(path).read_text(), object_pairs_hook=unique_json_object)
+    except (OSError, ValueError):
+        fail('invalid LOCAL descriptor')
+    keys = {'schema_version', 'source_kind', 'source', 'package',
+            'previousIndexSha256', 'previousRecordSha256'}
+    if (type(value) is not dict or set(value) != keys or type(value['schema_version']) is not int
+            or value['schema_version'] != 1 or value['source_kind'] != 'LOCAL'):
+        fail('invalid LOCAL descriptor schema')
+    source = value['source']
+    if (type(source) is not dict or set(source) != {'commit', 'tree', 'version', 'buildId'}
+            or any(type(source[k]) is not str or not re.fullmatch('[0-9a-f]{40}', source[k]) for k in ('commit', 'tree'))
+            or stable_version(source['version']) is None
+            or type(source['buildId']) is not str or not re.fullmatch('[A-Za-z][A-Za-z0-9_.-]*', source['buildId'])):
+        fail('invalid LOCAL descriptor identity')
+    package = value['package']
+    if (type(package) is not dict or set(package) != {'path', 'sha256', 'size'}
+            or type(package['path']) is not str or type(package['size']) is not int or package['size'] <= 0):
+        fail('invalid LOCAL package reference')
+    for digest in [package['sha256'], value['previousIndexSha256'], value['previousRecordSha256']]:
+        if type(digest) is not str or not re.fullmatch('[0-9a-f]{64}', digest):
+            fail('invalid LOCAL descriptor digest')
+    return value
