uivalent\'}\n        if (value.get(\'status\') != \'pass\' or \'error\' in value\n                or any(table[\'status\'] not in success_states\n                       for table in value[\'tables\'].values())):\n            raise SchemaIntegrationError(\n                \'schema_runner_false_success\',\n                \'verify both F06 tables from durable metadata before a new Flow run\')\n    elif value.get(\'status\') != \'failed\' or not isinstance(value.get(\'error\'), str):\n        raise SchemaIntegrationError(\n            \'schema_runner_failure_report_invalid\',\n            \'inspect the preserved root-only stdout/stderr and verify partial DDL before a new Flow run\')\n    return value\n\n\ndef protected_schema_password():\n    """Host-local root-only secret, never shell-sourced or forwarded to the JVM."""\n    try:\n        parent = SCHEMA_PASSWORD_FILE.parent.lstat()\n        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0\n                or stat.S_IMODE(parent.st_mode) != 0o700):\n            return None\n        fd = os.open(str(SCHEMA_PASSWORD_FILE), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)\n        try:\n            info = os.fstat(fd)\n            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0\n                    or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):\n                return None\n            with os.fdopen(fd, \'r\', encoding=\'utf-8\', closefd=False) as handle:\n                value = handle.read()\n            after = os.fstat(fd)\n            if (info.st_size, info.st_mtime_ns) != (after.st_size, after.st_mtime_ns):\n                return None\n            return value\n        finally:\n            os.close(fd)\n    except (OSError, UnicodeError):\n        return None\n\n\ndef schema_prerequisites():\n    missing = []\n    if not SCHEMA_RUNNER.exists() and not SCHEMA_RUNNER.is_symlink():\n        missing.append(\'schema_runner_not_installed\')\n    else:\n        try:\n            safe_regular(SCHEMA_RUNNER, mode=0o755)\n        except SystemExit:\n            missing.append(\'schema_runner_metadata_unsafe\')\n    password = os.environ.get(SCHEMA_PASSWORD_ENV)\n    if password is None:\n        password = protected_schema_password()\n    if not isinstance(password, str) or not password or \'\\n\' in password or \'\\r\' in password:\n        missing.append(\'db_principal_or_protected_password_not_configured\')\n    return missing, password\n\n\ndef run_schema_once(context, paths):\n    started_at = utc_timestamp()\n    prerequisites, password = schema_prerequisites()\n    if prerequisites:\n        result = schema_state(\n            context, \'blocked_precondition\', started_at,\n            finished_at=utc_timestamp(), error=\'schema_activation_prerequisites_missing\',\n            prerequisites=prerequisites,\n            action=(\'install the reviewed runner as root:root 0755; provision fixed MySQL user \'\n                    \'cyf_f06_schema_runner for jia with only required metadata/lock/CREATE grants; \'\n                    \'provision root:root 0600 f06-schema-password under the root-only Flow state directory \'\n                    \'or inject protected CYF_F06_MYSQL_PASSWORD; then use a new Flow run\'))\n        write_schema_state(paths[\'state\'], result, create=True)\n        print(json.dumps({\'f06_schema\': \'blocked_precondition\', \'result\': result},\n                         sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 1\n\n    running = schema_state(\n        context, \'running\', started_at,\n        action=(\'if this process is interrupted, inspect durable F06 table metadata and the \'\n                \'preserved output files; never rerun this same Flow release automatically\'),\n        stdout_path=str(paths[\'stdout\']), stderr_path=str(paths[\'stderr\']))\n    write_schema_state(paths[\'state\'], running, create=True)\n    stdout_fd = os.open(str(paths[\'stdout\']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    stderr_fd = os.open(str(paths[\'stderr\']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    try:\n        child_env = {\n            \'PATH\': \'/usr/sbin:/usr/bin:/sbin:/bin\',\n            \'LC_ALL\': \'C\',\n            SCHEMA_PASSWORD_ENV: password,\n        }\n        try:\n            completed = subprocess.run(\n                [str(SCHEMA_RUNNER), \'--apply\'], env=child_env,\n                stdout=stdout_fd, stderr=stderr_fd, close_fds=True)\n            return_code = completed.returncode\n        except OSError:\n            return_code = 1\n            integration_error = SchemaIntegrationError(\n                \'schema_runner_start_failed\',\n                \'repair the installed runner and inspect durable schema state before a new Flow run\')\n        else:\n            integration_error = None\n        os.fsync(stdout_fd)\n        os.fsync(stderr_fd)\n    finally:\n        os.close(stdout_fd)\n        os.close(stderr_fd)\n        fsync_dir(SCHEMA_RESULTS)\n\n    stdout_bytes = paths[\'stdout\'].read_bytes()\n    stderr_bytes = paths[\'stderr\'].read_bytes()\n    report = None\n    if integration_error is None:\n        try:\n            report = validate_runner_report(stdout_bytes, return_code)\n        except SchemaIntegrationError as exc:\n            integration_error = exc\n    if integration_error is not None:\n        status = \'failed\'\n        error = integration_error.code\n        action = integration_error.action\n    elif return_code == 0:\n        status = \'pass\'\n        error = None\n        action = \'schema is verified only; feature activation and authenticated acceptance remain separate\'\n    else:\n        status = \'failed\'\n        error = report[\'error\']\n        action = (\'inspect the preserved runner report/stdout/stderr and durable table metadata; \'\n                  \'do not drop tables or rerun this same Flow release automatically\')\n    result = schema_state(\n        context, status, started_at, finished_at=utc_timestamp(),\n        runner_exit_code=return_code, error=error, action=action,\n        runner_report=report, stdout_path=str(paths[\'stdout\']),\n        stdout_sha256=hashlib.sha256(stdout_bytes).hexdigest(),\n        stderr_path=str(paths[\'stderr\']),\n        stderr_sha256=hashlib.sha256(stderr_bytes).hexdigest())\n    write_schema_state(paths[\'state\'], result)\n    print(json.dumps({\'f06_schema\': status, \'result\': result},\n                     sort_keys=True, separators=(\',\', \':\')), flush=True)\n    return return_code if status == \'pass\' or 0 < return_code < 256 else 1\n\n\ndef apply_schema_after_install(context):\n    release_fd = acquire_release_lock(RELEASE_LOCK)\n    try:\n        ensure_private_directory(SCHEMA_RESULTS)\n        paths = schema_paths(context[\'run_id\'])\n        existing = existing_schema_result(paths, context)\n        if existing is not None:\n            return existing\n        try:\n            load_installed_record(ROOT / \'record.json\', context)\n        except SchemaIntegrationError as exc:\n            now = utc_timestamp()\n            result = schema_state(\n                context, \'failed\', now, finished_at=utc_timestamp(),\n                runner_exit_code=1, error=exc.code, action=exc.action)\n            write_schema_state(paths[\'state\'], result, create=True)\n            print(json.dumps({\'f06_schema\': \'failed\', \'result\': result},\n                             sort_keys=True, separators=(\',\', \':\')), flush=True)\n            return 1\n        return run_schema_once(context, paths)\n    finally:\n        os.close(release_fd)\n\n\nE05_SCHEMA_RUNNER = Path(\'/usr/local/sbin/cyf-api-e05-additive-schema\')\nE05_SCHEMA_RESULTS = ROOT / \'e05-schema-results\'\nE05_SCHEMA_STATE_ROOT = ROOT\nE05_SCHEMA_RECORD = ROOT / \'record.json\'\nE05_SCHEMA_ACTIVATION_FILE = ROOT / \'e05-schema-activation.json\'\nE05_SCHEMA_PASSWORD_FILE = ROOT / \'e05-schema-password\'\nE05_RELEASE_LOCK = RELEASE_LOCK\nE05_SCHEMA_PASSWORD_ENV = \'CYF_E05_MYSQL_PASSWORD\'\nE05_SCHEMA_SQL_SHA256 = \'f880de923e96630969b0d2107e5560ed94383a2f74663e708d30a6dfb01af842\'\nE05_SCHEMA_RUNNER_SHA256 = \'7d09fedd2e3a6f0d1909e55f6ee87781581fca81c93bd00c34461686adceee3a\'\nE05_REQUIRED_API_COMMIT_SHA = \'c64f8c4d29f7bcf1a6e153e1ae68e946d1493363\'\n# Permission for fixed additive SQL, not a claim that this Flow Run has succeeded.\n# The controller binds an already-created Run to its verified source/tree/ancestor\n# before this hook is reached. main() checks that Run\'s successful test/build\n# receipt and JAR; invoke_installer() requires healthy installation and F06 success.\n# This hook is part of deployment, so final Flow SUCCESS is an outcome, never an\n# admission prerequisite. No CI-only duplicate build or per-release human ticket.\nE05_ACTIVATION_AUTHORIZATION = \'controller_authorized_fixed_additive_sql_exact_run_once\'\nE05_ACTIVATION_KEYS = {\n    \'schema_version\', \'feature\', \'status\', \'authorization\', \'pipeline_id\', \'run_id\',\n    \'source_commit_sha\', \'source_tree_sha\', \'verified_api_ancestor_sha\',\n    \'sql_sha256\', \'runner_sha256\',\n}\nE05_SCHEMA_REPORT_KEYS = {\n    \'schema_version\', \'operation\', \'status\', \'transaction_model\', \'lock_order\',\n    \'tables\', \'binding\', \'candidate\', \'error\', \'failed_table\',\n}\nE05_SCHEMA_TABLE = \'agent_work_item_reassignment\'\n\n\ndef e05_file_signature(value):\n    return (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns)\n\n\ndef e05_private_state_root():\n    try:\n        info = E05_SCHEMA_STATE_ROOT.lstat()\n    except OSError:\n        raise SchemaIntegrationError(\n            \'e05_state_root_missing\',\n            \'restore the root-owned 0700 Flow state directory before enabling E05\')\n    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0\n            or stat.S_IMODE(info.st_mode) != 0o700):\n        raise SchemaIntegrationError(\n            \'e05_state_root_unsafe\',\n            \'restore the root:root 0700 Flow state directory before enabling E05\')\n\n\ndef ensure_e05_results_directory():\n    e05_private_state_root()\n    E05_SCHEMA_RESULTS.mkdir(mode=0o700, parents=False, exist_ok=True)\n    info = E05_SCHEMA_RESULTS.lstat()\n    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0\n            or stat.S_IMODE(info.st_mode) != 0o700):\n        raise SchemaIntegrationError(\n            \'e05_schema_result_directory_unsafe\',\n            \'repair the root:root 0700 E05 result directory before a new Flow run\')\n\n\ndef e05_read_stable_regular(path, mode, label):\n    try:\n        before = path.lstat()\n    except OSError:\n        raise SchemaIntegrationError(\n            label + \'_missing\',\n            \'repair the exact root-only E05 host file, then use a new Flow run\')\n    if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_gid != 0\n            or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != mode):\n        raise SchemaIntegrationError(\n            label + \'_metadata_unsafe\',\n            \'repair the exact root:root E05 host file metadata, then use a new Flow run\')\n    try:\n        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)\n    except OSError:\n        raise SchemaIntegrationError(\n            label + \'_open_failed\',\n            \'repair the exact root-only E05 host file, then use a new Flow run\')\n    try:\n        opened = os.fstat(fd)\n        if e05_file_signature(opened) != e05_file_signature(before):\n            raise SchemaIntegrationError(\n                label + \'_changed\',\n                \'preserve the changed E05 host file and use a new Flow run\')\n        with os.fdopen(fd, \'rb\', closefd=False) as stream:\n            value = stream.read()\n        after = os.fstat(fd)\n    finally:\n        os.close(fd)\n    try:\n        current = path.lstat()\n    except OSError:\n        raise SchemaIntegrationError(\n            label + \'_changed\',\n            \'preserve the changed E05 host file and use a new Flow run\')\n    if (e05_file_signature(before) != e05_file_signature(after)\n            or e05_file_signature(after) != e05_file_signature(current)):\n        raise SchemaIntegrationError(\n            label + \'_changed\',\n            \'preserve the changed E05 host file and use a new Flow run\')\n    return value, e05_file_signature(current)\n\n\ndef load_e05_activation(context):\n    if (not E05_SCHEMA_ACTIVATION_FILE.exists()\n            and not E05_SCHEMA_ACTIVATION_FILE.is_symlink()):\n        return None\n    e05_private_state_root()\n    raw, signature = e05_read_stable_regular(\n        E05_SCHEMA_ACTIVATION_FILE, 0o600, \'e05_activation\')\n    try:\n        value = json.loads(raw.decode(\'utf-8\'))\n    except (UnicodeDecodeError, ValueError):\n        raise SchemaIntegrationError(\n            \'e05_activation_json_invalid\',\n            \'replace the invalid root-only activation admission and use a new Flow run\')\n    if (not isinstance(value, dict) or set(value) != E05_ACTIVATION_KEYS\n            or value.get(\'schema_version\') != 1\n            or value.get(\'feature\') != \'M4-E05-additive-schema\'\n            or value.get(\'status\') != \'enabled_once\'\n            or value.get(\'authorization\') != E05_ACTIVATION_AUTHORIZATION\n            or value.get(\'pipeline_id\') != EXPECTED_PIPELINE\n            or value.get(\'verified_api_ancestor_sha\') != E05_REQUIRED_API_COMMIT_SHA\n            or value.get(\'sql_sha256\') != E05_SCHEMA_SQL_SHA256\n            or value.get(\'runner_sha256\') != E05_SCHEMA_RUNNER_SHA256\n            or not RUN_ID.fullmatch(str(value.get(\'run_id\', \'\')))\n            or not re.fullmatch(r\'[0-9a-f]{40}\', str(value.get(\'source_commit_sha\', \'\')))\n            or not re.fullmatch(r\'[0-9a-f]{40}\', str(value.get(\'source_tree_sha\', \'\')))):\n        raise SchemaIntegrationError(\n            \'e05_activation_contract_invalid\',\n            \'use the fixed-SQL authorization contract for the source-verified Run; never retry an attempted Run\')\n    expected = {\n        \'pipeline_id\': context[\'pipeline_id\'],\n        \'run_id\': context[\'run_id\'],\n        \'source_commit_sha\': context[\'source_commit_sha\'],\n        \'source_tree_sha\': context[\'source_tree_sha\'],\n    }\n    digest = hashlib.sha256(raw).hexdigest()\n    if any(value.get(key) != expected_value for key, expected_value in expected.items()):\n        return {\n            \'status\': \'not_for_release\',\n            \'sha256\': digest,\n            \'signature\': signature,\n            \'value\': value,\n        }\n    return {\n        \'status\': \'admitted\',\n        \'sha256\': digest,\n        \'signature\': signature,\n        \'value\': value,\n    }\n\n\ndef assert_e05_activation_unchanged(admission):\n    raw, signature = e05_read_stable_regular(\n        E05_SCHEMA_ACTIVATION_FILE, 0o600, \'e05_activation\')\n    if (signature != admission[\'signature\']\n            or hashlib.sha256(raw).hexdigest() != admission[\'sha256\']):\n        raise SchemaIntegrationError(\n            \'e05_activation_changed\',\n            \'preserve the changed activation admission and use a new Flow run\')\n\n\ndef acquire_e05_release_lock(path):\n    try:\n        isp_gid = grp.getgrnam(\'isp\').gr_gid\n    except KeyError:\n        raise SchemaIntegrationError(\n            \'e05_release_lock_group_missing\',\n            \'restore the existing isp release-lock group; this admitted run must not be retried\')\n    try:\n        info = path.lstat()\n    except OSError:\n        raise SchemaIntegrationError(\n            \'e05_release_lock_missing\',\n            \'restore /tmp/cyf-release-api.lock; this admitted run must not be retried\')\n    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != isp_gid\n            or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o660):\n        raise SchemaIntegrationError(\n            \'e05_release_lock_metadata_unsafe\',\n            \'restore the canonical root:isp 0660 release lock; this admitted run must not be retried\')\n    try:\n        fd = os.open(str(path), os.O_RDWR | os.O_NOFOLLOW)\n    except OSError:\n        raise SchemaIntegrationError(\n            \'e05_release_lock_open_failed\',\n            \'restore the canonical API release lock; this admitted run must not be retried\')\n    try:\n        opened = os.fstat(fd)\n        if e05_file_signature(opened) != e05_file_signature(info):\n            raise SchemaIntegrationError(\n                \'e05_release_lock_changed\',\n                \'preserve the changed release lock; this admitted run must not be retried\')\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        return fd\n    except BaseException:\n        os.close(fd)\n        raise\n\n\ndef e05_schema_paths(run_id):\n    stem = \'run-\' + run_id\n    return {\n        \'state\': E05_SCHEMA_RESULTS / (stem + \'.json\'),\n        \'stdout\': E05_SCHEMA_RESULTS / (stem + \'.stdout\'),\n        \'stderr\': E05_SCHEMA_RESULTS / (stem + \'.stderr\'),\n    }\n\n\ndef e05_schema_state(context, status, started_at, **updates):\n    value = {\n        \'schema_version\': 1,\n        \'feature\': \'M4-E05-additive-schema\',\n        \'status\': status,\n        \'activation_claim\': \'schema_only_not_feature_activation\',\n        \'admission_status\': \'admitted\',\n        \'activation_path\': str(E05_SCHEMA_ACTIVATION_FILE),\n        \'activation_sha256\': None,\n        \'pipeline_id\': context[\'pipeline_id\'],\n        \'run_id\': context[\'run_id\'],\n        \'source_commit_sha\': context[\'source_commit_sha\'],\n        \'source_tree_sha\': context[\'source_tree_sha\'],\n        \'receipt_sha256\': context[\'receipt_sha256\'],\n        \'jar_sha256\': context[\'jar_sha256\'],\n        \'sql_sha256\': E05_SCHEMA_SQL_SHA256,\n        \'runner_path\': str(E05_SCHEMA_RUNNER),\n        \'runner_sha256\': E05_SCHEMA_RUNNER_SHA256,\n        \'verified_api_ancestor_sha\': E05_REQUIRED_API_COMMIT_SHA,\n        \'started_at\': started_at,\n        \'finished_at\': None,\n        \'runner_exit_code\': None,\n        \'error\': None,\n        \'action\': None,\n        \'prerequisites\': [],\n        \'runner_report\': None,\n        \'stdout_path\': None,\n        \'stdout_sha256\': None,\n        \'stderr_path\': None,\n        \'stderr_sha256\': None,\n        \'lock_order\': [\n            \'flow_coordinator_lock\', \'api_release_lock\',\n            \'e05_runner_file_lock\', \'e05_mysql_named_lock\',\n        ],\n        \'transaction_model\': \'installed_record_then_mysql_ddl_autocommit_no_rollback_or_drop\',\n    }\n    value.update(updates)\n    return value\n\n\ndef validate_e05_schema_state(value, context):\n    expected = set(e05_schema_state(context, \'running\', \'x\'))\n    if not isinstance(value, dict) or set(value) != expected or value.get(\'schema_version\') != 1:\n        raise SchemaIntegrationError(\n            \'e05_schema_result_state_invalid\',\n            \'inspect the root-only E05 result files; do not delete or rerun this release\')\n    for key in (\'pipeline_id\', \'run_id\', \'source_commit_sha\', \'source_tree_sha\',\n                \'receipt_sha256\', \'jar_sha256\'):\n        if value.get(key) != context[key]:\n            raise SchemaIntegrationError(\n                \'e05_schema_result_binding_mismatch\',\n                \'preserve the mismatched E05 evidence and use a new Flow run\')\n    if (value.get(\'sql_sha256\') != E05_SCHEMA_SQL_SHA256\n            or value.get(\'runner_sha256\') != E05_SCHEMA_RUNNER_SHA256\n            or value.get(\'verified_api_ancestor_sha\') != E05_REQUIRED_API_COMMIT_SHA):\n        raise SchemaIntegrationError(\n            \'e05_schema_result_catalog_mismatch\',\n            \'preserve the result and reconcile the fixed E05 catalogs before a new Flow run\')\n    return value\n\n\ndef existing_e05_schema_result(paths, context):\n    if not paths[\'state\'].exists() and not paths[\'state\'].is_symlink():\n        return None\n    try:\n        raw, _ = e05_read_stable_regular(paths[\'state\'], 0o600, \'e05_schema_result\')\n        value = json.loads(raw.decode(\'utf-8\'))\n    except SchemaIntegrationError:\n        raise\n    except (UnicodeDecodeError, ValueError):\n        raise SchemaIntegrationError(\n            \'e05_schema_result_state_invalid\',\n            \'inspect the root-only E05 result files; do not delete or rerun this release\')\n    value = validate_e05_schema_state(value, context)\n    print(json.dumps({\'e05_schema\': \'existing_same_run_result\', \'result\': value},\n                     sort_keys=True, separators=(\',\', \':\')), flush=True)\n    if value[\'status\'] == \'pass\':\n        return 0\n    return (value[\'runner_exit_code\']\n            if isinstance(value[\'runner_exit_code\'], int)\n            and 0 < value[\'runner_exit_code\'] < 256 else 1)\n\n\ndef validate_e05_runner_report(data, return_code, context):\n    try:\n        value = json.loads(data.decode(\'utf-8\'))\n    except (UnicodeDecodeError, ValueError):\n        raise SchemaIntegrationError(\n            \'e05_schema_runner_report_invalid\',\n            \'inspect preserved E05 stdout/stderr and durable table metadata before a new Flow run\')\n    if (not isinstance(value, dict) or not set(value).issubset(E05_SCHEMA_REPORT_KEYS)\n            or value.get(\'schema_version\') != 1 or value.get(\'operation\') != \'apply\'\n            or value.get(\'transaction_model\') != \'mysql_ddl_autocommit_per_create_no_rollback_or_drop\'\n            or value.get(\'lock_order\') != [\'e05_runner_file_lock\', \'e05_mysql_named_lock\']\n            or set(value.get(\'tables\', {})) != {E05_SCHEMA_TABLE}):\n        raise SchemaIntegrationError(\n            \'e05_schema_runner_report_contract_mismatch\',\n            \'inspect preserved E05 output; do not infer schema activation\')\n    table = value[\'tables\'][E05_SCHEMA_TABLE]\n    if (not isinstance(table, dict) or set(table) - {\'status\', \'mismatches\'}\n            or not isinstance(table.get(\'status\'), str)\n            or (\'mismatches\' in table and not isinstance(table[\'mismatches\'], list))):\n        raise SchemaIntegrationError(\n            \'e05_schema_runner_report_contract_mismatch\',\n            \'inspect preserved E05 output; do not infer schema activation\')\n    if \'failed_table\' in value and value[\'failed_table\'] != E05_SCHEMA_TABLE:\n        raise SchemaIntegrationError(\n            \'e05_schema_runner_report_contract_mismatch\',\n            \'inspect preserved E05 output; do not infer schema activation\')\n    binding = value.get(\'binding\')\n    if binding is not None:\n        expected_binding = {\n            \'organization\': EXPECTED_ORG,\n            \'pipeline\': context[\'pipeline_id\'],\n            \'run\': context[\'run_id\'],\n            \'source_commit\': context[\'source_commit_sha\'],\n            \'source_tree\': context[\'source_tree_sha\'],\n            \'jar_sha256\': context[\'jar_sha256\'],\n            \'receipt_sha256\': context[\'receipt_sha256\'],\n        }\n        if binding != expected_binding:\n            raise SchemaIntegrationError(\n                \'e05_schema_runner_binding_mismatch\',\n                \'preserve the mismatched E05 report and use a new Flow run\')\n    candidate = value.get(\'candidate\')\n    if candidate is not None and candidate != {\n            \'resource_outer\': \'BOOT-INF/lib/jia-agent-mapper-1.1.2-SNAPSHOT.jar\',\n            \'resource_inner\': \'db/agent-work-item-reassignment-e05.sql\',\n            \'sql_sha256\': E05_SCHEMA_SQL_SHA256,\n            \'tables\': [E05_SCHEMA_TABLE],\n            \'statement_policy\': \'exact_create_table_if_not_exists_only\'}:\n        raise SchemaIntegrationError(\n            \'e05_schema_runner_candidate_mismatch\',\n            \'preserve the mismatched E05 candidate and use a new Flow run\')\n    if return_code == 0:\n        if (value.get(\'status\') != \'pass\' or \'error\' in value or \'failed_table\' in value\n                or binding is None or candidate is None\n                or table[\'status\'] not in {\'created_equivalent\', \'existing_equivalent\'}):\n            raise SchemaIntegrationError(\n                \'e05_schema_runner_false_success\',\n                \'verify the E05 table from durable metadata before a new Flow run\')\n    elif value.get(\'status\') != \'failed\' or not isinstance(value.get(\'error\'), str):\n        raise SchemaIntegrationError(\n            \'e05_schema_runner_failure_report_invalid\',\n            \'inspect preserved E05 stdout/stderr and durable table metadata before a new Flow run\')\n    return value\n\n\ndef protected_e05_schema_password():\n    e05_private_state_root()\n    raw, _ = e05_read_stable_regular(\n        E05_SCHEMA_PASSWORD_FILE, 0o600, \'e05_schema_password\')\n    try:\n        value = raw.decode(\'utf-8\')\n    except UnicodeDecodeError:\n        return None\n    if not value or \'\\n\' in value or \'\\r\' in value:\n        return None\n    return value\n\n\ndef e05_schema_prerequisites():\n    missing = []\n    password = None\n    try:\n        parent = E05_SCHEMA_RUNNER.parent.lstat()\n        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_gid != 0\n                or parent.st_mode & 0o022):\n            raise SchemaIntegrationError(\'e05_schema_runner_parent_unsafe\', \'\')\n        runner_bytes, _ = e05_read_stable_regular(\n            E05_SCHEMA_RUNNER, 0o755, \'e05_schema_runner\')\n        if hashlib.sha256(runner_bytes).hexdigest() != E05_SCHEMA_RUNNER_SHA256:\n            missing.append(\'e05_schema_runner_digest_mismatch\')\n    except SchemaIntegrationError as exc:\n        missing.append(exc.code)\n    try:\n        password = protected_e05_schema_password()\n    except SchemaIntegrationError as exc:\n        missing.append(exc.code)\n    if password is None:\n        missing.append(\'e05_db_principal_or_protected_password_not_configured\')\n    return missing, password\n\n\ndef write_e05_schema_state(path, value, create=False):\n    write_schema_state(path, value, create=create)\n\n\ndef run_e05_schema_once(context, paths, admission, started_at):\n    prerequisites, password = e05_schema_prerequisites()\n    if prerequisites:\n        result = e05_schema_state(\n            context, \'blocked_precondition\', started_at,\n            activation_sha256=admission[\'sha256\'], finished_at=utc_timestamp(),\n            error=\'e05_schema_activation_prerequisites_missing\', prerequisites=prerequisites,\n            action=(\'install the byte-exact E05 runner as root:root 0755; provision fixed MySQL \'\n                    \'user cyf_e05_schema_runner with USAGE plus CREATE only on jia.agent_work_item_reassignment; \'\n                    \'provision root:root 0600 e05-schema-password under the root-only Flow state directory; \'\n                    \'then authorize an exact new Flow run\'))\n        write_e05_schema_state(paths[\'state\'], result)\n        print(json.dumps({\'e05_schema\': \'blocked_precondition\', \'result\': result},\n                         sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 1\n\n    running = e05_schema_state(\n        context, \'running\', started_at, activation_sha256=admission[\'sha256\'],\n        action=(\'release lock and installed record verified; if interrupted, inspect durable E05 \'\n                \'metadata and never rerun this same Flow release automatically\'),\n        stdout_path=str(paths[\'stdout\']), stderr_path=str(paths[\'stderr\']))\n    write_e05_schema_state(paths[\'state\'], running)\n    try:\n        assert_e05_activation_unchanged(admission)\n    except SchemaIntegrationError as exc:\n        result = e05_schema_state(\n            context, \'failed\', started_at, activation_sha256=admission[\'sha256\'],\n            finished_at=utc_timestamp(), runner_exit_code=1, error=exc.code,\n            action=exc.action, stdout_path=None, stderr_path=None)\n        write_e05_schema_state(paths[\'state\'], result)\n        print(json.dumps({\'e05_schema\': \'failed\', \'result\': result},\n                         sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 1\n\n    stdout_fd = os.open(str(paths[\'stdout\']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    stderr_fd = os.open(str(paths[\'stderr\']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    try:\n        child_env = {\n            \'PATH\': \'/usr/sbin:/usr/bin:/sbin:/bin\',\n            \'LC_ALL\': \'C\',\n            E05_SCHEMA_PASSWORD_ENV: password,\n        }\n        try:\n            completed = subprocess.run(\n                [str(E05_SCHEMA_RUNNER), \'--apply\'], env=child_env,\n                stdout=stdout_fd, stderr=stderr_fd, close_fds=True)\n            return_code = completed.returncode\n        except OSError:\n            return_code = 1\n            integration_error = SchemaIntegrationError(\n                \'e05_schema_runner_start_failed\',\n                \'repair the installed E05 runner and inspect durable schema state before a new Flow run\')\n        else:\n            integration_error = None\n        os.fsync(stdout_fd)\n        os.fsync(stderr_fd)\n    finally:\n        os.close(stdout_fd)\n        os.close(stderr_fd)\n        fsync_dir(E05_SCHEMA_RESULTS)\n\n    stdout_bytes = paths[\'stdout\'].read_bytes()\n    stderr_bytes = paths[\'stderr\'].read_bytes()\n    report = None\n    if integration_error is None:\n        try:\n            report = validate_e05_runner_report(stdout_bytes, return_code, context)\n        except SchemaIntegrationError as exc:\n            integration_error = exc\n    if integration_error is not None:\n        status = \'failed\'\n        error = integration_error.code\n        action = integration_error.action\n    elif return_code == 0:\n        status = \'pass\'\n        error = None\n        action = \'E05 schema is verified only; feature activation and authenticated acceptance remain separate\'\n    else:\n        status = \'failed\'\n        error = report[\'error\']\n        action = (\'inspect preserved E05 report/stdout/stderr and durable table metadata; \'\n                  \'do not drop or rerun this same Flow release automatically\')\n    result = e05_schema_state(\n        context, status, started_at, activation_sha256=admission[\'sha256\'],\n        finished_at=utc_timestamp(), runner_exit_code=return_code,\n        error=error, action=action, runner_report=report,\n        stdout_path=str(paths[\'stdout\']), stdout_sha256=hashlib.sha256(stdout_bytes).hexdigest(),\n        stderr_path=str(paths[\'stderr\']), stderr_sha256=hashlib.sha256(stderr_bytes).hexdigest())\n    write_e05_schema_state(paths[\'state\'], result)\n    print(json.dumps({\'e05_schema\': status, \'result\': result},\n                     sort_keys=True, separators=(\',\', \':\')), flush=True)\n    return return_code if status == \'pass\' or 0 < return_code < 256 else 1\n\n\ndef apply_e05_schema_after_install(context, admission):\n    ensure_e05_results_directory()\n    paths = e05_schema_paths(context[\'run_id\'])\n    existing = existing_e05_schema_result(paths, context)\n    if existing is not None:\n        return existing\n    started_at = utc_timestamp()\n    waiting = e05_schema_state(\n        context, \'running\', started_at, activation_sha256=admission[\'sha256\'],\n        action=(\'exact run admitted and waiting for the API release lock; interruption requires \'\n                \'manual durable-state inspection and never automatic same-run retry\'),\n        stdout_path=str(paths[\'stdout\']), stderr_path=str(paths[\'stderr\']))\n    write_e05_schema_state(paths[\'state\'], waiting, create=True)\n    try:\n        release_fd = acquire_e05_release_lock(E05_RELEASE_LOCK)\n    except SchemaIntegrationError as exc:\n        result = e05_schema_state(\n            context, \'failed\', started_at, activation_sha256=admission[\'sha256\'],\n            finished_at=utc_timestamp(), runner_exit_code=1,\n            error=exc.code, action=exc.action)\n        write_e05_schema_state(paths[\'state\'], result)\n        print(json.dumps({\'e05_schema\': \'failed\', \'result\': result},\n                         sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 1\n    try:\n        try:\n            load_installed_record(E05_SCHEMA_RECORD, context)\n        except SchemaIntegrationError as exc:\n            result = e05_schema_state(\n                context, \'failed\', started_at, activation_sha256=admission[\'sha256\'],\n                finished_at=utc_timestamp(), runner_exit_code=1,\n                error=exc.code, action=exc.action)\n            write_e05_schema_state(paths[\'state\'], result)\n            print(json.dumps({\'e05_schema\': \'failed\', \'result\': result},\n                             sort_keys=True, separators=(\',\', \':\')), flush=True)\n            return 1\n        return run_e05_schema_once(context, paths, admission, started_at)\n    finally:\n        os.close(release_fd)\n\n\ndef maybe_apply_e05_schema_after_install(context):\n    admission = load_e05_activation(context)\n    if admission is None:\n        print(json.dumps({\n            \'e05_schema\': \'not_admitted\',\n            \'pipeline_id\': context[\'pipeline_id\'],\n            \'run_id\': context[\'run_id\'],\n            \'reason\': \'root_only_exact_run_activation_missing\',\n            \'action\': \'no E05 runner was invoked; authorize fixed SQL for a source-verified Run before its hook, not final Flow SUCCESS\',\n        }, sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 0\n    if admission[\'status\'] != \'admitted\':\n        print(json.dumps({\n            \'e05_schema\': \'not_admitted\',\n            \'pipeline_id\': context[\'pipeline_id\'],\n            \'run_id\': context[\'run_id\'],\n            \'reason\': \'activation_is_for_a_different_exact_release\',\n            \'activation_sha256\': admission[\'sha256\'],\n            \'action\': \'no E05 runner was invoked; bind admission to the intended created Run/source/tree before its hook; never retry an attempted Run\',\n        }, sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 0\n    return apply_e05_schema_after_install(context, admission)\n\ndef installer_environment():\n    installer_env = dict(os.environ)\n    installer_env.pop(SCHEMA_PASSWORD_ENV, None)\n    installer_env.pop(E05_SCHEMA_PASSWORD_ENV, None)\n    return installer_env\n\n\ndef invoke_installer(installer):\n    # The coordinator stays alive holding its mutex. The installer owns the existing\n    # release lock through installed-record fsync; after it exits we reacquire that\n    # exact lock for F06 and then E05. Each fixed runner owns its own file/MySQL locks.\n    # Neither schema password may enter installer/lifecycle descendants (including the\n    # installed or restored JVM); each is passed only in its schema runner child env.\n    return_code = subprocess.run(\n        [installer], env=installer_environment(), close_fds=True).returncode\n    if return_code != 0 or _SCHEMA_CONTEXT is None:\n        return return_code\n    try:\n        f06_return_code = apply_schema_after_install(_SCHEMA_CONTEXT)\n    except SchemaIntegrationError as exc:\n        print(json.dumps({\n            \'f06_schema\': \'integration_blocked\',\n            \'pipeline_id\': _SCHEMA_CONTEXT[\'pipeline_id\'],\n            \'run_id\': _SCHEMA_CONTEXT[\'run_id\'],\n            \'error\': exc.code,\n            \'action\': exc.action,\n        }, sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 1\n    if f06_return_code != 0:\n        return f06_return_code\n    try:\n        return maybe_apply_e05_schema_after_install(_SCHEMA_CONTEXT)\n    except SchemaIntegrationError as exc:\n        print(json.dumps({\n            \'e05_schema\': \'integration_blocked\',\n            \'pipeline_id\': _SCHEMA_CONTEXT[\'pipeline_id\'],\n            \'run_id\': _SCHEMA_CONTEXT[\'run_id\'],\n            \'error\': exc.code,\n            \'action\': exc.action,\n        }, sort_keys=True, separators=(\',\', \':\')), flush=True)\n        return 1\n\n\n\ndef validate_versioned_release(version, artifact_sha256):\n    """Explicit release identity, not a time window or compatibility gate."""\n    if (not isinstance(version, str) or not version or version != version.strip()\n            or any(ord(char) < 32 or ord(char) == 127 for char in version)):\n        fail(\'explicit release version is required\')\n    if not isinstance(artifact_sha256, str) or not re.fullmatch(\'[0-9a-f]{64}\', artifact_sha256):\n        fail(\'expected release artifact SHA-256 is required\')\n    return version\n\n\n# LOCAL uses the same coordinator/installer state machine. These are closed\n# type/binding validators, NOT artifact admission, authorization creation, or\n# proof that a filesystem/database/runtime observation actually happened.\nLOCAL_SAFE_CODES = frozenset((\n    \'INPUT_INVALID\', \'PATH_UNSAFE\', \'SOURCE_IDENTITY_MISMATCH\', \'DIGEST_MISMATCH\',\n    \'AUTHORITY_INVALID\', \'MAINTENANCE_SCOPE_MISSING\', \'BUILD_EVIDENCE_INVALID\',\n    \'PUBLISHED_CLOSURE_INVALID\', \'PACKAGE_INVALID\', \'MANIFEST_METADATA_MISMATCH\',\n    \'HELPER_CATALOG_MISMATCH\', \'PRECONDITION_CHANGED\', \'FOREIGN_UNFINISHED_TRANSACTION\',\n    \'RECOVERY_BINDING_MISMATCH\', \'CANONICAL_GENERATION_CHANGED\',\n    \'SCHEMA_PREREQUISITE_MISSING\', \'SCHEMA_RESOURCE_MISMATCH\', \'SCHEMA_CATALOG_DRIFT\',\n    \'SCHEMA_RESULT_UNKNOWN\', \'SCHEMA_RECOVERY_NOT_AUTHORIZED\',\n    \'LIFECYCLE_STOP_UNPROVEN\', \'LIFECYCLE_HEALTH_FAILED\', \'DURABLE_RECORD_INCOMPLETE\',\n    \'IO_FAILURE\',\n))\nLOCAL_ID = re.compile(r\'^[A-Za-z0-9][A-Za-z0-9_.-]*$\')\nLOCAL_GIT = re.compile(r\'^[0-9a-f]{40}$\')\nLOCAL_STAMP = re.compile(r\'^[0-9]{8}T[0-9]{6}Z$\')\nLOCAL_SCOPE = \'canonical-api-versioned-install-v1\'\nLOCAL_AUTHORITY_ID = \'cyf-local-release-controller-v1\'\nLOCAL_RECOVERY_SCOPE = \'exact-record-only-no-new-release-no-inflight-replay\'\nLOCAL_MEMBERS = tuple(sorted(EXPECTED_MEMBERS))\nLOCAL_AGENT_MAPPER = \'BOOT-INF/lib/jia-agent-mapper-1.1.2-SNAPSHOT.jar\'\nLOCAL_CHAT_MAPPER = \'BOOT-INF/lib/jia-chat-mapper-1.1.2-SNAPSHOT.jar\'\nLOCAL_RESOURCES = (\n    (\'identity-baseline\', LOCAL_AGENT_MAPPER, \'db/schema.sql\'),\n    (\'identity-migration\', LOCAL_AGENT_MAPPER, \'db/agent-identity-schema.sql\'),\n    (\'runtime-installation-v1\', LOCAL_AGENT_MAPPER, \'db/agent-runtime-v1-schema.sql\'),\n    (\'runtime-session-fence-v1\', LOCAL_AGENT_MAPPER, \'db/agent-runtime-session-fence-v1.sql\'),\n    (\'command-transport-d06\', LOCAL_AGENT_MAPPER, \'db/agent-command-transport-schema.sql\'),\n    (\'execution-report-d02\', LOCAL_AGENT_MAPPER, \'db/agent-execution-report-v1.sql\'),\n    (\'owner-phase-a\', LOCAL_AGENT_MAPPER, \'db/single-tenant-task-owner-ddl.sql\'),\n    (\'chat-base\', LOCAL_CHAT_MAPPER, \'db/chat-deliberation-schema.sql\'),\n    (\'chat-migration-v2\', LOCAL_CHAT_MAPPER, \'db/chat-deliberation-v2-migration.sql\'),\n    (\'chat-typed-v1\', LOCAL_CHAT_MAPPER, \'db/chat-typed-deliberation-schema-v1.sql\'),\n)\nLOCAL_PROOF_REFS = (\'startupCatalogProof\', \'effectiveConfiguration\',\n                    \'applicationPrincipalProof\', \'boundedSchemaReceipt\')\nLOCAL_HELPER_PATHS = {\n    \'cyf-api-flow-deploy\': \'/usr/local/sbin/cyf-api-flow-deploy\',\n    \'cyf-api-flow-install\': \'/usr/local/sbin/cyf-api-flow-install\',\n    \'cyf-api-kit\': \'/usr/local/sbin/cyf-api-kit\',\n    \'cyf-api-additive-schema\': \'/usr/local/sbin/cyf-api-additive-schema\',\n    \'cyf-api-e05-additive-schema\': \'/usr/local/sbin/cyf-api-e05-additive-schema\',\n    \'admit-api-local.py\': \'/usr/local/libexec/cyf-api-local/admit-api-local.py\',\n}\nLOCAL_BINDING_KEYS = frozenset((\'source\', \'decision\', \'admission\', \'maintenanceAuthority\',\n    \'package\', \'payloads\', \'buildEvidence\', \'controllerVerification\', \'precondition\',\n    \'schemaPlan\', \'helperCatalog\', \'rollbackPolicy\'))\n\n\nclass LocalRejected(Exception):\n    def __init__(self, code):\n        if code not in LOCAL_SAFE_CODES:\n            code = \'INPUT_INVALID\'\n        self.code = code\n        Exception.__init__(self, code)\n\n\ndef local_need(condition, code=\'INPUT_INVALID\'):\n    if not condition:\n        raise LocalRejected(code)\n\n\ndef local_canonical(value):\n    try:\n        return (json.dumps(value, sort_keys=True, separators=(\',\', \':\'),\n                           allow_nan=False) + \'\\n\').encode(\'utf-8\')\n    except (TypeError, ValueError, UnicodeError, RecursionError):\n        raise LocalRejected(\'INPUT_INVALID\') from None\n\n\ndef local_json(data, code=\'INPUT_INVALID\'):\n    def pairs(items):\n        result = {}\n        for key, value in items:\n            local_need(key not in result, code)\n            result[key] = value\n        return result\n    def no_number(unused):\n        raise LocalRejected(code)\n    try:\n        return json.loads(data, object_pairs_hook=pairs, parse_float=no_number,\n                          parse_constant=no_number)\n    except (TypeError, ValueError, UnicodeError, RecursionError):\n        raise LocalRejected(code) from None\n\n\ndef local_exact(value, keys, code=\'INPUT_INVALID\'):\n    local_need(type(value) is dict and set(value) == set(keys), code)\n    return value\n\n\ndef local_hex(value, length=64, code=\'DIGEST_MISMATCH\'):\n    local_need(type(value) is str and re.fullmatch(\'[0-9a-f]{%d}\' % length, value), code)\n    return value\n\n\ndef local_token(value, code=\'SOURCE_IDENTITY_MISMATCH\'):\n    local_need(type(value) is str and LOCAL_ID.fullmatch(value), code)\n    return value\n\n\ndef local_path(value, code=\'PATH_UNSAFE\'):\n    local_need(type(value) is str and value.startswith(\'/\') and not value.startswith(\'//\')\n               and not any(ord(c) < 32 or ord(c) == 127 for c in value)\n               and \'\\\\\' not in value, code)\n    path = Path(value)\n    local_need(str(path) == value and all(p not in (\'.\', \'..\') for p in path.parts), code)\n    return path\n\n\ndef local_digest(value, code=\'DIGEST_MISMATCH\'):\n    local_exact(value, (\'sha256\', \'size\'), code)\n    local_hex(value[\'sha256\'], code=code)\n    local_need(type(value[\'size\']) is int and value[\'size\'] >= 0, code)\n    return value\n\n\ndef local_ref(value, code=\'PATH_UNSAFE\'):\n    local_exact(value, (\'path\', \'sha256\', \'size\'), code)\n    local_path(value[\'path\'], code)\n    local_digest({k: value[k] for k in (\'sha256\', \'size\')}, code)\n    return value\n\n\ndef local_identity(value):\n    local_exact(value, (\'version\', \'buildId\', \'commit\', \'tree\'), \'SOURCE_IDENTITY_MISMATCH\')\n    local_token(value[\'version\'])\n    local_token(value[\'buildId\'])\n    local_hex(value[\'commit\'], 40, \'SOURCE_IDENTITY_MISMATCH\')\n    local_hex(value[\'tree\'], 40, \'SOURCE_IDENTITY_MISMATCH\')\n    return value\n\n\ndef local_source(value):\n    local_exact(value, (\'kind\', \'identity\', \'batchId\'), \'SOURCE_IDENTITY_MISMATCH\')\n    local_need(value[\'kind\'] == \'local-build-v1\', \'SOURCE_IDENTITY_MISMATCH\')\n    local_identity(value[\'identity\'])\n    local_token(value[\'batchId\'])\n    return value\n\n\ndef local_payloads(value):\n    local_exact(value, LOCAL_MEMBERS, \'PACKAGE_INVALID\')\n    for name in LOCAL_MEMBERS:\n        local_digest(value[name], \'PACKAGE_INVALID\')\n        local_need(value[name][\'size\'] > 0, \'PACKAGE_INVALID\')\n    return value\n\n\ndef local_precondition(value):\n    local_exact(value, (\'canonicalJarSha256\', \'installedRecord\', \'approval\',\n        \'runtimeGeneration\', \'identityInventory\', \'inflightInventory\', \'schemaInventory\'),\n        \'PRECONDITION_CHANGED\')\n    local_hex(value[\'canonicalJarSha256\'], code=\'PRECONDITION_CHANGED\')\n    for name in (\'installedRecord\', \'approval\'):\n        if value[name] is not None:\n            local_ref(value[name], \'PRECONDITION_CHANGED\')\n    for name in (\'identityInventory\', \'inflightInventory\', \'schemaInventory\'):\n        local_ref(value[name], \'PRECONDITION_CHANGED\')\n    generation = local_exact(value[\'runtimeGeneration\'], (\'pid\', \'startTicks\', \'jarSha256\'),\n                             \'CANONICAL_GENERATION_CHANGED\')\n    local_need(type(generation[\'pid\']) is int and generation[\'pid\'] > 0\n        and type(generation[\'startTicks\']) is str\n        and re.fullmatch(r\'[1-9][0-9]*\', generation[\'startTicks\']),\n        \'CANONICAL_GENERATION_CHANGED\')\n    local_hex(generation[\'jarSha256\'], code=\'CANONICAL_GENERATION_CHANGED\')\n    local_need(generation[\'jarSha256\'] == value[\'canonicalJarSha256\'],\n               \'CANONICAL_GENERATION_CHANGED\')\n    return value\n\n\ndef local_rollback(value):\n    local_need(type(value) is str and value in (\'rollback-compatible\', \'forward-only\'),\n               \'AUTHORITY_INVALID\')\n    return value\n\n\ndef local_schema_plan(value):\n    local_exact(value, (\'format\', \'entries\', \'resourcePreconditions\', \'partialDdlPolicy\')\n                + LOCAL_PROOF_REFS, \'SCHEMA_PREREQUISITE_MISSING\')\n    local_need(value[\'format\'] == \'cyf-api-local-schema-plan-v1\'\n        and value[\'partialDdlPolicy\'] == \'introspect-equivalent-skip-missing-only-no-drop-no-ddl-rollback\',\n        \'SCHEMA_PREREQUISITE_MISSING\')\n    entries = value[\'entries\']\n    local_need(type(entries) is list and len(entries) == 2, \'SCHEMA_RESOURCE_MISMATCH\')\n    expected = (\n        (\'F06\', str(SCHEMA_RUNNER), \'db/agent-task-artifact-outcome-f06.sql\', SCHEMA_SQL_SHA256),\n        (\'E05\', str(E05_SCHEMA_RUNNER), \'db/agent-work-item-reassignment-e05.sql\', E05_SCHEMA_SQL_SHA256),\n    )\n    for entry, (feature, runner, inner, sql_sha) in zip(entries, expected):\n        local_exact(entry, (\'feature\', \'runner\', \'resourceOuter\', \'resourceInner\', \'sqlSha256\',\n                            \'statementPolicy\', \'expectedCatalogSha256\'), \'SCHEMA_RESOURCE_MISMATCH\')\n        local_ref(entry[\'runner\'], \'HELPER_CATALOG_MISMATCH\')\n        local_hex(entry[\'expectedCatalogSha256\'], code=\'SCHEMA_CATALOG_DRIFT\')\n        local_need(entry[\'feature\'] == feature and entry[\'runner\'][\'path\'] == runner\n            and entry[\'resourceOuter\'] == LOCAL_AGENT_MAPPER and entry[\'resourceInner\'] == inner\n            and entry[\'sqlSha256\'] == sql_sha\n            and entry[\'statementPolicy\'] == \'exact_create_table_if_not_exists_only\',\n            \'SCHEMA_RESOURCE_MISMATCH\')\n    resources = value[\'resourcePreconditions\']\n    local_need(type(resources) is list and len(resources) == len(LOCAL_RESOURCES),\n               \'SCHEMA_PREREQUISITE_MISSING\')\n    for entry, (name, outer, inner) in zip(resources, LOCAL_RESOURCES):\n        local_exact(entry, (\'name\', \'resourceOuter\', \'resourceInner\', \'sqlSha256\',\n                            \'expectedCatalogSha256\', \'actualSchemaProof\'),\n                    \'SCHEMA_PREREQUISITE_MISSING\')\n        local_need((entry[\'name\'], entry[\'resourceOuter\'], entry[\'resourceInner\']) == (name, outer, inner),\n                   \'SCHEMA_RESOURCE_MISMATCH\')\n        local_hex(entry[\'sqlSha256\'], code=\'SCHEMA_RESOURCE_MISMATCH\')\n        local_hex(entry[\'expectedCatalogSha256\'], code=\'SCHEMA_CATALOG_DRIFT\')\n        local_ref(entry[\'actualSchemaProof\'], \'SCHEMA_PREREQUISITE_MISSING\')\n    for name in LOCAL_PROOF_REFS:\n        local_ref(value[name], \'SCHEMA_PREREQUISITE_MISSING\')\n    return value\n\n\ndef local_helper_cata