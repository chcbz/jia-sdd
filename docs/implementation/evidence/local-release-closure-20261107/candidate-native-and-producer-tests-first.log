URABLE_RECORD_INCOMPLETE\')\n    return value\n\n\ndef local_publication_matches(decision, admitted, verified):\n    """Check projections only; the caller MUST first run the protected verifier.\n\n    Neither this comparison nor digest consistency authenticates build execution\n    or maintenance permission. No admitted artifact is rewritten to authorized.\n    """\n    local_install_decision(decision)\n    local_exact(admitted, (\'format\', \'status\', \'source\', \'authority\', \'package\', \'payloads\',\n                           \'evidence\', \'installPrecondition\', \'scope\', \'productionAuthorized\'),\n                \'PUBLISHED_CLOSURE_INVALID\')\n    local_need(admitted[\'format\'] == \'cyf-api-local-admitted-input-v1\'\n        and admitted[\'status\'] == \'admitted\' and admitted[\'scope\'] == \'artifact-admission-only\'\n        and admitted[\'productionAuthorized\'] is False, \'PUBLISHED_CLOSURE_INVALID\')\n    source = local_exact(admitted[\'source\'], (\'kind\', \'identity\'), \'SOURCE_IDENTITY_MISMATCH\')\n    local_identity(source[\'identity\'])\n    local_need(source == {k: decision[\'source\'][k] for k in (\'kind\', \'identity\')},\n               \'SOURCE_IDENTITY_MISMATCH\')\n    authority = local_exact(admitted[\'authority\'], (\'authorityId\', \'batchId\', \'batchAuthority\',\n                           \'trustedRecord\', \'verificationRecord\'), \'PUBLISHED_CLOSURE_INVALID\')\n    local_need(authority[\'authorityId\'] == LOCAL_AUTHORITY_ID\n        and authority[\'batchId\'] == decision[\'source\'][\'batchId\'], \'PUBLISHED_CLOSURE_INVALID\')\n    for name in (\'batchAuthority\', \'trustedRecord\', \'verificationRecord\'):\n        local_ref(authority[name], \'PUBLISHED_CLOSURE_INVALID\')\n    local_ref(admitted[\'package\'], \'PACKAGE_INVALID\')\n    local_need(decision[\'package\'] == {k: admitted[\'package\'][k] for k in (\'sha256\', \'size\')},\n               \'PACKAGE_INVALID\')\n    local_exact(admitted[\'payloads\'], LOCAL_MEMBERS, \'PACKAGE_INVALID\')\n    for name in LOCAL_MEMBERS:\n        local_ref(admitted[\'payloads\'][name], \'PACKAGE_INVALID\')\n        local_need(decision[\'payloads\'][name] == {k: admitted[\'payloads\'][name][k]\n                                                for k in (\'sha256\', \'size\')}, \'PACKAGE_INVALID\')\n    evidence = local_exact(admitted[\'evidence\'], (\'buildEvidence\', \'snapshots\'),\n                           \'BUILD_EVIDENCE_INVALID\')\n    local_ref(evidence[\'buildEvidence\'], \'BUILD_EVIDENCE_INVALID\')\n    local_need(decision[\'buildEvidence\'] == evidence[\'buildEvidence\']\n        and decision[\'controllerVerification\'] == authority[\'verificationRecord\'],\n        \'BUILD_EVIDENCE_INVALID\')\n    local_need(type(evidence[\'snapshots\']) is list and bool(evidence[\'snapshots\']),\n               \'BUILD_EVIDENCE_INVALID\')\n    original_paths, copied_paths = set(), set()\n    for snapshot in evidence[\'snapshots\']:\n        local_exact(snapshot, (\'role\', \'originalPath\', \'file\'), \'BUILD_EVIDENCE_INVALID\')\n        local_token(snapshot[\'role\'], \'BUILD_EVIDENCE_INVALID\')\n        local_path(snapshot[\'originalPath\'], \'BUILD_EVIDENCE_INVALID\')\n        local_ref(snapshot[\'file\'], \'BUILD_EVIDENCE_INVALID\')\n        local_need(snapshot[\'originalPath\'] not in original_paths and snapshot[\'file\'][\'path\'] not in copied_paths,\n                   \'BUILD_EVIDENCE_INVALID\')\n        original_paths.add(snapshot[\'originalPath\'])\n        copied_paths.add(snapshot[\'file\'][\'path\'])\n    local_exact(admitted[\'installPrecondition\'], (\'canonicalJarSha256\',), \'PRECONDITION_CHANGED\')\n    local_need(admitted[\'installPrecondition\'][\'canonicalJarSha256\'] ==\n               decision[\'precondition\'][\'canonicalJarSha256\'], \'PRECONDITION_CHANGED\')\n    local_exact(verified, (\'format\', \'status\', \'scope\', \'productionAuthorized\', \'admission\', \'source\'),\n                \'PUBLISHED_CLOSURE_INVALID\')\n    local_need(verified[\'format\'] == \'cyf-api-local-published-verification-v1\'\n        and verified[\'status\'] == \'verified\' and verified[\'scope\'] == \'artifact-admission-only\'\n        and verified[\'productionAuthorized\'] is False and verified[\'admission\'] == decision[\'admission\']\n        and verified[\'source\'] == source, \'PUBLISHED_CLOSURE_INVALID\')\n    return decision\n\n\ndef local_schema_recovery_authority(value, installed_binding):\n    local_exact(value, (\'format\', \'authorityId\', \'scope\', \'authorizationEvidence\', \'bindingSha256\',\n        \'installDecision\', \'priorResults\', \'actualMetadataProof\', \'allowedFeatures\', \'schemaPlan\',\n        \'canonicalJarSha256\', \'productionAuthorized\'), \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n    local_need(value[\'format\'] == \'cyf-api-local-schema-recovery-authority-v1\'\n        and value[\'authorityId\'] == LOCAL_AUTHORITY_ID\n        and value[\'scope\'] == \'exact-installed-release-partial-schema-reconcile\'\n        and value[\'productionAuthorized\'] is True, \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n    local_binding(installed_binding)\n    local_need(value[\'bindingSha256\'] == local_binding_sha(installed_binding)\n        and value[\'installDecision\'] == installed_binding[\'decision\']\n        and value[\'schemaPlan\'] == installed_binding[\'schemaPlan\']\n        and value[\'canonicalJarSha256\'] == installed_binding[\'payloads\'][\'application.jar\'][\'sha256\'],\n        \'RECOVERY_BINDING_MISMATCH\')\n    for name in (\'authorizationEvidence\', \'installDecision\', \'actualMetadataProof\', \'schemaPlan\'):\n        local_ref(value[name], \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n    features = value[\'allowedFeatures\']\n    local_need(type(features) is list and bool(features)\n        and features in ([\'F06\'], [\'E05\'], [\'F06\', \'E05\']), \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n    prior = value[\'priorResults\']\n    local_need(type(prior) is list and bool(prior), \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n    paths = set()\n    for ref in prior:\n        local_ref(ref, \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n        local_need(ref[\'path\'] not in paths, \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n        paths.add(ref[\'path\'])\n    return value\n\n\nLOCAL_ADMISSION_ROOT = Path(\'/var/lib/cyf-api-local-admission\')\n\n\ndef local_signature(info):\n    return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,\n            info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)\n\n\ndef local_directory_signature(info):\n    # Directory content timestamps may legitimately change during publication;\n    # ancestry inode, custody and mode must not change under a reader.\n    return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid)\n\n\nclass LocalReadSet:\n    """No-follow protected input reader with immutable byte/dentry closure.\n\n    No directory creation, writes, installer, SQL, service or environment-derived\n    trust roots. Current mutable slots must be observed separately under FD8;\n    precondition FileRefs are independent immutable observation copies.\n    """\n    def __init__(self):\n        self.saved = {}\n        self.inodes = {}\n\n    def _classification(self, path):\n        if str(path) in LOCAL_HELPER_PATHS.values():\n            return None, 0o755\n        for root in (ROOT, LOCAL_ADMISSION_ROOT):\n            if root in path.parents:\n                return root, 0o600\n        raise LocalRejected(\'PATH_UNSAFE\')\n\n    def _open(self, path, retain=True):\n        anchor, mode = self._classification(path)\n        directory = None\n        leaf = None\n        trail = []\n        try:\n            directory = os.open(\'/\', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)\n            current = Path(\'/\')\n            for component in (\'\',) + path.parent.parts[1:]:\n                if component:\n                    new = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,\n                                  dir_fd=directory)\n                    os.close(directory)\n                    directory = new\n                    current /= component\n                info = os.fstat(directory)\n                local_need(stat.S_ISDIR(info.st_mode) and info.st_uid == 0\n                    and not info.st_mode & 0o022, \'PATH_UNSAFE\')\n                if anchor is not None and (current == anchor or anchor in current.parents):\n                    local_need(stat.S_IMODE(info.st_mode) == 0o700, \'PATH_UNSAFE\')\n                trail.append((current, local_directory_signature(info)))\n            leaf = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,\n                           dir_fd=directory)\n            before = os.fstat(leaf)\n            local_need(stat.S_ISREG(before.st_mode) and before.st_uid == 0\n                and before.st_nlink == 1 and stat.S_IMODE(before.st_mode) == mode,\n                \'PATH_UNSAFE\')\n            if mode == 0o755:\n                local_need(before.st_gid == 0, \'PATH_UNSAFE\')\n            blocks = []\n            digest = hashlib.sha256()\n            length = 0\n            while True:\n                block = os.read(leaf, 1024 * 1024)\n                if not block:\n                    break\n                digest.update(block)\n                length += len(block)\n                if retain:\n                    blocks.append(block)\n            data = b\'\'.join(blocks) if retain else digest.hexdigest()\n            local_need(length == before.st_size, \'DIGEST_MISMATCH\')\n            after = os.fstat(leaf)\n            current_info = os.stat(path.name, dir_fd=directory, follow_symlinks=False)\n            local_need(local_signature(before) == local_signature(after) == local_signature(current_info),\n                       \'DIGEST_MISMATCH\')\n            for ancestor, expected in trail:\n                local_need(local_directory_signature(os.lstat(str(ancestor))) == expected, \'PATH_UNSAFE\')\n            identity = (before.st_dev, before.st_ino)\n            local_need(identity not in self.inodes or self.inodes[identity] == path, \'PATH_UNSAFE\')\n            previous = self.saved.get(path)\n            observation = (digest.hexdigest(), length, local_signature(before))\n            local_need(previous is None or previous == observation, \'DIGEST_MISMATCH\')\n            self.saved[path] = observation\n            self.inodes[identity] = path\n            os.lseek(leaf, 0, os.SEEK_SET)\n            result = (leaf, data, before.st_size)\n            leaf = None\n            return result\n        except OSError:\n            raise LocalRejected(\'PATH_UNSAFE\') from None\n        finally:\n            if leaf is not None:\n                os.close(leaf)\n            if directory is not None:\n                os.close(directory)\n\n    def checked(self, ref):\n        local_ref(ref)\n        fd, data, size = self._open(local_path(ref[\'path\']))\n        try:\n            local_need(size == ref[\'size\'] and hashlib.sha256(data).hexdigest() == ref[\'sha256\'],\n                       \'DIGEST_MISMATCH\')\n            return data\n        finally:\n            os.close(fd)\n\n    def stream(self, ref):\n        """Verify large immutable payload by digest; return this same rewound FD.\n\n        Package/JAR bytes are not retained in the closure\'s memory. Recheck still\n        binds the original inode, custody, size, timestamps and full SHA-256.\n        """\n        local_ref(ref)\n        fd, digest, size = self._open(local_path(ref[\'path\']), retain=False)\n        try:\n            local_need(size == ref[\'size\'] and digest == ref[\'sha256\'], \'DIGEST_MISMATCH\')\n        except BaseException:\n            os.close(fd)\n            raise\n        return fd\n\n    def external(self, path, expected_sha256):\n        """Only an external decision/authority digest, never a document self hash."""\n        path = local_path(path)\n        local_hex(expected_sha256)\n        local_need(str(path) not in LOCAL_HELPER_PATHS.values(), \'PATH_UNSAFE\')\n        fd, data, size = self._open(path)\n        try:\n            local_need(hashlib.sha256(data).hexdigest() == expected_sha256, \'DIGEST_MISMATCH\')\n            return data, {\'path\': str(path), \'sha256\': expected_sha256, \'size\': size}\n        finally:\n            os.close(fd)\n\n    def helper_fd(self, name, ref):\n        local_ref(ref, \'HELPER_CATALOG_MISMATCH\')\n        local_need(type(name) is str and name in LOCAL_HELPER_PATHS\n                   and ref[\'path\'] == LOCAL_HELPER_PATHS[name], \'HELPER_CATALOG_MISMATCH\')\n        fd, data, size = self._open(local_path(ref[\'path\']))\n        try:\n            local_need(size == ref[\'size\'] and hashlib.sha256(data).hexdigest() == ref[\'sha256\'],\n                       \'HELPER_CATALOG_MISMATCH\')\n        except BaseException:\n            os.close(fd)\n            raise\n        return fd  # caller must close; no pathname reopen between verification and exec\n\n    def recheck(self):\n        for path in list(self.saved):\n            fd, ignored_digest, ignored_size = self._open(path, retain=False)\n            os.close(fd)\n\n\ndef local_verify_publication(decision, catalog, reader):\n    """Call only the fixed protected artifact verifier via stable FD, read-only.\n\n    This verifies artifact/build execution evidence, not maintenance permission,\n    live database/configuration/principal readiness or business acceptance.\n    """\n    local_install_decision(decision)\n    local_helper_catalog(catalog)\n    admission = local_path(decision[\'admission\'][\'path\'])\n    local_need(admission.name == \'admission.json\'\n        and admission.parent.parent == LOCAL_ADMISSION_ROOT / \'admitted\', \'PUBLISHED_CLOSURE_INVALID\')\n    admitted = local_json(reader.checked(decision[\'admission\']), \'PUBLISHED_CLOSURE_INVALID\')\n    fd = reader.helper_fd(\'admit-api-local.py\', catalog[\'helpers\'][\'admit-api-local.py\'])\n    try:\n        try:\n            result = subprocess.run(\n                [\'/usr/bin/python3\', \'-I\', \'-B\', \'/proc/self/fd/\' + str(fd), \'--verify-published\',\n                 \'--trusted-root\', str(LOCAL_ADMISSION_ROOT), \'--admission\', str(admission),\n                 \'--admission-sha256\', decision[\'admission\'][\'sha256\']],\n                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n                env={\'PATH\': \'/usr/sbin:/usr/bin:/sbin:/bin\', \'LC_ALL\': \'C\'},\n                close_fds=True, pass_fds=(fd,))\n        except OSError:\n            raise LocalRejected(\'PUBLISHED_CLOSURE_INVALID\') from None\n    finally:\n        os.close(fd)\n    local_need(type(result.returncode) is int and result.returncode == 0, \'PUBLISHED_CLOSURE_INVALID\')\n    verified = local_json(result.stdout, \'PUBLISHED_CLOSURE_INVALID\')\n    local_publication_matches(decision, admitted, verified)\n    reader.recheck()\n    return admitted, verified\n\n\n\ndef local_stream_checked(reader, ref):\n    """Validate a large copied evidence/payload ref without retaining its bytes."""\n    fd = reader.stream(ref)\n    os.close(fd)\n\n\ndef local_verify_package_resources(admitted, plan, reader):\n    """Bind exact-five package, published payloads and all same-JAR SQL resources.\n\n    The protected original publication verifier authenticates build/manifests;\n    this additional read-only check binds the frozen SchemaPlan to actual nested\n    resource bytes. SQL hashes never stand in for live catalog or privilege proof.\n    """\n    seen = set()\n    fd = reader.stream(admitted[\'package\'])\n    try:\n        with os.fdopen(fd, \'rb\') as handle:\n            fd = None\n            with tarfile.open(fileobj=handle, mode=\'r|gz\') as archive:\n                for member in archive:\n                    name = member.name\n                    local_need(name in LOCAL_MEMBERS and name not in seen and member.isreg()\n                        and member.size > 0 and not member.sparse and not member.pax_headers,\n                        \'PACKAGE_INVALID\')\n                    ref = admitted[\'payloads\'][name]\n                    local_need(member.size == ref[\'size\'], \'PACKAGE_INVALID\')\n                    source = archive.extractfile(member)\n                    local_need(source is not None, \'PACKAGE_INVALID\')\n                    digest = hashlib.sha256()\n                    size = 0\n                    with source:\n                        for block in iter(lambda: source.read(1024 * 1024), b\'\'):\n                            digest.update(block)\n                            size += len(block)\n                    local_need(size == ref[\'size\'] and digest.hexdigest() == ref[\'sha256\'],\n                               \'PACKAGE_INVALID\')\n                    seen.add(name)\n        local_need(seen == set(LOCAL_MEMBERS), \'PACKAGE_INVALID\')\n    except (OSError, tarfile.TarError, EOFError, ValueError):\n        raise LocalRejected(\'PACKAGE_INVALID\') from None\n    finally:\n        if fd is not None:\n            os.close(fd)\n    for ref in admitted[\'payloads\'].values():\n        local_stream_checked(reader, ref)\n    fd = reader.stream(admitted[\'payloads\'][\'application.jar\'])\n    try:\n        with os.fdopen(fd, \'rb\') as handle:\n            fd = None\n            with zipfile.ZipFile(handle) as boot:\n                names = boot.namelist()\n                local_need(len(names) == len(set(names)), \'SCHEMA_RESOURCE_MISMATCH\')\n                for outer in (LOCAL_AGENT_MAPPER, LOCAL_CHAT_MAPPER):\n                    entries = [v for v in plan[\'entries\'] + plan[\'resourcePreconditions\']\n                               if v[\'resourceOuter\'] == outer]\n                    local_need(names.count(outer) == 1, \'SCHEMA_RESOURCE_MISMATCH\')\n                    with zipfile.ZipFile(io.BytesIO(boot.read(outer))) as nested:\n                        members = nested.namelist()\n                        local_need(len(members) == len(set(members)), \'SCHEMA_RESOURCE_MISMATCH\')\n                        for entry in entries:\n                            inner = entry[\'resourceInner\']\n                            local_need(members.count(inner) == 1\n                                and hashlib.sha256(nested.read(inner)).hexdigest() == entry[\'sqlSha256\'],\n                                \'SCHEMA_RESOURCE_MISMATCH\')\n    except (OSError, zipfile.BadZipFile, RuntimeError, KeyError, EOFError, ValueError):\n        raise LocalRejected(\'SCHEMA_RESOURCE_MISMATCH\') from None\n    finally:\n        if fd is not None:\n            os.close(fd)\n    reader.recheck()\n\n\ndef local_read_install_inputs(decision_path, decision_sha256):\n    """Read all immutable input refs, without observing/mutating transaction slots.\n\n    Used by read-only inspect and later by the sole original install transaction.\n    It does not create authority, approve incoming, query DB/config/health or prove\n    a current runtime/identity/inflight generation; those are install-time checks.\n    """\n    reader = LocalReadSet()\n    raw, ref = reader.external(decision_path, decision_sha256)\n    decision = local_install_decision(local_json(raw, \'AUTHORITY_INVALID\'))\n    authority = local_maintenance_authority(local_json(reader.checked(decision[\'maintenanceAuthority\']),\n                                                       \'AUTHORITY_INVALID\'))\n    local_authority_matches(decision, authority)\n    local_stream_checked(reader, authority[\'authorizationEvidence\'])\n    plan = local_schema_plan(local_json(reader.checked(decision[\'schemaPlan\']),\n                                       \'SCHEMA_PREREQUISITE_MISSING\'))\n    catalog = local_helper_catalog(local_json(reader.checked(decision[\'helperCatalog\']),\n                                             \'HELPER_CATALOG_MISMATCH\'))\n    local_need(catalog[\'helpers\'][\'cyf-api-e05-additive-schema\'][\'sha256\'] == E05_SCHEMA_RUNNER_SHA256,\n               \'HELPER_CATALOG_MISMATCH\')\n    for entry in plan[\'entries\']:\n        name = \'cyf-api-additive-schema\' if entry[\'feature\'] == \'F06\' else \'cyf-api-e05-additive-schema\'\n        local_need(entry[\'runner\'] == catalog[\'helpers\'][name], \'HELPER_CATALOG_MISMATCH\')\n    for name, helper in catalog[\'helpers\'].items():\n        fd = reader.helper_fd(name, helper)\n        os.close(fd)\n    for entry in plan[\'resourcePreconditions\']:\n        local_stream_checked(reader, entry[\'actualSchemaProof\'])\n    for name in LOCAL_PROOF_REFS:\n        local_stream_checked(reader, plan[name])\n    for name, observation in decision[\'precondition\'].items():\n        if name in (\'installedRecord\', \'approval\', \'identityInventory\', \'inflightInventory\', \'schemaInventory\') \\\n                and observation is not None:\n            local_stream_checked(reader, observation)\n    admitted, verified = local_verify_publication(decision, catalog, reader)\n    for name in (\'batchAuthority\', \'trustedRecord\', \'verificationRecord\'):\n        local_stream_checked(reader, admitted[\'authority\'][name])\n    local_stream_checked(reader, admitted[\'evidence\'][\'buildEvidence\'])\n    for snapshot in admitted[\'evidence\'][\'snapshots\']:\n        local_stream_checked(reader, snapshot[\'file\'])\n    local_verify_package_resources(admitted, plan, reader)\n    reader.recheck()\n    binding = local_binding_from_decision(decision, ref)\n    return {\'decision\': decision, \'decisionRef\': ref, \'authority\': authority,\n            \'schemaPlan\': plan, \'helperCatalog\': catalog, \'admitted\': admitted,\n            \'verified\': verified, \'release\': binding, \'reader\': reader}\n\n\ndef local_inspect(decision_path, decision_sha256):\n    inputs = local_read_install_inputs(decision_path, decision_sha256)\n    return {\'status\': \'inputs_verified\', \'scope\': \'read-only-source-inspection\',\n            \'source\': inputs[\'decision\'][\'source\'], \'binding_sha256\': local_binding_sha(inputs[\'release\']),\n            \'productionAuthorized\': False, \'installation\': \'NOT_RUN\',\n            \'runtimeReadiness\': \'NOT_MEASURED\', \'businessAcceptance\': \'NOT_RUN\'}\n\n\nLOCAL_CANONICAL_JAR = Path(\'/home/isp/hosts/cyf/api/cyf-api-kit.jar\')\nLOCAL_RUNTIME_RECORD = Path(\'/run/cyf-api/cyf-api-kit.runtime\')\n\n\ndef local_read_slot(path, uid=0, mode=0o600):\n    """Mutable transaction slot, observed only while holding the original FD8."""\n    try:\n        info = path.lstat()\n    except FileNotFoundError:\n        return None\n    local_need(stat.S_ISREG(info.st_mode) and info.st_uid == uid and info.st_nlink == 1\n        and stat.S_IMODE(info.st_mode) == mode, \'PATH_UNSAFE\')\n    fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)\n    try:\n        opened = os.fstat(fd)\n        local_need(local_signature(opened) == local_signature(info), \'PRECONDITION_CHANGED\')\n        with os.fdopen(os.dup(fd), \'rb\') as stream:\n            data = stream.read()\n        local_need(local_signature(os.fstat(fd)) == local_signature(opened)\n            == local_signature(path.lstat()), \'PRECONDITION_CHANGED\')\n        return data\n    finally:\n        os.close(fd)\n\n\ndef local_slot_matches(raw, expected):\n    if expected is None:\n        local_need(raw is None, \'PRECONDITION_CHANGED\')\n    else:\n        local_need(raw is not None and len(raw) == expected[\'size\']\n            and hashlib.sha256(raw).hexdigest() == expected[\'sha256\'], \'PRECONDITION_CHANGED\')\n\n\ndef local_assert_runtime_generation(expected, jar_path):\n    """Actual current process and kit attestation, not an inferred future PID."""\n    raw = local_read_slot(LOCAL_RUNTIME_RECORD, mode=0o644)\n    local_need(raw is not None, \'CANONICAL_GENERATION_CHANGED\')\n    try:\n        lines = raw.decode(\'ascii\').splitlines()\n        observed = {}\n        for line in lines:\n            key, value = line.split(\'=\', 1)\n            local_need(key not in observed, \'CANONICAL_GENERATION_CHANGED\')\n            observed[key] = value\n        local_need(observed == {\'pid\': str(expected[\'pid\']), \'start_ticks\': expected[\'startTicks\'],\n                               \'jar_sha256\': expected[\'jarSha256\']}, \'CANONICAL_GENERATION_CHANGED\')\n        proc = Path(\'/proc\') / str(expected[\'pid\'])\n        before = (proc / \'stat\').read_bytes()\n        fields = before[before.rfind(b\')\') + 2:].split()\n        local_need(fields[19].decode(\'ascii\') == expected[\'startTicks\'] and fields[0] != b\'Z\',\n                   \'CANONICAL_GENERATION_CHANGED\')\n        args = (proc / \'cmdline\').read_bytes().split(b\'\\0\')\n        marker = args.index(b\'-jar\')\n        local_need(args[marker + 1] == os.fsencode(str(jar_path))\n            and os.readlink(str(proc / \'cwd\')) == str(jar_path.parent), \'CANONICAL_GENERATION_CHANGED\')\n        after = (proc / \'stat\').read_bytes()\n        local_need(after[after.rfind(b\')\') + 2:].split()[19].decode(\'ascii\') == expected[\'startTicks\'],\n                   \'CANONICAL_GENERATION_CHANGED\')\n    except (OSError, UnicodeError, ValueError, IndexError):\n        raise LocalRejected(\'CANONICAL_GENERATION_CHANGED\') from None\n\n\ndef local_assert_new_generation(inputs, record_path, jar_path, approval_already_staged=None):\n    precondition = inputs[\'decision\'][\'precondition\']\n    for key in (\'installedRecord\', \'approval\'):\n        ref = precondition[key]\n        local_need(ref is None or ref[\'path\'] not in (\n            str(record_path), str(record_path.parent / \'approval.json\')), \'PATH_UNSAFE\')\n    raw_record = local_read_slot(record_path)\n    local_slot_matches(raw_record, precondition[\'installedRecord\'])\n    if raw_record is not None:\n        record = local_json(raw_record, \'DURABLE_RECORD_INCOMPLETE\')\n        local_need(type(record) is dict and record.get(\'status\') in (\'installed\', \'failed\'),\n                   \'FOREIGN_UNFINISHED_TRANSACTION\')\n        local_need(record.get(\'recovery\') != \'forward_only_candidate_retained\',\n                   \'FOREIGN_UNFINISHED_TRANSACTION\')\n    raw_approval = local_read_slot(record_path.parent / \'approval.json\')\n    if approval_already_staged is None:\n        local_slot_matches(raw_approval, precondition[\'approval\'])\n    else:\n        local_need(raw_approval is not None, \'PRECONDITION_CHANGED\')\n        local_need(local_approval(local_json(raw_approval)) == approval_already_staged\n            and approval_already_staged[\'release\'] == inputs[\'release\']\n            and not approval_already_staged[\'consumed\'], \'RECOVERY_BINDING_MISMATCH\')\n    # Canonical bytes are streamed rather than loading the full JAR into memory.\n    info = jar_path.lstat()\n    local_need(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_nlink == 1\n        and not info.st_mode & 0o022, \'PATH_UNSAFE\')\n    fd = os.open(str(jar_path), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)\n    try:\n        local_need(local_signature(os.fstat(fd)) == local_signature(info), \'PRECONDITION_CHANGED\')\n        with os.fdopen(os.dup(fd), \'rb\') as handle:\n            actual = digest_fileobj(handle)\n        local_need(actual == precondition[\'canonicalJarSha256\']\n            and local_signature(os.fstat(fd)) == local_signature(jar_path.lstat())\n                == local_signature(info), \'PRECONDITION_CHANGED\')\n    finally:\n        os.close(fd)\n    local_assert_runtime_generation(precondition[\'runtimeGeneration\'], jar_path)\n    inputs[\'reader\'].recheck()\n\n\ndef local_validate_slots(inputs):\n    """Resume only the same full LOCAL binding. Foreign nonterminal is never adopted."""\n    record_path = ROOT / \'record.json\'\n    record_raw, approval_raw = local_read_slot(record_path), local_read_slot(APPROVAL)\n    record = None if record_raw is None else local_json(record_raw, \'DURABLE_RECORD_INCOMPLETE\')\n    approval = None if approval_raw is None else local_json(approval_raw, \'DURABLE_RECORD_INCOMPLETE\')\n    binding = local_binding_sha(inputs[\'release\'])\n    if record is not None:\n        local_need(type(record) is dict, \'DURABLE_RECORD_INCOMPLETE\')\n        if record.get(\'schema_version\') == 3:\n            local_install_record(record)\n            if record[\'binding_sha256\'] == binding:\n                local_need(approval is not None and local_approval(approval)[\'release\'] == inputs[\'release\'],\n                           \'RECOVERY_BINDING_MISMATCH\')\n                return True\n        local_need(record.get(\'status\') in (\'installed\', \'failed\')\n            and record.get(\'recovery\') != \'forward_only_candidate_retained\',\n            \'FOREIGN_UNFINISHED_TRANSACTION\')\n    staged = None\n    if type(approval) is dict and approval.get(\'schema_version\') == 3:\n        local_approval(approval)\n        if approval[\'binding_sha256\'] == binding:\n            local_need(not approval[\'consumed\'], \'RECOVERY_BINDING_MISMATCH\')\n            staged = approval\n    local_assert_new_generation(inputs, record_path, LOCAL_CANONICAL_JAR, staged)\n    return staged is not None\n\n\ndef local_copy_incoming(inputs):\n    admitted = inputs[\'admitted\']\n    reader = inputs[\'reader\']\n    source_fd = reader.stream(admitted[\'package\'])\n    temporary = None\n    try:\n        fd, temporary = tempfile.mkstemp(prefix=\'.incoming-local-\', dir=str(PACKAGE.parent))\n        with os.fdopen(fd, \'wb\') as out, os.fdopen(os.dup(source_fd), \'rb\') as src:\n            shutil.copyfileobj(src, out, 1024 * 1024)\n            out.flush()\n            os.fsync(out.fileno())\n        local_need(Path(temporary).stat().st_size == inputs[\'decision\'][\'package\'][\'size\'], \'PACKAGE_INVALID\')\n        with open(temporary, \'rb\') as stream:\n            local_need(digest_fileobj(stream) == inputs[\'decision\'][\'package\'][\'sha256\'], \'PACKAGE_INVALID\')\n        reader.recheck()\n        os.replace(temporary, PACKAGE)\n        temporary = None\n        fsync_dir(PACKAGE.parent)\n    finally:\n        os.close(source_fd)\n        if temporary is not None:\n            os.unlink(temporary)\n\n\ndef local_prepare_approval(inputs):\n    release = inputs[\'release\']\n    approval = local_approval({\'schema_version\': 3, \'release\': release,\n        \'binding_sha256\': local_binding_sha(release), \'consumed\': False, \'consumed_at\': None})\n    old = local_read_slot(APPROVAL)\n    if old is not None:\n        # Preserve the existing backup directory/alias and immutable old approval.\n        stamp = datetime.now(timezone.utc).strftime(\'%Y%m%dT%H%M%S.%fZ\')\n        path = BACKUPS / (\'approval-before-local-\' + approval[\'binding_sha256\'] + \'-\' + stamp + \'.json\')\n        fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n        try:\n            with os.fdopen(fd, \'wb\') as out:\n                out.write(old); out.flush(); os.fsync(out.fileno())\n        finally:\n            fsync_dir(BACKUPS)\n    atomic_write(APPROVAL, local_canonical(approval))\n    return approval\n\n\ndef local_coordinator_lock():\n    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)\n    try:\n        info = os.fstat(fd)\n        local_need(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_nlink == 1\n            and stat.S_IMODE(info.st_mode) == 0o600\n            and local_signature(info) == local_signature(os.lstat(LOCK)), \'PATH_UNSAFE\')\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        return fd\n    except BaseException:\n        os.close(fd)\n        raise\n\n\ndef local_installed_release(inputs):\n    raw = local_read_slot(ROOT / \'record.json\')\n    local_need(raw is not None, \'DURABLE_RECORD_INCOMPLETE\')\n    record = local_install_record(local_json(raw))\n    local_need(record[\'release\'] == inputs[\'release\'] and record[\'status\'] == \'installed\'\n        and record[\'phase\'] == \'installed\' and record[\'recovery\'] == \'not_required\'\n        and record[\'candidate_stop_rc\'] == 0, \'RECOVERY_BINDING_MISMATCH\')\n    approval_raw = local_read_slot(APPROVAL)\n    local_need(approval_raw is not None, \'DURABLE_RECORD_INCOMPLETE\')\n    approval = local_approval(local_json(approval_raw))\n    local_need(approval[\'release\'] == inputs[\'release\'] and approval[\'consumed\'], \'RECOVERY_BINDING_MISMATCH\')\n    info = LOCAL_CANONICAL_JAR.lstat()\n    local_need(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_nlink == 1\n        and not info.st_mode & 0o022, \'PATH_UNSAFE\')\n    fd = os.open(str(LOCAL_CANONICAL_JAR), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)\n    try:\n        with os.fdopen(os.dup(fd), \'rb\') as stream:\n            local_need(digest_fileobj(stream) == record[\'candidate_sha256\']\n                and local_signature(info) == local_signature(os.fstat(fd))\n                    == local_signature(LOCAL_CANONICAL_JAR.lstat()), \'PRECONDITION_CHANGED\')\n    finally:\n        os.close(fd)\n    inputs[\'reader\'].recheck()\n    return record\n\n\ndef local_schema_report(raw, return_code, inputs, entry):\n    report = local_json(raw, \'SCHEMA_RESULT_UNKNOWN\')\n    local_exact(report, (\'schema_version\', \'operation\', \'status\', \'transaction_model\', \'lock_order\',\n        \'tables\', \'binding\', \'candidate\', \'error\', \'failed_table\'), \'SCHEMA_RESULT_UNKNOWN\')\n    feature = entry[\'feature\']\n    tables = tuple(sorted(SCHEMA_TABLES)) if feature == \'F06\' else (E05_SCHEMA_TABLE,)\n    release = inputs[\'release\']\n    expected_binding = {\'source\': release[\'source\'], \'binding_sha256\': local_binding_sha(release),\n        \'decision_sha256\': release[\'decision\'][\'sha256\'],\n        \'jar_sha256\': release[\'payloads\'][\'application.jar\'][\'sha256\'],\n        \'receipt_sha256\': release[\'payloads\'][\'receipt.json\'][\'sha256\'],\n        \'package_sha256\': release[\'package\'][\'sha256\']}\n    expected_candidate = {\'resource_outer\': entry[\'resourceOuter\'], \'resource_inner\': entry[\'resourceInner\'],\n        \'sql_sha256\': entry[\'sqlSha256\'], \'expected_catalog_sha256\': entry[\'expectedCatalogSha256\'],\n        \'tables\': list(tables), \'statement_policy\': entry[\'statementPolicy\']}\n    local_need(type(report[\'schema_version\']) is int and report[\'schema_version\'] == 2\n        and report[\'operation\'] == \'apply\'\n        and report[\'transaction_model\'] == \'mysql_ddl_autocommit_per_create_no_rollback_or_drop\'\n        and report[\'lock_order\'] == [feature.lower() + \'_runner_file_lock\', feature.lower() + \'_mysql_named_lock\']\n        and report[\'binding\'] == expected_binding and report[\'candidate\'] == expected_candidate,\n        \'SCHEMA_RESULT_UNKNOWN\')\n    local_exact(report[\'tables\'], tables, \'SCHEMA_RESULT_UNKNOWN\')\n    for name, result in report[\'tables\'].items():\n        local_exact(result, (\'status\', \'mismatches\'), \'SCHEMA_RESULT_UNKNOWN\')\n        local_need(type(result[\'status\']) is str and re.fullmatch(r\'[a-z0-9_]+\', result[\'status\'])\n            and type(result[\'mismatches\']) is list\n            and all(type(v) is str and re.fullmatch(r\'[a-z0-9_]+(?::[a-z0-9_]+)?\', v) for v in result[\'mismatches\']),\n            \'SCHEMA_RESULT_UNKNOWN\')\n    local_need(type(return_code) is int and 0 <= return_code <= 255, \'SCHEMA_RESULT_UNKNOWN\')\n    if return_code == 0:\n        local_need(report[\'status\'] == \'pass\' and report[\'error\'] is None and report[\'failed_table\'] is None\n            and all(r[\'status\'] in (\'existing_equivalent\', \'created_equivalent\')\n                    and r[\'mismatches\'] == [] for r in report[\'tables\'].values()), \'SCHEMA_RESULT_UNKNOWN\')\n    else:\n        local_need(report[\'status\'] == \'failed\' and type(report[\'error\']) is str\n            and re.fullmatch(r\'[a-z0-9_]+\', report[\'error\'])\n            and (report[\'failed_table\'] is None or report[\'failed_table\'] in tables), \'SCHEMA_RESULT_UNKNOWN\')\n    return report\n\n\ndef local_schema_state(inputs, entry, recovery_sha=None):\n    release = inputs[\'release\']; feature = entry[\'feature\']\n    return {\'schema_version\': 2, \'feature\': \'M4-\' + feature + \'-additive-schema\', \'status\': \'running\',\n        \'source\': release[\'source\'], \'binding_sha256\': local_binding_sha(release),\n        \'decision_sha256\': release[\'decision\'][\'sha256\'], \'schema_plan_sha256\': release[\'schemaPlan\'][\'sha256\'],\n        \'admission_sha256\': release[\'admission\'][\'sha256\'],\n        \'activation_claim\': \'schema_only_not_feature_activation\', \'sql_sha256\': entry[\'sqlSha256\'],\n        \'runner_path\': entry[\'runner\'][\'path\'], \'runner_sha256\': entry[\'runner\'][\'sha256\'],\n        \'expected_catalog_sha256\': entry[\'expectedCatalogSha256\'], \'started_at\': utc_timestamp(),\n        \'finished_at\': None, \'runner_exit_code\': None, \'error\': None, \'action\': None,\n        \'prerequisites\': [], \'runner_report\': None,\n        \'stdout_path\': None, \'stdout_sha256\': None, \'stderr_path\': None, \'stderr_sha256\': None,\n        \'lock_order\': [\'flow_coordinator_lock\', \'api_release_lock\',\n                       feature.lower() + \'_runner_file_lock\', feature.lower() + \'_mysql_named_lock\'],\n        \'transaction_model\': \'installed_record_then_mysql_ddl_autocommit_no_rollback_or_drop\',\n        \'recovery_authority_sha256\': recovery_sha}\n\n\ndef local_schema_paths(inputs, entry, recovery_sha=None):\n    folder = SCHEMA_RESULTS if entry[\'feature\'] == \'F06\' else E05_SCHEMA_RESULTS\n    stem = \'local-\' + local_binding_sha(inputs[\'release\'])\n    if recovery_sha is not None:\n        local_hex(recovery_sha, code=\'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n        stem += \'-recovery-\' + recovery_sha\n    return {key: folder / (stem + ext) for key, ext in (\n        (\'state\', \'.json\'), (\'stdout\', \'.stdout\'), (\'stderr\', \'.stderr\'))}\n\n\ndef local_state_ref(path):\n    raw = local_read_slot(path)\n    local_need(raw is not None, \'SCHEMA_RESULT_UNKNOWN\')\n    return {\'path\': str(path), \'sha256\': hashlib.sha256(raw).hexdigest(), \'size\': len(raw)}\n\n\ndef local_existing_schema(inputs, entry, paths, recovery_sha=None):\n    raw = local_read_slot(paths[\'state\'])\n    if raw is None:\n        local_need(not any(p.exists() or p.is_symlink() for k, p in paths.items() if k != \'state\'),\n                   \'SCHEMA_RESULT_UNKNOWN\')\n        return None\n    state = local_json(raw, \'SCHEMA_RESULT_UNKNOWN\')\n    expected = local_schema_state(inputs, entry, recovery_sha)\n    local_exact(state, expected, \'SCHEMA_RESULT_UNKNOWN\')\n    mutable = {\'status\', \'started_at\', \'finished_at\', \'runner_exit_code\', \'error\', \'action\', \'prerequisites\',\n               \'runner_report\', \'stdout_path\', \'stdout_sha256\', \'stderr_path\', \'stderr_sha256\'}\n    local_need(all(state[k] == expected[k] for k in expected if k not in mutable)\n        and state[\'status\'] in (\'running\', \'pass\', \'failed\', \'blocked_precondition\'), \'RECOVERY_BINDING_MISMATCH\')\n    local_need(type(state[\'started_at\']) is str and bool(state[\'started_at\'])\n        and (state[\'finished_at\'] is None or type(state[\'finished_at\']) is str)\n        and (state[\'runner_exit_code\'] is None or type(state[\'runner_exit_code\']) is int\n             and 0 <= state[\'runner_exit_code\'] <= 255)\n        and (state[\'error\'] is None or state[\'error\'] in LOCAL_SAFE_CODES)\n        and (state[\'action\'] is None or type(state[\'action\']) is str)\n        and type(state[\'prerequisites\']) is list\n        and all(type(v) is str and re.fullmatch(r\'[a-z0-9_]+\', v) for v in state[\'prerequisites\']),\n        \'SCHEMA_RESULT_UNKNOWN\')\n    for stream in (\'stdout\', \'stderr\'):\n        name, digest = state[stream + \'_path\'], state[stream + \'_sha256\']\n        if name is not None:\n            local_need(name == str(paths[stream]), \'SCHEMA_RESULT_UNKNOWN\')\n            raw_log = local_read_slot(paths[stream])\n            local_need(raw_log is not None, \'SCHEMA_RESULT_UNKNOWN\')\n            if digest is not None:\n                local_need(hashlib.sha256(raw_log).hexdigest() == digest, \'SCHEMA_RESULT_UNKNOWN\')\n    if state[\'status\'] == \'pass\':\n        local_need(type(state[\'runner_exit_code\']) is int and state[\'runner_exit_code\'] == 0\n            and state[\'error\'] is None and state[\'finished_at\'] is not None\n            and all(state[k] is not None for k in (\'stdout_path\', \'stdout_sha256\', \'stderr_path\', \'stderr_sha256\')),\n            \'SCHEMA_RESULT_UNKNOWN\')\n        report = local_schema_report(local_read_slot(paths[\'stdout\']), 0, inputs, entry)\n        local_need(state[\'runner_report\'] == report, \'SCHEMA_RESULT_UNKNOWN\')\n    return state\n\n\ndef local_run_schema_once(inputs, entry, paths, recovery_sha=None):\n    existing = local_existing_schema(inputs, entry, paths, recovery_sha)\n    if existing is not None:\n        # Running/failed/blocked is NOT automatically rerun; separate recovery\n        # permission creates a new evidence generation, retaining all old files.\n        return existing\n    folder = paths[\'state\'].parent\n    ensure_private_directory(folder)\n    local_need(folder.stat().st_gid == 0, \'PATH_UNSAFE\')\n    state = local_schema_state(inputs, entry, recovery_sha)\n    write_schema_state(paths[\'state\'], state, create=True)\n    password = protected_schema_password() if entry[\'feature\'] == \'F06\' else protected_e05_schema_password()\n    if type(password) is not str or not password or \'\\n\' in password or \'\\r\' in password:\n        state.update(status=\'blocked_precondition\', finished_at=utc_timestamp(),\n            error=\'SCHEMA_PREREQUISITE_MISSING\', prerequisites=[\'protected_feature_password_missing\'],\n            action=\'Provision the fixed CREATE-only principal; separately authorize same-release schema reconciliation.\')\n        write_schema_state(paths[\'state\'], state)\n        return state\n    state.update(stdout_path=str(paths[\'stdout\']), stderr_path=str(paths[\'stderr\']))\n    # Publish files BEFORE announcing them in the state. A crash remains unknown,\n    # never pass; the original running record still survives for reconciliation.\n    out = os.open(str(paths[\'stdout\']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    err = None; helper = None; return_code = None; report = None; error = None\n    try:\n        err = os.open(str(paths[\'stderr\']), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n        write_schema_state(paths[\'state\'], state)\n        local_installed_release(inputs)\n        name = \'cyf-api-additive-schema\' if entry[\'feature\'] == \'F06\' else \'cyf-api-e05-additive-schema\'\n        helper = inputs[\'reader\'].helper_fd(name, entry[\'runner\'])\n        inputs[\'reader\'].recheck()\n        password_key = SCHEMA_PASSWORD_ENV if entry[\'feature\'] == \'F06\' else E05_SCHEMA_PASSWORD_ENV\n        env = {\'PATH\': \'/usr/sbin:/usr/bin:/sbin:/bin\', \'LC_ALL\': \'C\', password_key: password}\n        try:\n            return_code = subprocess.run([\'/usr/bin/python3\', \'-I\', \'-B\', \'/proc/self/fd/\' + str(helper), \'--apply\'],\n                env=env, stdout=out, stderr=err, pass_fds=(helper,), close_fds=True).returncode\n        except OSError:\n            error = \'IO_FAILURE\'\n        os.fsync(out); os.fsync(err)\n        if error is None:\n            try:\n                report = local_schema_report(local_read_slot(paths[\'stdout\']), return_code, inputs, entry)\n                local_installed_release(inputs)\n            except LocalRejected as exc:\n                error = exc.code\n    finally:\n        if helper is not None: os.close(helper)\n        os.close(out)\n        if err is not None: os.close(err)\n        fsync_dir(folder)\n    state.update(status=\'pass\' if error is None and return_code == 0 else \'failed\',\n        finished_at=utc_timestamp(), runner_exit_code=return_code,\n        error=error if error is not None else (None if return_code == 0 else \'SCHEMA_CATALOG_DRIFT\'),\n        action=None if error is None and return_code == 0 else\n            \'Preserve candidate and all DDL evidence; introspect actual metadata and separately authorize exact schema reconciliation.\',\n        runner_report=report,\n        stdout_sha256=local_state_ref(paths[\'stdout\'])[\'sha256\'], stderr_sha256=local_state_ref(paths[\'stderr\'])[\'sha256\'])\n    write_schema_state(paths[\'state\'], state)\n    return state\n\n\ndef local_release_summary(inputs, installer_exit_code, schema_results, status):\n    release = inputs[\'release\']\n    return {\'schema_version\': 2, \'source\': release[\'source\'], \'binding_sha256\': local_binding_sha(release),\n        \'version\': release[\'source\'][\'identity\'][\'version\'], \'package_sha256\': release[\'package\'][\'sha256\'],\n        \'jar_sha256\': release[\'payloads\'][\'application.jar\'][\'sha256\'],\n        \'receipt_sha256\': release[\'payloads\'][\'receipt.json\'][\'sha256\'],\n        \'installer_exit_code\': installer_exit_code, \'schema_results\': schema_results,\n        \'status\': status, \'businessAcceptance\': \'NOT_RUN\'}\n\n\ndef local_summary_path(inputs):\n    return ROOT / (\'versioned-release-local-\' + local_binding_sha(inputs[\'release\']) + \'.json\')\n\n\ndef local_latest_schema(inputs, entry):\n    paths = local_schema_paths(inputs, entry)\n    raw = local_read_slot(local_summary_path(inputs))\n    if raw is not None:\n        summary = local_json(raw, \'SCHEMA_RESULT_UNKNOWN\')\n        expected = local_release_summary(inputs, None, None, \'prepared\')\n        local_exact(summary, expected, \'SCHEMA_RESULT_UNKNOWN\')\n        local_need(all(summary[k] == expected[k] for k in expected\n            if k not in (\'installer_exit_code\', \'schema_results\', \'status\')), \'RECOVERY_BINDING_MISMATCH\')\n        local_need(summary[\'status\'] in (\'prepared\', \'verified\', \'failed\')\n            and (summary[\'installer_exit_code\'] is None\n                 or type(summary[\'installer_exit_code\']) is int and 0 <= summary[\'installer_exit_code\'] <= 255),\n            \'SCHEMA_RESULT_UNKNOWN\')\n        refs = summary[\'schema_results\']\n        if refs is not None:\n            local_need(type(refs) is list and len(refs) == 2, \'SCHEMA_RESULT_UNKNOWN\')\n            ref = refs[0 if entry[\'feature\'] == \'F06\' else 1]\n            if ref is not None:\n                local_ref(ref, \'SCHEMA_RESULT_UNKNOWN\')\n                path = Path(ref[\'path\'])\n                prefix = paths[\'state\'].stem\n                local_need(path.parent == paths[\'state\'].parent and path.suffix == \'.json\'\n                    and (path.stem == prefix or re.fullmatch(re.escape(prefix) + r\'-recovery-[0-9a-f]{64}\', path.stem)),\n                    \'RECOVERY_BINDING_MISMATCH\')\n                raw_state = local_read_slot(path)\n                local_slot_matches(raw_state, ref)\n                paths = {\'state\': path, \'stdout\': path.with_suffix(\'.stdout\'), \'stderr\': path.with_suffix(\'.stderr\')}\n    recovery_sha = None\n    marker = \'-recovery-\'\n    if marker in paths[\'state\'].stem: recovery_sha = paths[\'state\'].stem.split(marker)[1]\n    return paths, local_existing_schema(inputs, entry, paths, recovery_sha), recovery_sha\n\n\ndef local_read_schema_recovery(inputs, path, digest):\n    raw, ref = inputs[\'reader\'].external(path, digest)\n    authority = local_schema_recovery_authority(local_json(raw), inputs[\'release\'])\n    for name in (\'authorizationEvidence\', \'actualMetadataProof\', \'schemaPlan\', \'installDecision\'):\n        local_stream_checked(inputs[\'reader\'], authority[name])\n    supplied = {r[\'path\']: r for r in authority[\'priorResults\']}\n    required = {}\n    for entry in inputs[\'schemaPlan\'][\'entries\']:\n        if entry[\'feature\'] not in authority[\'allowedFeatures\']: continue\n        paths, state, unused = local_latest_schema(inputs, entry)\n        local_need(state is not None and state[\'status\'] != \'pass\', \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n        required[str(paths[\'state\'])] = local_state_ref(paths[\'state\'])\n        for key in (\'stdout\', \'stderr\'):\n            if paths[key].exists() or paths[key].is_symlink():\n                required[str(paths[key])] = local_state_ref(paths[key])\n    local_need(supplied == required, \'SCHEMA_RECOVERY_NOT_AUTHORIZED\')\n    for prior in authority[\'priorResults\']: local_stream_checked(inputs[\'reader\'], prior)\n    inputs[\'reader\'].recheck()\n    return authority, ref\n\n\ndef local_finish_schema(inputs, installer_exit_code, recovery=None):\n    refs = [None, None]; passed = True\n    release_fd = acquire_e05_release_lock(RELEASE_LOCK)\n    try:\n        local_installed_release(inputs)\n        recovery_value = recovery_ref = None\n        if recovery is not None:\n            recovery_value, recovery_ref = local_read_schema_recovery(inputs, *recovery)\n        for index, entry in enumerate(inputs[\'schemaPlan\'][\'entries\']):\n            previous_paths, previous, previous_recovery = local_latest_schema(inputs, entry)\n            if recovery_value is not None and entry[\'feature\'] in recovery_value[\'allowedFeatures\']:\n                paths = local_schema_paths(inputs, entry, recovery_ref[\'sha256\'])\n                state = local_run_schema_once(inputs, entry, paths, recovery_ref[\'sha256\'])\n            elif previous is not None:\n                paths, state = previous_paths, previous\n            else:\n                paths = local_schema_paths(inputs, entry)\n                state = local_run_schema_once(inputs, entry, paths)\n            refs[index] = local_state_ref(paths[\'state\'])\n            if state[\'status\'] != \'pass\':\n                passed = False\n                break  # F06 must succeed before the existing E05 hook can execute.\n        result = local_release_summary(inputs, installer_exit_code, refs, \'verified\' if passed else \'failed\')\n        atomic_write(local_summary_path(inputs), local_canonical(result))\n        return result\n    finally:\n        os.close(release_fd)\n\n\ndef local_install(decision_path, decision_sha256, recovery=None):\n    inputs = local_read_install_inputs(decision_path, decision_sha256)\n    local_need(Path(__file__).resolve() == Path(LOCAL_HELPER_PATHS[\'cyf-api-flow-deploy\']),\n               \'HELPER_CATALOG_MISMATCH\')\n    local_authority_matches(inputs[\'decision\'], inputs[\'authority\'],\n                            (\'apiInstall\', \'apiStopStart\', \'schemaApply\'))\n    mutex = local_coordinator_lock()\n    try:\n        for path in (ROOT, PACKAGE.parent):\n            info = path.lstat()\n            local_need(stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and info.st_gid == 0\n                and stat.S_IMODE(info.st_mode) == 0o700, \'PATH_UNSAFE\')\n        validate_backup_directory(BACKUPS)\n        if recovery is not None:\n            return local_finish_schema(inputs, 0, recovery)\n        # Stage while serialized by the old API lock. Release before invoking\n        # the original installer, which acquires FD8 itself; never parent deadlock.\n        release_fd = acquire_e05_release_lock(RELEASE_LOCK)\n        try:\n            resume = local_validate_slots(inputs)\n            if resume:\n                local_need(PACKAGE.exists(), \'RECOVERY_BINDING_MISMATCH\')\n                fd = os.open(str(PACKAGE), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)\n                try:\n                    info = os.fstat(fd)\n                    local_need(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_nlink == 1\n                        and stat.S_IMODE(info.st_mode) == 0o600, \'PATH_UNSAFE\')\n                    with os.fdopen(os.dup(fd), \'rb\') as stream:\n                        local_need(digest_fileobj(stream) == inputs[\'decision\'][\'package\'][\'sha256\']\n                            and info.st_size == inputs[\'decision\'][\'package\'][\'size\'], \'RECOVERY_BINDING_MISMATCH\')\n                finally:\n                    os.close(fd)\n            else:\n                local_copy_incoming(inputs)\n                local_prepare_approval(inputs)\n        finally:\n            os.close(release_fd)\n        if local_read_slot(local_summary_path(inputs)) is None:\n            atomic_write(local_summary_path(inputs), local_canonical(local_release_summary(inputs, None, None, \'prepared\')))\n        # Execute the very helper FD already authenticated against helperCatalog.\n        helper_fd = inputs[\'reader\'].helper_fd(\'cyf-api-flow-install\',\n                                inputs[\'helperCatalog\'][\'helpers\'][\'cyf-api-flow-install\'])\n        try:\n            inputs[\'reader\'].recheck()\n            env = installer_environment()\n            # Existing offline/lifecycle override flags must not enter production.\n            for key in list(env):\n                if key.startswith((\'CYF_RELEASE_\', \'CYF_API_FLOW_\', \'CYF_API_KIT_VALIDATION\')):\n                    env.pop(key, None)\n            return_code = subprocess.run([\'/bin/bash\', \'-p\', \'/proc/self/fd/\' + str(helper_fd)],\n                env=env, pass_fds=(helper_fd,), close_fds=True).returncode\n        finally:\n            os.close(helper_fd)\n        # Schema consumes an INSTALLED v3 record, never an approval or exit alone.\n        if return_code != 0:\n            result = local_release_summary(inputs, return_code, None, \'failed\')\n            # Preserve existing schema refs; never overwrite prior DDL evidence.\n            raw_summary = local_read_slot(local_summary_path(inputs))\n            if raw_summary is None: atomic_write(local_summary_path(inputs), local_canonical(result))\n            return result\n        return local_finish_schema(inputs, return_code)\n    finally:\n        os.close(mutex)\n\n\ndef local_main(argv):\n    """Strict read-only CLI. No parsing fallback into historical Flow operations."""\n    try:\n        local_need(os.geteuid() == 0, \'AUTHORITY_INVALID\')\n        local_need(type(argv) is list and len(argv) in (5, 10) and argv[0] in (\'--local-inspect\', \'--local-install\')\n            and argv[1] == \'--decision\' and argv[3] == \'--decision-sha256\', \'INPUT_INVALID\')\n        recovery = None\n        if len(argv) == 10:\n            local_need(argv[0] == \'--local-install\' and argv[5] == \'--recover-schema\'\n                and argv[6] == \'--schema-recovery-authority\'\n                and argv[8] == \'--schema-recovery-authority-sha256\', \'INPUT_INVALID\')\n            recovery = (argv[7], argv[9])\n        if argv[0] == \'--local-inspect\':\n            result = local_inspect(argv[2], argv[4])\n        else:\n            result = local_install(argv[2], argv[4], recovery)\n    except LocalRejected as exc:\n        print(json.dumps({\'status\': \'rejected\', \'error\': exc.code}, sort_keys=True, separators=(\',\', \':\')))\n        return 1\n    except SchemaIntegrationError:\n        print(json.dumps({\'status\': \'rejected\', \'error\': \'SCHEMA_PREREQUISITE_MISSING\'}, sort_keys=True, separators=(\',\', \':\')))\n        return 1\n    except OSError:\n        print(json.dumps({\'status\': \'rejected\', \'error\': \'IO_FAILURE\'}, sort_keys=True, separators=(\',\', \':\')))\n        return 1\n    print(json.dumps(result, sort_keys=True, separators=(\',\', \':\')))\n    return 0 if result.get(\'status\') in (\'inputs_verified\', \'verified\') else 1\n\n\n# BEGIN NATIVE_LOCAL_SOURCE_V1\n# Genuine LOCAL source support in the existing coordinator/transaction. This is\n# not the retired schema-3 authority/admission framework and never invents a Run.\nNATIVE_APPROVAL_KEYS = {\'schema_version\', \'source_kind\', \'source\', \'package\',\n    \'receipt_sha256\', \'jar_sha256\', \'expected_previous_sha256\', \'consumed\'}\nNATIVE_STATUSES = {\'prepared\', \'activating\', \'active_pending\', \'rolling_back\', \'installed\', \'failed\'}\n\n\ndef native_need(condition, message=\'invalid LOCAL source\'):\n    if not condition:\n        raise SystemExit(message)\n\n\ndef native_identity(identity):\n    native_need(type(identity) is dict and set(identity) == {\'version\', \'buildId\', \'commit\', \'tree\'})\n    for key in (\'version\', \'buildId\'):\n        native_need(type(identity[key]) is str and re.fullmatch(r\'[A-Za-z0-9][A-Za-z0-9_.-]*\', identity[key]))\n    native_need(not identity[\'buildId\'].isdigit(), \'LOCAL buildId must not be a numeric Flow Run\')\n    for key in (\'commit\', \'tree\'):\n        native_need(type(identity[key]) is str and re.fullmatch(\'[0-9a-f]{40}\', identity[key]))\n    return identity\n\n\ndef native_approval(value):\n    native_need(type(value) is dict and type(value.get(\'consumed\')) is bool)\n    native_need(set(value) == NATIVE_APPROVAL_KEYS | ({\'consumed_at\'} if value[\'consumed\'] else set()))\n    native_need(type(value[\'schema_version\']) is int and value[\'schema_version\'] == 4 and value[\'source_kind\'] == \'LOCAL\')\n    native_identity(value[\'source\'])\n    for key in (\'receipt_sha256\', \'jar_sha256\', \'expected_previous_sha256\'):\n        native_need(type(value[key]) is str and re.fullmatch(\'[0-9a-f]{64}\', value[key]))\n    item = value[\'package\']\n    native_need(type(item) is dict and set(item) == {\'path\', \'sha256\', \'size\'})\n    native_need(type(item[\'path\']) is str and item[\'path\'].startswith(\'/\')\n                and not any(ord(c) < 32 for c in item[\'path\']) and str(Path(item[\'path\'])) == item[\'path\'])\n    native_need(type(item[\'sha256\']) is str and re.fullmatch(\'[0-9a-f]{64}\', item[\'sha256\']))\n    native_need(type(item[\'size\']) is int and item[\'size\'] > 0)\n    if value[\'consumed\']:\n        native_need(type(value[\'consumed_at\']) is str and re.fullmatch(\'[0-9]{8}T[0-9]{6}Z\', value[\'consumed_at\']))\n    return value\n\n\ndef native_binding(value):\n    native_approval(value)\n    immutable = {k: v for k, v in value.items() if k not in (\'consumed\', \'consumed_at\')}\n    return hashlib.sha256(local_canonical(immutable)).hexdigest()\n\n\ndef native_signature(info):\n    # Reading an immutable file may update atime. It is not a content or\n    # ownership mutation; mtime/ctime/inode/mode/size still must remain exact.\n    return (info.st_dev, info.st_ino, info.st_uid, info.st_gid, info.st_nlink,\n            info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns)\n\n\ndef native_private(path, mode=0o600):\n    path = Path(path)\n    native_need(path.is_absolute() and str(path.resolve()) == str(path), \'unsafe LOCAL physical path\')\n    for parent in path.parents:\n        st = parent.lstat()\n        native_need(stat.S_ISDIR(st.st_mode) and st.st_uid == os.geteuid(), \'unsafe LOCAL parent\')\n        # /tmp and /dev/shm may be root-owned sticky shared ancestors; the\n        # immediate artifact directory must still be owner-only below them.\n        native_need(not st.st_mode & 0o022 or st.st_mode & stat.S_ISVTX, \'writable LOCAL parent\')\n    st = path.lstat()\n    native_need(stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid()\n                and st.st_nlink == 1 and stat.S_IMODE(st.st_mode) == mode, \'unsafe LOCAL file metadata\')\n    return st\n\n\ndef native_package(approval):\n    approval = native_approval(approval)\n    package = Path(approval[\'package\'][\'path\'])\n    before = native_private(package)\n    directory = package.parent.stat()\n    native_need(stat.S_IMODE(directory.st_mode) == 0o700, \'LOCAL artifact parent must be private\')\n    with package.open(\'rb\') as handle:\n        digest = digest_fileobj(handle)\n    native_need(native_signature(package.lstat()) == native_signature(before) and before.st_size == approval[\'package\'][\'size\']\n                and digest == approval[\'package\'][\'sha256\'], \'LOCAL package changed or digest mismatch\')\n    return package\n\n\ndef native_read_approval(path):\n    before = native_private(path)\n    data = Path(path).read_bytes()\n    native_need(native_signature(Path(path).lstat()) == native_signature(before), \'LOCAL descriptor changed\')\n    return native_approval(local_json(data))\n\n\ndef native_record(value, backup_root):\n    keys = {\'schema_version\', \'source_kind\', \'source\', \'package\', \'binding_sha256\',\n        \'expected_previous_sha256\', \'receipt_sha256\', \'candidate_sha256\', \'previous_sha256\',\n        \'status\', \'phase\', \'recovery\', \'backup\', \'candidate_stop_rc\', \'timestamp\'}\n    native_need(type(value) is dict and set(value) == keys and type(value[\'schema_version\']) is int\n                and value[\'schema_version\'] == 4 and value[\'source_kind\'] == \'LOCAL\')\n    native_need(value[\'status\'] in NATIVE_STATUSES)\n    for key in (\'phase\', \'recovery\'):\n        native_need(type(value[key]) is str and re.fullmatch(\'[a-z0-9_]+\', value[key]))\n    for key in (\'binding_sha256\', \'receipt_sha256\', \'candidate_sha256\', \'previous_sha256\', \'expected_previous_sha256\'):\n        native_need(type(value[key]) is str and re.fullmatch(\'[0-9a-f]{64}\', value[key]))\n    approval = dict(schema_version=4, source_kind=\'LOCAL\', source=value[\'source\'], package=value[\'package\'],\n        receipt_sha256=value[\'receipt_sha256\'], jar_sha256=value[\'candidate_sha256\'],\n        expected_previous_sha256=value[\'expected_previous_sha256\'], consumed=False)\n    native_need(native_binding(approval) == value[\'binding_sha256\'], \'LOCAL record binding mismatch\')\n    native_need(type(value[\'candidate_stop_rc\']) is int and 0 <= value[\'candidate_stop_rc\'] <= 255)\n    native_need(type(value[\'timestamp\']) is str and re.fullmatch(\'[0-9]{8}T[0-9]{6}Z\', value[\'timestamp\']))\n    backup = Path(value[\'backup\'])\n    native_need(backup.is_absolute() and backup.parent == Path(backup_root)\n                and re.fullmatch(\'[0-9]{8}T[0-9]{6}Z-[0-9a-f]{64}-[0-9]+\\\\.jar\', backup.name), \'unsafe LOCAL rollback path\')\n    return value\n\n\ndef native_record_fields(value, backup_root):\n    native_record(value, backup_root)\n    return [value[\'status\'], value[\'phase\'], value[\'recovery\'], value[\'binding_sha256\'],\n        value[\'source\'][\'commit\'], value[\'source\'][\'tree\'], value[\'source\'][\'buildId\'],\n        value[\'receipt_sha256\'], value[\'candidate_sha256\'], value[\'previous_sha256\'],\n        value[\'backup\'], value[\'candidate_stop_rc\'], value[\'timestamp\']]\n\n\ndef native_validate_payloads(approval, root):\n    a = native_approval(approval)\n    native_package(a)\n    root = Path(root)\n    receipt_bytes = (root / \'receipt.json\').read_bytes()\n    receipt = local_json(receipt_bytes)\n    metadata = local_json((root / \'application.metadata.json\').read_bytes())\n    sidecar = local_json((root / \'application.sidecar.json\').read_bytes())\n    provenance = local_json((root / \'dependency.provenance.json\').read_bytes())\n    native_need(hashlib.sha256(receipt_bytes).hexdigest() == a[\'receipt_sha256\'], \'LOCAL receipt digest mismatch\')\n    native_need(receipt.get(\'format\') == \'cyf-api-local-release-receipt-v1\' and receipt.get(\'status\') == \'packaged\'\n        and receipt.get(\'producer\') == {\'kind\': \'local-build-v1\'} and receipt.get(\'identity\') == a[\'source\']\n        and receipt.get(\'source\') == dict(commit=a[\'source\'][\'commit\'], tree=a[\'source\'][\'tree\'], cleanBefore=True, cleanAfter=True)\n        and \'flow\' not in receipt, \'LOCAL receipt source mismatch\')\n    refs = {}\n    for key, filename in [(\'applicationJar\', \'application.jar\'), (\'dependencyProvenance\', \'dependency.provenance.json\')]:\n        item = receipt.get(key)\n        native_need(type(item) is dict and set(item) == {\'path\', \'sha256\', \'size\'} and item[\'path\'] == filename)\n        p = root / filename\n        with p.open(\'rb\') as handle: digest = digest_fileobj(handle)\n        native_need(type(item[\'size\']) is int and item[\'size\'] == p.stat().st_size\n                    and item[\'sha256\'] == digest, \'LOCAL payload digest mismatch\')\n        refs[key] = item\n    native_need(refs[\'applicationJar\'][\'sha256\'] == a[\'jar_sha256\'])\n    binding = dict(identity=a[\'source\'], receiptSha256=a[\'receipt_sha256\'], **refs)\n    native_need(type(metadata) is dict and set(metadata) == set(binding) | {\'format\', \'moduleVersion\', \'implementationVersion\'}\n        and metadata[\'format\'] == \'cyf-api-local-application-metadata-v1\'\n        and all(metadata[k] == v for k, v in binding.items()), \'LOCAL metadata mismatch\')\n    native_need(sidecar == dict(format=\'cyf-api-local-application-sidecar-v1\', **binding), \'LOCAL sidecar mismatch\')\n    native_need(provenance.get(\'coordinate\') == \'org.opencv:opencv:4.5.5\'\n        and provenance.get(\'jar_sha256\') == \'323d40119548134b0966d3735e97a78d1edbc79bd91e7fb1074e5152392095f4\'\n        and type(provenance.get(\'jar_size\')) is int and provenance[\'jar_size\'] == 722802, \'LOCAL OpenCV pin mismatch\')\n    tests = receipt.get(\'evidence\', {}).get(\'tests\')\n    native_need(type(tests) is list and bool(tests), \'LOCAL test evidence missing\')\n    tasks = set()\n    for item in tests:\n        native_need(type(item) is dict and item.get(\'task\') not in tasks and type(item.get(\'reports\')) is list\n                    and bool(item[\'reports\']), \'LOCAL test evidence invalid\')\n        tasks.add(item[\'task\'])\n        for report in item[\'reports\']:\n            native_need(type(report) is dict and type(report.get(\'tests\')) is int\n                and type(report.get(\'skipped\')) is int and report[\'tests\'] >= report[\'skipped\'] >= 0\n                and type(report.get(\'failures\')) is int and report[\'failures\'] == 0\n                and type(report.get(\'errors\')) is int and report[\'errors\'] == 0, \'LOCAL test failure or invalid counts\')\n        native_need(sum(r[\'tests\'] - r[\'skipped\'] for r in item[\'reports\']) > 0)\n    native_need({\':agent:jia-agent-service:localReleaseBaseline\', \':starter:localReleaseBaseline\',\n        \':starter:publicArtifactVerifierTest\', \':starter:poiProductionRuntimeClasspathTest\'} <= tasks,\n        \'LOCAL required release tests missing\')\n    native_need(receipt.get(\'verification\', {}).get(\'publicArtifactVerifier\') == \'bootJar-original-doLast-completed\')\n    with zipfile.ZipFile(root / \'application.jar\') as boot:\n        entries = boot.infolist()\n        native_need(len(entries) == len({e.filename for e in entries})\n            and all(not e.filename.startswith(\'/\') and \'\\\\\' not in e.filename and \'..\' not in e.filename.split(\'/\') for e in entries),\n            \'unsafe LOCAL bootJar entry\')\n        lines = boot.read(\'META-INF/MANIFEST.MF\').decode().replace(\'\\r\\n\', \'\\n\').split(\'\\n\')\n        unfolded = []\n        for line in lines:\n            if not line: break\n            if line.startswith(\' \'):\n                native_need(bool(unfolded)); unfolded[-1] += line[1:]\n            else: unfolded.append(line)\n        attrs = {}\n        for line in unfolded:\n            k, sep, v = line.partition(\': \'); native_need(sep and k not in attrs); attrs[k] = v\n        native_need(attrs.get(\'Start-Class\') == \'cn.jia.JiaApplication\'\n            and attrs.get(\'Main-Class\', \'\').startswith(\'org.springframework.boot.loader.\')\n            and attrs.get(\'CYF-Source-Commit\') == a[\'source\'][\'commit\']\n            and attrs.get(\'CYF-Source-Tree\') == a[\'source\'][\'tree\']\n            and attrs.get(\'CYF-Local-Build-Id\') == a[\'source\'][\'buildId\']\n            and attrs.get(\'CYF-Release-Version\') == a[\'source\'][\'version\'], \'LOCAL executable source mismatch\')\n        # common-core declares OpenCV compileOnly (testImplementation for its\n        # tests), so a valid production bootJar normally has no OpenCV member.\n        # The producer verifies the pinned build dependency before consumption;\n        # provenance above retains that binding. If a runtime copy is present,\n        # it must still be the exact pinned dependency, never an alternate JAR.\n        cv_members = [e for e in entries if e.filename.startswith(\'BOOT-INF/lib/opencv-\')]\n        if cv_members:\n            native_need(len(cv_members) == 1 and cv_members[0].filename == \'BOOT-INF/lib/opencv-4.5.5.jar\',\n                        \'LOCAL packaged OpenCV coordinate mismatch\')\n            cv = cv_members[0]\n            with boot.open(cv) as handle: digest = digest_fileobj(handle)\n            native_need(cv.file_size == 722802 and digest == provenance[\'jar_sha256\'], \'LOCAL packaged OpenCV mismatch\')\n    return a\n\n\ndef native_api_main(argv):\n    native_need(os.geteuid() == 0 and len(argv) == 1, \'expected root --source-local descriptor.json\')\n    approval = native_read_approval(Path(argv[0]))\n    native_need(not approval[\'consumed\'], \'new LOCAL descriptor is already consumed\')\n    native_package(approval)\n    safe_regular(Path(__file__).resolve(), mode=0o755)\n    safe_regular(Path(INSTALLER), mode=0o755)\n    validate_backup_directory(BACKUPS)\n    lock_fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)\n    try:\n        safe_regular(Path(LOCK), mode=0o600)\n        native_need(os.fstat(lock_fd) == Path(LOCK).lstat(), \'LOCAL coordinator lock changed\')\n        fcntl.flock(lock_fd, fcntl.LOCK_EX)\n        os.set_inheritable(lock_fd, False)\n        record_path = ROOT / \'record.json\'\n        if record_path.exists():\n            safe_regular(record_path, mode=0o600)\n            previous = local_json(record_path.read_bytes())\n            if previous.get(\'status\') != \'installed\':\n                native_need(previous.get(\'schema_version\') == 4, \'unfinished transaction belongs to another release\')\n                native_record(previous, BACKUPS)\n                native_need(previous[\'binding_sha256\'] == native_binding(approval), \'unfinished LOCAL transaction belongs to another release\')\n        # Preserve root state before writing the next exact-source descriptor.\n        if APPROVAL.exists() or APPROVAL.is_symlink():\n            safe_regular(APPROVAL, mode=0o600)\n            old = APPROVAL.read_bytes()\n            archive = BACKUPS / (\'approval-before-local-\' + hashlib.sha256(old).hexdigest() + \'.json\')\n            if archive.exists(): native_need(archive.read_bytes() == old)\n            else:\n                fd = os.open(archive, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n                with os.fdopen(fd, \'wb\') as out: out.write(old); out.flush(); os.fsync(out.fileno())\n                fsync_dir(BACKUPS)\n        # A consumed descriptor must stay consumed on idempotent/recovery calls.\n        if APPROVAL.exists():\n            current = local_json(APPROVAL.read_bytes())\n            if current.get(\'schema_version\') == 4 and native_binding(current) == native_binding(approval): approval = current\n        atomic_write(APPROVAL, local_canonical(approval))\n        rc = invoke_installer(INSTALLER) # no Flow schema hooks for a LOCAL/no-schema-change release\n        if rc == 0:\n            record = local_json(record_path.read_bytes()); native_record(record, BACKUPS)\n            native_need(record[\'status\'] == \'installed\' and record[\'binding_sha256\'] == native_binding(approval))\n            print(\'CYF_API_LOCAL_INSTALL=PASS \' + json.dumps({\'source\': approval[\'so