ds\'])\n    local_ref(value[\'schemaPlan\'], \'SCHEMA_PREREQUISITE_MISSING\')\n    local_ref(value[\'helperCatalog\'], \'HELPER_CATALOG_MISMATCH\')\n    local_precondition(value[\'precondition\'])\n    local_rollback(value[\'rollbackPolicy\'])\n    ops = local_exact(value[\'operations\'], (\'apiInstall\', \'apiStopStart\', \'schemaApply\', \'helperInstall\'),\n                      \'MAINTENANCE_SCOPE_MISSING\')\n    local_need(all(type(v) is bool for v in ops.values()), \'MAINTENANCE_SCOPE_MISSING\')\n    return value\n\n\ndef local_install_decision(value):\n    local_exact(value, (\'format\', \'status\', \'scope\', \'source\', \'admission\', \'package\',\n        \'payloads\', \'buildEvidence\', \'controllerVerification\', \'maintenanceAuthority\',\n        \'precondition\', \'schemaPlan\', \'helperCatalog\', \'rollbackPolicy\', \'productionAuthorized\'),\n        \'AUTHORITY_INVALID\')\n    local_need(value[\'format\'] == \'cyf-api-local-install-decision-v1\' and value[\'status\'] == \'approved\'\n        and value[\'scope\'] == LOCAL_SCOPE and value[\'productionAuthorized\'] is True, \'AUTHORITY_INVALID\')\n    local_source(value[\'source\'])\n    local_digest(value[\'package\'], \'PACKAGE_INVALID\')\n    local_need(value[\'package\'][\'size\'] > 0, \'PACKAGE_INVALID\')\n    local_payloads(value[\'payloads\'])\n    for field in (\'admission\', \'buildEvidence\', \'controllerVerification\', \'maintenanceAuthority\',\n                  \'schemaPlan\', \'helperCatalog\'):\n        local_ref(value[field])\n    local_precondition(value[\'precondition\'])\n    local_rollback(value[\'rollbackPolicy\'])\n    return value\n\n\ndef local_authority_matches(decision, authority, operations=()):\n    local_install_decision(decision)\n    local_maintenance_authority(authority)\n    for field in (\'schemaPlan\', \'helperCatalog\', \'precondition\', \'rollbackPolicy\'):\n        local_need(decision[field] == authority[field], \'AUTHORITY_INVALID\')\n    local_need(authority[\'release\'] == {k: decision[k] for k in (\'source\', \'admission\', \'package\', \'payloads\')},\n               \'AUTHORITY_INVALID\')\n    local_need(type(operations) in (tuple, list) and all(k in (\'apiInstall\', \'apiStopStart\', \'schemaApply\',\n               \'helperInstall\') for k in operations), \'MAINTENANCE_SCOPE_MISSING\')\n    for operation in operations:\n        local_need(authority[\'operations\'][operation] is True, \'MAINTENANCE_SCOPE_MISSING\')\n    return authority\n\n\ndef local_binding_from_decision(decision, decision_ref):\n    local_install_decision(decision)\n    local_ref(decision_ref)\n    release = {k: decision[k] for k in LOCAL_BINDING_KEYS if k != \'decision\'}\n    release[\'decision\'] = decision_ref\n    return local_binding(release)\n\n\ndef local_binding(value):\n    local_exact(value, LOCAL_BINDING_KEYS, \'RECOVERY_BINDING_MISMATCH\')\n    # One non-recursive projection: no self hash, fake Run, inferred ordering or\n    # envelope status/phase enters this immutable release identity.\n    decision = {\'format\': \'cyf-api-local-install-decision-v1\', \'status\': \'approved\',\n        \'scope\': LOCAL_SCOPE, \'productionAuthorized\': True}\n    decision.update({k: value[k] for k in LOCAL_BINDING_KEYS if k != \'decision\'})\n    local_install_decision(decision)\n    local_ref(value[\'decision\'])\n    return value\n\n\ndef local_binding_sha(value):\n    local_binding(value)\n    return hashlib.sha256(local_canonical(value)).hexdigest()\n\n\ndef local_approval(value):\n    local_exact(value, (\'schema_version\', \'release\', \'binding_sha256\', \'consumed\', \'consumed_at\'),\n                \'DURABLE_RECORD_INCOMPLETE\')\n    local_need(type(value[\'schema_version\']) is int and value[\'schema_version\'] == 3\n        and type(value[\'consumed\']) is bool, \'DURABLE_RECORD_INCOMPLETE\')\n    local_need(value[\'binding_sha256\'] == local_binding_sha(value[\'release\']), \'RECOVERY_BINDING_MISMATCH\')\n    local_need((value[\'consumed