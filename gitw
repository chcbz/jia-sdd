#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  ./gitw <root-git-args...>
  ./gitw root <git-args...>
  ./gitw web <git-args...>
  ./gitw api <git-args...>
  ./gitw all <git-args...>

The workspace root is the coordinating jia-sdd repository.
Use `root` (or omit a target) for its SDD records and submodule pointers.
Use `api` and `web` for implementation-repository commands.
USAGE
}

run_repo() {
  local repo="$1"
  shift
  echo "== $repo =="
  git -C "$repo" "$@"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 1
  fi

  case "$1" in
    -h|--help|help)
      usage
      ;;
    root)
      shift
      [[ $# -gt 0 ]] || { usage; exit 1; }
      git "$@"
      ;;
    web|api)
      local repo="$1"
      shift
      [[ $# -gt 0 ]] || { usage; exit 1; }
      git -C "$repo" "$@"
      ;;
    all)
      shift
      [[ $# -gt 0 ]] || { usage; exit 1; }
      run_repo api "$@"
      echo
      run_repo web "$@"
      ;;
    *)
      git "$@"
      ;;
  esac
}

main "$@"
