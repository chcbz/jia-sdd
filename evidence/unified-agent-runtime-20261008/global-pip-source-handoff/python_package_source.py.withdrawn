#!/usr/bin/env python3
"""Prepare explicit NEW-batch pip inputs; never installs, changes global config or mutates a live batch."""
import argparse
import hashlib
import json
from pathlib import Path
import shlex
from urllib.parse import urlsplit

CONFIG_PATH = Path(__file__).resolve().with_name('python-package-source.env')


def prepare_environment(kind, config_path=CONFIG_PATH, expected_sha256=None):
    if kind not in ('clean-install', 'pip'):
        raise ValueError('PYTHON_PACKAGE_SOURCE_KIND_INVALID')
    config = Path(config_path)
    if not config.is_absolute() or config.resolve() != config or config.is_symlink() or not config.is_file():
        raise ValueError('PYTHON_PACKAGE_SOURCE_PATH_INVALID')
    before = config.stat()
    raw = config.read_bytes()
    after = config.stat()
    signature = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
    if signature(before) != signature(after):
        raise ValueError('PYTHON_PACKAGE_SOURCE_CHANGED')
    digest = hashlib.sha256(raw).hexdigest()
    if expected_sha256 is not None and digest != expected_sha256:
        raise ValueError('PYTHON_PACKAGE_SOURCE_DIGEST_MISMATCH')
    # Parse only this declarative project's two exports. No shell execution or inherited pip/proxy config.
    try:
        rows = [shlex.split(line, comments=True) for line in raw.decode('utf-8').splitlines()]
        rows = [row for row in rows if row]
        if len(rows) != 2 or any(len(row) != 2 or row[0] != 'export' for row in rows):
            raise ValueError()
        key, index = rows[0][1].split('=', 1)
        if key != 'PIP_INDEX_URL' or rows[1][1] != 'CYF_CLEAN_INSTALL_PIP_INDEX_URL=$PIP_INDEX_URL':
            raise ValueError()
        url = urlsplit(index)
        if (url.scheme != 'https' or not url.hostname or url.username is not None or url.password is not None
                or url.query or url.fragment or any(ord(c) <= 32 or ord(c) == 127 for c in index)):
            raise ValueError()
    except (ValueError, UnicodeError):
        raise ValueError('PYTHON_PACKAGE_SOURCE_CONFIG_INVALID') from None
    # Merge these into the launcher's explicit whitelist, not into os.environ/the parent shell.
    environment = {'CYF_CLEAN_INSTALL_PIP_INDEX_URL': index} if kind == 'clean-install' else {'PIP_INDEX_URL': index}
    return {'format': 'cyf-python-package-source-input-v1', 'kind': kind, 'environment': environment,
            'provenance': {'configPath': str(config), 'configSha256': digest, 'indexUrl': index},
            'installationExecuted': False, 'liveBatchTouched': False}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--kind', choices=['clean-install', 'pip'], required=True)
    parser.add_argument('--config', default=str(CONFIG_PATH))
    parser.add_argument('--expected-sha256')
    args = parser.parse_args()
    try:
        result = prepare_environment(args.kind, Path(args.config), args.expected_sha256)
    except (ValueError, OSError):
        print(json.dumps({'status': 'REJECTED', 'code': 'PYTHON_PACKAGE_SOURCE_INPUT_REJECTED'}))
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
